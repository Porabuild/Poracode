{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "@/renderer/i18n/i18n": ["./src/desktop/i18n.ts"],
      "@/renderer/state/slices/runtimeEventSlice": [
        "../src/renderer/state/slices/runtimeChatItem.ts"
      ],
      "@/*": ["../src/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  "include": [
    "src",
    "opencode/packages/tui/src",
    // `*.po` module declarations for renderer i18n modules the desktop
    // presentation bridge pulls into this program.
    "../src/renderer/i18n/po.d.ts"
  ],
  "exclude": ["opencode/packages/tui/src/**/*.test.ts", "opencode/packages/tui/src/**/*.test.tsx"]
}
