{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "@/*": ["../src/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  "include": ["src", "opencode/packages/tui/src"],
  "exclude": ["opencode/packages/tui/src/**/*.test.ts", "opencode/packages/tui/src/**/*.test.tsx"]
}
