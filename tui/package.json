    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "effect": "4.1.3",
    "entities": "9.0.0",
    "fuzzysort": "4.0.2",
    "open": "11.0.4",
