+test("search keeps matches beyond the viewport and follows replacement options", async () => {
+  await using tmp = await tmpdir()
+  const rows = Array.from({ length: 16 }, (_, i) => ({ title: `Project ${i}`, value: `p${i}` }))
+  let picker!: DialogSelectRef<string>
+  const select = await mountSelect(tmp.path, rows, undefined, undefined, { ref: (ref) => { picker = ref } })
+  try {
+    await select.app.mockInput.typeText("project")
+    await select.app.waitFor(() => picker.filter === "project")
+    expect(picker.filtered).toHaveLength(16)
+    picker.moveTo("p15")
+    select.app.mockInput.pressEnter()
+    await select.app.waitFor(() => select.selected.includes("p15"))
+    select.replaceOptions([{ title: "Project replacement", value: "new" }, { title: "Project hidden", value: "off", disabled: true }])
+    await select.app.waitFor(() => picker.filtered.length === 1)
+    expect(picker.filtered[0]?.value).toBe("new")
+  } finally {
+    select.app.renderer.destroy()
+  }
+})
