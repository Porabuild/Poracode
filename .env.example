# Optional: enable Sentry crash/error reporting.
SENTRY_DSN=

# Optional: override the Sentry environment name.
SENTRY_ENVIRONMENT=production

# Optional: print Sentry SDK debug logs.
SENTRY_DEBUG=0

# Optional: upload source maps during release builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: enable anonymous PostHog product analytics.
# PostHog project keys are browser/client keys. They are not secrets and may be
# visible to a local user in renderer process arguments or bundled JS.
# Vite maps these POSTHOG_* vars into the renderer for dev and build, so
# separate VITE_* duplicates are not needed.
POSTHOG_ENABLED=1
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLE_DEV=0

# --- Standalone headless remote server (pnpm run server) ----------------------
# Boots the same remote-access server the desktop exposes, without Electron.
# See docs/REMOTE_ARCHITECTURE.md. All optional; sane defaults shown.
#
# Data dir (db, settings, auth, secret key). Default: per-channel user dir.
# PORACODE_BASE_DIR=
# Version string the server reports to clients.
# PORACODE_APP_VERSION=dev
# Bind host / port for the HTTP+WS server.
# PORACODE_REMOTE_ACCESS_HOST=0.0.0.0
# PORACODE_REMOTE_ACCESS_PORT=38987
# Host advertised inside pairing URLs (auto-detected LAN IP when binding 0.0.0.0).
# PORACODE_REMOTE_ACCESS_ADVERTISED_HOST=
# base64-encoded 32-byte secret key. If unset, a file-backed key is generated
# in the data dir (secret-key.headless). Set this to inject one from a real
# secret manager and keep it off disk.
# PORACODE_SECRET_STORAGE_KEY=
# Optional cross-network relay (Phase 5). Point the server at a relay's /host
# control URL; devices then reach it at <relay>/s/<desktopId>/. The secret
# (file-backed in the data dir if unset) claims the server id on the relay.
# PORACODE_REMOTE_RELAY_URL=wss://relay.example.com/host
# PORACODE_REMOTE_RELAY_SECRET=

# --- Self-hostable relay (pnpm run relay) -------------------------------------
# A dumb HTTP+WS tunnel between NAT'd servers and devices. See docs/REMOTE_ARCHITECTURE.md.
# PORACODE_RELAY_HOST=0.0.0.0
# PORACODE_RELAY_PORT=38990
# Public base URL advertised to hosts/devices (e.g. behind a TLS reverse proxy).
# PORACODE_RELAY_PUBLIC_BASE_URL=https://relay.example.com
