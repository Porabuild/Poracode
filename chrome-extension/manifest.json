{
  "manifest_version": 3,
  "name": "Poracode",
  "version": "0.1.0",
  "description": "Lets Poracode agents control this browser — tabs, navigation, and the DOM — over a local connection using the Chrome DevTools Protocol.",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Poracode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
