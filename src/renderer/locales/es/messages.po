#: src/renderer/views/PullRequestsOverlay/detail/header/usePrCheckout.ts
#~ msgid "Your local branch {branch} cannot be fast-forwarded to this pull request's head, so no worktree was created and nothing was changed. To keep its commits and start over, run \"git branch -m {branch} {branch}-old\", then try again."
#~ msgstr "Tu rama local {branch} no se puede avanzar rápidamente hasta la cabecera de este pull request, así que no se creó ningún worktree y no se cambió nada. Para conservar sus commits y empezar de nuevo, ejecuta \"git branch -m {branch} {branch}-old\" y vuelve a intentarlo."

#: src/renderer/views/PullRequestsOverlay/detail/header/usePrCheckout.ts
#~ msgid "Your local branch {branch} cannot be fast-forwarded to this pull request's head, so no worktree was created and nothing was changed. Update it with a fast-forward only, or rename it to keep its commits, then try again."
#~ msgstr "Tu rama local {branch} no se puede avanzar rápidamente hasta la cabecera de este pull request, así que no se creó ningún worktree y no se cambió nada. Actualízala solo con avance rápido o renómbrala para conservar sus commits, y vuelve a intentarlo."

#: src/renderer/views/PullRequestsOverlay/detail/header/usePrCheckout.ts
msgid "Your local branch {branch} is not at this pull request's head, so nothing was changed. If it only lags behind, run \"git fetch {remote} && git switch {branch} && git merge --ff-only {remote}/{branch}\". If it has commits of its own, keep them with \"git branch -m {branch} {branch}-old\", then try again."
msgstr "Tu rama local {branch} no está en la cabecera de este pull request, así que no se cambió nada. Si solo va por detrás, ejecuta \"git fetch {remote} && git switch {branch} && git merge --ff-only {remote}/{branch}\". Si tiene commits propios, consérvalos con \"git branch -m {branch} {branch}-old\" y vuelve a intentarlo."

#: src/renderer/views/PullRequestsOverlay/detail/header/usePrCheckout.ts
msgid "Your local branch {branch} is not at this pull request's head, so nothing was changed. Update it with a fast-forward only, or rename it to keep its commits, then try again."
msgstr "Tu rama local {branch} no está en la cabecera de este pull request, así que no se cambió nada. Actualízala solo con avance rápido o renómbrala para conservar sus commits, y vuelve a intentarlo."

#: src/renderer/views/PullRequestsOverlay/detail/header/usePrCheckout.ts
#~ msgid "Your local branch {branch} is not at this pull request's head. Update or remove it, then try again."
#~ msgstr "Tu rama local {branch} no está en la cabecera de este pull request. Actualízala o elimínala y vuelve a intentarlo."

