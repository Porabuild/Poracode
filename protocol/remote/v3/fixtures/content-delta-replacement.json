{
  "threadId": "thread-replacement",
  "itemId": "item-replacement",
  "cases": [
    {
      "id": "replace-resets-one-stream-then-append-resumes",
      "events": [
        {
          "type": "item.started",
          "threadId": "thread-replacement",
          "itemId": "item-replacement",
          "itemType": "assistant_message",
          "payload": {
            "retained": true
          }
        },
        {
          "type": "content.delta",
          "threadId": "thread-replacement",
          "itemId": "item-replacement",
          "stream": "assistant_text",
          "delta": "stale prefix"
        },
        {
          "type": "content.delta",
          "threadId": "thread-replacement",
          "itemId": "item-replacement",
          "stream": "reasoning_text",
          "delta": "reasoning remains"
        },
        {
          "type": "content.delta",
          "threadId": "thread-replacement",
          "itemId": "item-replacement",
          "stream": "assistant_text",
          "delta": "fresh",
          "replace": true
        },
        {
          "type": "content.delta",
          "threadId": "thread-replacement",
          "itemId": "item-replacement",
          "stream": "assistant_text",
          "delta": " text"
        },
        {
          "type": "content.delta",
          "threadId": "thread-replacement",
          "itemId": "item-replacement",
          "stream": "assistant_text",
          "delta": "!",
          "replace": false
        }
      ],
      "expected": {
        "state": "updated",
        "payload": {
          "retained": true
        },
        "streams": {
          "assistant_text": "fresh text!",
          "reasoning_text": "reasoning remains"
        }
      }
    },
