{
  "id": "remote-v3-replay-git-state-parity",
  "format": "remote-v3-transition-tape",
  "protocolVersion": 8,
  "versionBoundary": "fixture-only-additive",
  "lifecycle": {
    "transitions": [
      {
        "id": "reset-target-thread-only",
        "message": {
          "type": "event",
          "seq": 101,
          "event": { "type": "thread-reset", "threadId": "thread-target" }
        },
        "before": {
          "thread-target": {
            "transcript": "target transcript before reset",
            "pendingSteerId": "steer-target",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-before-target", "outputLength": 29 }
          },
          "thread-other": {
            "transcript": "other transcript remains",
            "pendingSteerId": "steer-other",
            "terminalWatchIntent": false,
            "terminalBaseline": { "generation": "generation-other", "outputLength": 23 }
          }
        },
        "expectedAfter": {
          "thread-target": {
            "transcript": "",
            "pendingSteerId": null,
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-fresh-target", "outputLength": 0 }
          },
          "thread-other": {
            "transcript": "other transcript remains",
            "pendingSteerId": "steer-other",
            "terminalWatchIntent": false,
            "terminalBaseline": { "generation": "generation-other", "outputLength": 23 }
          }
        },
        "assertions": [
          "clear-only-thread-target",
          "clear-pending-steer-for-target",
          "preserve-terminal-watch-intent-with-fresh-baseline",
          "preserve-other-thread"
        ]
      },
      {
        "id": "reset-different-thread-only",
        "message": {
          "type": "event",
          "seq": 102,
          "event": { "type": "thread-reset", "threadId": "thread-other" }
        },
        "before": {
          "thread-target": {
            "transcript": "target transcript remains",
            "pendingSteerId": "steer-target",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-target", "outputLength": 25 }
          },
          "thread-other": {
            "transcript": "other transcript before reset",
            "pendingSteerId": "steer-other",
            "terminalWatchIntent": false,
            "terminalBaseline": { "generation": "generation-before-other", "outputLength": 28 }
          }
        },
        "expectedAfter": {
          "thread-target": {
            "transcript": "target transcript remains",
            "pendingSteerId": "steer-target",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-target", "outputLength": 25 }
          },
          "thread-other": {
            "transcript": "",
            "pendingSteerId": null,
            "terminalWatchIntent": false,
            "terminalBaseline": { "generation": "generation-fresh-other", "outputLength": 0 }
          }
        },
        "assertions": [
          "clear-only-thread-other",
          "clear-pending-steer-for-other",
          "preserve-target-thread"
        ]
      },
      {
        "id": "exit-target-preserves-transcript",
        "message": {
          "type": "event",
          "seq": 103,
          "event": { "type": "thread-exited", "threadId": "thread-target", "exitCode": 17 }
        },
        "before": {
          "thread-target": {
            "transcript": "transcript survives process exit",
            "pendingSteerId": "steer-target-on-exit",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-exit-target", "outputLength": 32 }
          },
          "thread-other": {
            "transcript": "unrelated transcript",
            "pendingSteerId": "steer-other",
            "terminalWatchIntent": false,
            "terminalBaseline": { "generation": "generation-other", "outputLength": 19 }
          }
        },
        "expectedAfter": {
          "thread-target": {
            "transcript": "transcript survives process exit",
            "pendingSteerId": null,
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-exit-target", "outputLength": 32 }
          },
          "thread-other": {
            "transcript": "unrelated transcript",
            "pendingSteerId": "steer-other",
            "terminalWatchIntent": false,
            "terminalBaseline": { "generation": "generation-other", "outputLength": 19 }
          }
        },
        "assertions": [
          "preserve-transcript-on-exit",
          "clear-pending-steer-on-exit",
          "preserve-terminal-watch-intent-on-exit",
          "preserve-other-thread"
        ]
      },
      {
        "id": "exit-other-thread-with-null-code",
        "message": {
          "type": "event",
          "seq": 104,
          "event": { "type": "thread-exited", "threadId": "thread-other", "exitCode": null }
        },
        "before": {
          "thread-target": {
            "transcript": "target transcript remains",
            "pendingSteerId": "steer-target",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-target", "outputLength": 25 }
          },
          "thread-other": {
            "transcript": "other transcript survives signal exit",
            "pendingSteerId": "steer-other-on-exit",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-exit-other", "outputLength": 36 }
          }
        },
        "expectedAfter": {
          "thread-target": {
            "transcript": "target transcript remains",
            "pendingSteerId": "steer-target",
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-target", "outputLength": 25 }
          },
          "thread-other": {
            "transcript": "other transcript survives signal exit",
            "pendingSteerId": null,
            "terminalWatchIntent": true,
            "terminalBaseline": { "generation": "generation-exit-other", "outputLength": 36 }
          }
        },
        "assertions": [
          "preserve-transcript-on-null-exit",
          "clear-pending-steer-on-null-exit",
          "preserve-other-thread"
        ]
      }
    ]
  },
