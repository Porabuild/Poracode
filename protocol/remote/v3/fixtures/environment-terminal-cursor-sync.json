{
  "protocolVersion": 8,
  "hostMode": "desktop",
  "desktopId": "desktop-fixture-cursor-sync",
  "label": "Cursor Sync Fixture",
  "appVersion": "3.0.0-fixture",
  "platform": "darwin",
  "auth": {
    "policy": "remote-reachable",
    "bootstrapMethods": ["one-time-token"],
    "sessionMethods": ["bearer-access-token"],
    "scopes": [
      "session:read",
      "session:operate",
      "terminal:read",
      "terminal:operate",
      "requests:resolve",
      "projects:manage",
      "ports:forward"
    ]
  },
  "endpoints": {
    "httpBaseUrl": "https://poracode-host.example.test/",
    "wsBaseUrl": "wss://poracode-host.example.test/"
  },
  "capabilities": {
    "terminalCursorSync": {
      "versions": [1]
    }
  }
}
