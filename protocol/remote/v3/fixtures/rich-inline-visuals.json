      "--background",
      "--foreground",
      "--surface",
      "--surface-secondary",
      "--muted",
      "--border",
      "--accent",
      "--accent-foreground",
      "--success",
      "--warning",
      "--danger",
      "--font-sans",
      "--font-mono"
    ],
    "convention": "Only settled replies preview complete blocks of formatVersion within maxSourceUtf8Bytes; later blocks in a message stay source. Clients supply every themeVariables entry from their app theme. Reported page heights clamp to minHeight..maxHeight CSS px."
  },
