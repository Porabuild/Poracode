{
  "name": "poracode",
  "version": "2.0.0",
  "private": true,
  "description": "The universal desktop orchestrator for AI agents. Run terminal-native and structured chat agents side-by-side.",
  "homepage": "https://poracode.com/",
  "license": "Apache-2.0",
  "author": "Porabuild",
  "repository": {
    "type": "git",
    "url": "https://github.com/Porabuild/Poracode"
  },
  "workspaces": [
    "website",
    "packages/agents-usage",
    "packages/codex-protocol",
    "packages/poracode-cli"
  ],
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "postinstall": "node scripts/ensure-native-deps.mjs --electron-native && bun run codex-protocol:gen",
    "setup:native": "node scripts/ensure-native-deps.mjs --electron-native",
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"bun run dev:renderer\" \"bun run dev:app\"",
    "dev:test": "cross-env VITE_PORACODE_SKIP_WELCOME=1 bun run dev",
    "devtools": "node scripts/dev-react-devtools.mjs",
    "dev:devtools": "cross-env PORACODE_REACT_DEVTOOLS=1 concurrently -n react-devtools,app -c green,gray \"bun run devtools\" \"bun run dev\"",
    "website:dev": "bun run --cwd website dev",
    "website:build": "bun run --cwd website build",
    "website:start": "bun run --cwd website start",
    "dev:renderer": "node scripts/free-port.mjs && vite",
    "dev:web": "cross-env PORACODE_DEV_SERVER_PORT=3101 bun run dev:web:client",
    "dev:web:client": "node scripts/free-port.mjs && cross-env PORACODE_BUILD_TARGET=web vite",
    "preview:web": "cross-env PORACODE_BUILD_TARGET=web vite preview",
    "dev:electron": "node scripts/prepare-pty-job-owner.mjs --if-supported && node scripts/dev-runtime-watch.mjs",
    "dev:app": "node scripts/dev-launch.mjs",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:extension": "cross-env PORACODE_BUILD_TARGET=extension vite build && node scripts/package-chrome-extension.mjs",
    "build:web": "bun run prepare:web:ssh && cross-env PORACODE_BUILD_TARGET=web vite build && node scripts/finalize-web-build.mjs",
    "dev:web:server": "bun run prepare:web:ssh && cross-env PORACODE_DEV_SERVER_PORT=3101 bun run dev:web:server:run",
    "dev:web:server:run": "node scripts/dev-web-server.mjs",
    "dev:web:server:run:native": "cross-env PORACODE_REMOTE_ACCESS_PORT=49152 node scripts/dev-web-server.mjs",
    "dev:ios": "node scripts/native-dev-ios.mjs",
    "dev:android": "node scripts/native-dev-android.mjs",
    "build:electron": "node scripts/prepare-pty-job-owner.mjs --if-supported && cross-env NODE_ENV=production tsdown",
    "start": "bun run setup:native && electron .",
    "server": "node dist/main/server.cjs",
    "relay": "node dist/main/relay.cjs",
    "prepare:server-native": "node scripts/prepare-server-native.mjs",
    "prepare:service-launcher": "node scripts/prepare-service-launcher.mjs",
    "prepare:pty-job-owner": "node scripts/prepare-pty-job-owner.mjs",
    "assemble:server-tarball": "node scripts/assemble-server-tarball.mjs",
    "install:server-prefix": "node scripts/install-server-prefix.mjs",
    "qualify:server-install": "node scripts/server-install-qualification.mjs",
    "qualify:poracode-cli": "node scripts/poracode-cli-qualification.mjs",
    "runtime-manifest:generate": "node scripts/generate-runtime-manifest.mjs",
    "prepare:wsl-helpers": "node scripts/prepare-wsl-helpers.mjs",
    "prepare:computer-use-helper": "node scripts/prepare-computer-use-helper.mjs --host-only",
    "prepare:agent-plugins": "node scripts/prepare-agent-plugins.mjs",
    "prepare:device-hub": "node scripts/prepare-device-hub.mjs",
    "prepare:package-assets": "node scripts/prepare-wsl-helpers.mjs && node scripts/prepare-agent-plugins.mjs && node scripts/prepare-pty-job-owner.mjs --if-supported",
    "prepare:web:ssh": "bun run build:electron && bun run prepare:package-assets && node scripts/build-web-ssh-runtime.mjs",
    "prepare:desktop-package-assets": "node scripts/prepare-computer-use-helper.mjs --require && bun run prepare:package-assets",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs",
    "clean:sourcemaps": "node scripts/clean-sourcemaps.mjs",
    "codex-protocol:gen": "bun run --cwd packages/codex-protocol generate",
    "tui:install": "bun install --cwd tui --frozen-lockfile --cpu=\"*\" --os=\"*\"",
    "tui:build": "bun scripts/build-tui.mjs",
    "tui:typecheck": "bun run --cwd tui typecheck",
    "tui:test": "bun run --cwd tui test",
    "tui:dev": "bun run --cwd tui dev",
    "protocol:remote:v3:generate": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/remote-v3-ts-register.mjs src/shared/remote/contract/cli.ts",
    "protocol:remote:v3:check": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/remote-v3-ts-register.mjs src/shared/remote/contract/cli.ts --check",
    "dist": "node scripts/build-desktop-artifact.mjs",
    "dist:win": "node scripts/build-desktop-artifact.mjs --platform win --target nsis --arch x64",
    "dist:win:all": "node scripts/build-desktop-artifact.mjs --platform win",
    "dist:linux": "node scripts/build-desktop-artifact.mjs --platform linux",
    "dist:mac": "node scripts/build-desktop-artifact.mjs --platform mac",
    "dist:mac:arm": "node scripts/build-desktop-artifact.mjs --platform mac --target dmg --arch arm64",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:tsc": "bun run tsc --noEmit -p tsconfig.json",
    "architecture:check": "node scripts/architecture-imports.mjs audit && node --test scripts/architecture-imports.test.mjs",
    "typecheck:website": "bun run --cwd website typecheck",
    "lint": "bun lint --deny-warnings . && bun lint --type-aware --deny-warnings -c .oxlintrc.type-aware.json .",
    "lint:fix": "cross-env npm_lifecycle_event=lint bun lint --fix . && cross-env npm_lifecycle_event=lint bun lint --type-aware --fix -c .oxlintrc.type-aware.json .",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "test": "vitest run --configLoader runner",
    "test:perf:cli-hook": "vitest run --configLoader runner --config vitest.perf.config.ts src/supervisor/runtime/cliHookEventChain.perf.test.ts",
    "test:perf:browser": "cross-env PORACODE_BROWSER_BENCH=1 vitest run --configLoader runner --config vitest.perf.config.ts src/main/browser/browserWorkflow.perf.test.ts",
    "test:perf:remote": "vitest run --configLoader runner --config vitest.perf.config.ts src/renderer/state/remote/remoteProtocol.perf.test.ts",
    "test:perf:project-tree": "vitest run --configLoader runner --config vitest.perf.config.ts src/supervisor/projectTree.perf.test.ts",
    "test:integration:providers": "vitest run --configLoader runner --config vitest.integration.config.ts",
    "test:native-dev": "node --test scripts/native-dev-lib.test.mjs",
    "v2perf:qualify": "node scripts/v2-perf-qualify.mjs",
    "v2perf:test": "node --test scripts/v2-perf-qualify.test.mjs scripts/v2-perf-qualify-workflows.test.mjs",
    "n1qual:run": "node scripts/server-n1-qualification.mjs",
    "n1qual:test": "node --test scripts/server-n1-qualification.test.mjs scripts/provider-n1-workflows.test.mjs",
    "native:e2e": "vitest run --config tests/native-e2e/vitest.config.ts",
    "native:e2e:mock-host": "node scripts/native-e2e.mjs mock",
    "native:e2e:real-host": "node scripts/native-e2e.mjs real",
    "smoke:integration": "node .agents/skills/interactive-testing/scripts/run-poracode-smoke.mjs",
    "update-server": "node scripts/update-server.mjs",
    "db:clone": "node scripts/clone-db.mjs",
    "db:clone:nightly": "node scripts/clone-db.mjs nightly",
    "i18n:extract": "lingui extract",
    "i18n:extract:clean": "lingui extract --clean",
    "prepare": "husky"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
