{
  "name": "poracode",
  "version": "1.6.2",
  "private": true,
  "description": "The universal desktop orchestrator for AI agents. Run terminal-native and structured chat agents side-by-side.",
  "homepage": "https://poracode.com/",
  "license": "Apache-2.0",
  "author": "SDSLeon",
  "repository": {
    "type": "git",
    "url": "https://github.com/SDSLeon/lightcode"
  },
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "postinstall": "node scripts/ensure-native-deps.mjs --electron-native && pnpm run codex-protocol:gen",
    "setup:native": "node scripts/ensure-native-deps.mjs --electron-native",
    "dev": "concurrently -k -n renderer,electron,app -c cyan,magenta,yellow \"pnpm run dev:renderer\" \"pnpm run dev:electron\" \"pnpm run dev:app\"",
    "dev:test": "cross-env VITE_PORACODE_SKIP_WELCOME=1 pnpm run dev",
    "devtools": "node scripts/dev-react-devtools.mjs",
    "dev:devtools": "cross-env PORACODE_REACT_DEVTOOLS=1 concurrently -n react-devtools,app -c green,gray \"pnpm run devtools\" \"pnpm run dev\"",
    "website:dev": "pnpm --dir website dev",
    "website:build": "pnpm --dir website build",
    "website:start": "pnpm --dir website start",
    "dev:renderer": "node scripts/free-port.mjs && vite",
    "dev:mobile": "node scripts/free-port.mjs 3100 && cross-env PORACODE_BUILD_TARGET=mobile vite",
    "dev:electron": "tsdown --watch",
    "dev:app": "node scripts/ensure-native-deps.mjs --electron-native && wait-on dist/main/main.cjs dist/main/legacyMigrationWorker.cjs dist/main/mcpProbeWorker.mjs dist/main/cursorSdkWorker.mjs && node scripts/prepare-wsl-helpers.mjs && node scripts/prepare-agent-plugins.mjs && node scripts/wait-dev-server.mjs && node scripts/dev-launch.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:mobile": "pnpm run prepare:mobile:ssh && cross-env PORACODE_BUILD_TARGET=mobile vite build && node scripts/finalize-mobile-build.mjs",
    "cap:configure": "node scripts/configure-mobile-native.mjs",
    "cap:sync": "pnpm run build:mobile && cap sync && pnpm run cap:configure",
    "cap:dev:ios": "node scripts/cap-run-ios.mjs",
    "cap:dev:android": "node scripts/cap-run-android.mjs",
    "dev:mobile:server": "pnpm run build:electron && cross-env PORACODE_IS_DEV=1 PORACODE_REMOTE_ACCESS_PORT=49152 node dist/main/server.cjs",
    "dev:mobile:server:run": "cross-env PORACODE_IS_DEV=1 PORACODE_REMOTE_ACCESS_PORT=49152 node dist/main/server.cjs",
    "dev:ios": "pnpm run prepare:mobile:ssh && concurrently -k -n server,vite,ios -c blue,cyan,magenta \"pnpm run dev:mobile:server:run\" \"pnpm run dev:mobile\" \"pnpm run dev:ios:app\"",
    "dev:ios:app": "wait-on tcp:3100 && pnpm run cap:dev:ios",
    "dev:android": "pnpm run prepare:mobile:ssh && concurrently -k -n server,vite,android,adb -c blue,cyan,green,gray \"pnpm run dev:mobile:server:run\" \"pnpm run dev:mobile\" \"pnpm run dev:android:app\" \"node scripts/android-reverse-server-port.mjs\"",
    "dev:android:app": "wait-on tcp:3100 && pnpm run cap:dev:android",
    "build:electron": "cross-env NODE_ENV=production tsdown",
    "start": "pnpm run setup:native && electron .",
    "server": "node dist/main/server.cjs",
    "relay": "node dist/main/relay.cjs",
    "prepare:server-native": "node scripts/prepare-server-native.mjs",
    "prepare:wsl-helpers": "node scripts/prepare-wsl-helpers.mjs",
    "prepare:agent-plugins": "node scripts/prepare-agent-plugins.mjs",
    "prepare:package-assets": "node scripts/prepare-wsl-helpers.mjs && node scripts/prepare-agent-plugins.mjs",
    "prepare:mobile:ssh": "pnpm run build:electron && pnpm run prepare:package-assets && node scripts/build-mobile-ssh-runtime.mjs",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs",
    "clean:sourcemaps": "node scripts/clean-sourcemaps.mjs",
    "codex-protocol:gen": "pnpm --filter @poracode/codex-protocol run generate",
    "dist": "node scripts/build-desktop-artifact.mjs",
    "dist:win": "node scripts/build-desktop-artifact.mjs --platform win --target nsis --arch x64",
    "dist:win:all": "node scripts/build-desktop-artifact.mjs --platform win",
    "dist:linux": "node scripts/build-desktop-artifact.mjs --platform linux",
    "dist:mac": "node scripts/build-desktop-artifact.mjs --platform mac",
    "dist:mac:arm": "node scripts/build-desktop-artifact.mjs --platform mac --target dmg --arch arm64",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "typecheck:website": "pnpm --dir website typecheck",
    "lint": "oxlint --deny-warnings . && oxlint --type-aware --deny-warnings -c .oxlintrc.type-aware.json .",
    "lint:fix": "oxlint --fix . && oxlint --type-aware --fix -c .oxlintrc.type-aware.json .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --configLoader runner",
    "test:perf:cli-hook": "vitest run --configLoader runner src/supervisor/runtime/cliHookEventChain.perf.test.ts",
    "test:perf:remote": "vitest run --configLoader runner src/mobile/remoteProtocol.perf.test.ts",
    "test:integration:providers": "vitest run --configLoader runner --config vitest.integration.config.ts",
    "smoke:integration": "node .agents/skills/interactive-testing/scripts/run-poracode-smoke.mjs",
    "update-server": "node scripts/update-server.mjs",
    "db:clone": "node scripts/clone-db.mjs",
    "db:clone:nightly": "node scripts/clone-db.mjs nightly",
    "i18n:extract": "lingui extract",
    "i18n:extract:clean": "lingui extract --clean",
    "prepare": "husky"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.219",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@chenglou/pretext": "^0.0.8",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/geometry": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@dnd-kit/state": "^0.5.0",
    "@git-diff-view/core": "^0.1.6",
    "@git-diff-view/react": "^0.1.6",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@legendapp/list": "3.3.3",
    "@lingui/core": "6.4.0",
    "@lingui/react": "6.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@number-flow/react": "^0.6.2",
    "@opencode-ai/sdk": "^1.18.10",
    "@poracode/activity-bridge": "file:native/activity-bridge",
    "@poracode/agents-usage": "workspace:*",
    "@poracode/codex-protocol": "workspace:*",
    "@poracode/ssh-bridge": "file:native/ssh-bridge",
    "@sentry/electron": "^7.15.0",
    "@sentry/node": "10.63.0",
    "@sindresorhus/slugify": "^2.2.1",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-virtual": "^3.14.5",
    "@tiptap/extensions": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@vercel/analytics": "^2.0.1",
    "@xterm/addon-clipboard": "0.3.0-beta.219",
    "@xterm/addon-fit": "0.12.0-beta.219",
    "@xterm/addon-image": "0.10.0-beta.219",
    "@xterm/addon-search": "0.17.0-beta.219",
    "@xterm/addon-unicode11": "0.10.0-beta.219",
    "@xterm/addon-web-links": "0.13.0-beta.219",
    "@xterm/addon-webgl": "0.20.0-beta.218",
    "@xterm/xterm": "6.1.0-beta.219",
    "better-sqlite3": "^12.11.1",
    "dexie": "^4.4.4",
    "drizzle-orm": "1.0.0-rc.1",
    "electron-updater": "^6.8.9",
    "json5": "^2.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.23.0",
    "material-icon-theme": "^5.36.1",
    "micromatch": "^4.0.8",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3",
    "shiki": "^4.3.0",
    "smol-toml": "^1.7.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.2",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@electron/rebuild": "^4.1.0",
    "@lingui/babel-plugin-lingui-macro": "6.4.0",
    "@lingui/cli": "6.4.0",
    "@lingui/format-po": "6.4.0",
    "@lingui/vite-plugin": "6.4.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/cli": "^3.6.0",
    "@shikijs/langs": "4.3.0",
    "@shikijs/themes": "4.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "acorn": "^8.17.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.1",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.16",
    "react-devtools": "^7.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
  "electronmon": {
    "patterns": [
      "!src/**",
      "!dist/renderer/**",
      "!build/**",
      "!release/**",
      "!.agents/**",
      "!.heroui-docs/**",
      "!scripts/**"
    ]
  }
}
