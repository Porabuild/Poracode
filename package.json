{
  "name": "poracode",
  "version": "1.8.0",
  "private": true,
  "description": "The universal desktop orchestrator for AI agents. Run terminal-native and structured chat agents side-by-side.",
  "homepage": "https://poracode.com/",
  "license": "Apache-2.0",
  "author": "Porabuild",
  "repository": {
    "type": "git",
    "url": "https://github.com/Porabuild/Poracode"
  },
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "postinstall": "node scripts/ensure-native-deps.mjs --electron-native && pnpm run codex-protocol:gen",
    "setup:native": "node scripts/ensure-native-deps.mjs --electron-native",
    "dev": "concurrently -k -n renderer,electron,app -c cyan,magenta,yellow \"pnpm run dev:renderer\" \"pnpm run dev:electron\" \"pnpm run dev:app\"",
    "dev:test": "cross-env VITE_PORACODE_SKIP_WELCOME=1 pnpm run dev",
    "devtools": "node scripts/dev-react-devtools.mjs",
    "dev:devtools": "cross-env PORACODE_REACT_DEVTOOLS=1 concurrently -n react-devtools,app -c green,gray \"pnpm run devtools\" \"pnpm run dev\"",
    "website:dev": "pnpm --dir website dev",
    "website:build": "pnpm --dir website build",
    "website:start": "pnpm --dir website start",
    "dev:renderer": "node scripts/free-port.mjs && vite",
    "dev:web": "cross-env PORACODE_DEV_SERVER_PORT=3101 pnpm run dev:web:client",
    "dev:web:client": "node scripts/free-port.mjs && cross-env PORACODE_BUILD_TARGET=web vite",
    "preview:web": "cross-env PORACODE_BUILD_TARGET=web vite preview",
    "dev:electron": "tsdown --watch",
    "dev:app": "node scripts/ensure-native-deps.mjs --electron-native && wait-on dist/main/main.cjs dist/main/legacyMigrationWorker.cjs dist/main/mcpProbeWorker.mjs dist/main/cursorSdkWorker.mjs && node scripts/prepare-computer-use-helper.mjs --host-only --dev && node scripts/prepare-wsl-helpers.mjs && node scripts/prepare-agent-plugins.mjs && node scripts/wait-dev-server.mjs && node scripts/dev-launch.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:web": "pnpm run prepare:web:ssh && cross-env PORACODE_BUILD_TARGET=web vite build && node scripts/finalize-web-build.mjs",
    "dev:web:server": "pnpm run prepare:web:ssh && cross-env PORACODE_DEV_SERVER_PORT=3101 pnpm run dev:web:server:run",
    "dev:web:server:run": "node scripts/dev-web-server.mjs",
    "dev:web:server:run:native": "cross-env PORACODE_REMOTE_ACCESS_PORT=49152 node scripts/dev-web-server.mjs",
    "dev:ios": "node scripts/native-dev-ios.mjs",
    "dev:android": "node scripts/native-dev-android.mjs",
    "build:electron": "cross-env NODE_ENV=production tsdown",
    "start": "pnpm run setup:native && electron .",
    "server": "node dist/main/server.cjs",
    "relay": "node dist/main/relay.cjs",
    "prepare:server-native": "node scripts/prepare-server-native.mjs",
    "prepare:wsl-helpers": "node scripts/prepare-wsl-helpers.mjs",
    "prepare:computer-use-helper": "node scripts/prepare-computer-use-helper.mjs --host-only",
    "prepare:agent-plugins": "node scripts/prepare-agent-plugins.mjs",
    "prepare:package-assets": "node scripts/prepare-wsl-helpers.mjs && node scripts/prepare-agent-plugins.mjs",
    "prepare:web:ssh": "pnpm run build:electron && pnpm run prepare:package-assets && node scripts/build-web-ssh-runtime.mjs",
    "prepare:desktop-package-assets": "node scripts/prepare-computer-use-helper.mjs --require && pnpm run prepare:package-assets",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.mjs",
    "clean:sourcemaps": "node scripts/clean-sourcemaps.mjs",
    "codex-protocol:gen": "pnpm --filter @poracode/codex-protocol run generate",
    "protocol:remote:v3:generate": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/remote-v3-ts-register.mjs src/shared/remote/contract/cli.ts",
    "protocol:remote:v3:check": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/remote-v3-ts-register.mjs src/shared/remote/contract/cli.ts --check",
    "dist": "node scripts/build-desktop-artifact.mjs",
    "dist:win": "node scripts/build-desktop-artifact.mjs --platform win --target nsis --arch x64",
    "dist:win:all": "node scripts/build-desktop-artifact.mjs --platform win",
    "dist:linux": "node scripts/build-desktop-artifact.mjs --platform linux",
    "dist:mac": "node scripts/build-desktop-artifact.mjs --platform mac",
    "dist:mac:arm": "node scripts/build-desktop-artifact.mjs --platform mac --target dmg --arch arm64",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "typecheck:website": "pnpm --filter poracode-website typecheck",
    "lint": "oxlint --deny-warnings . && oxlint --type-aware --deny-warnings -c .oxlintrc.type-aware.json .",
    "lint:fix": "oxlint --fix . && oxlint --type-aware --fix -c .oxlintrc.type-aware.json .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --configLoader runner",
    "test:perf:cli-hook": "vitest run --configLoader runner src/supervisor/runtime/cliHookEventChain.perf.test.ts",
    "test:perf:browser": "cross-env PORACODE_BROWSER_BENCH=1 vitest run --configLoader runner src/main/browser/browserWorkflow.perf.test.ts",
    "test:perf:remote": "vitest run --configLoader runner src/renderer/state/remote/remoteProtocol.perf.test.ts",
    "test:integration:providers": "vitest run --configLoader runner --config vitest.integration.config.ts",
    "test:native-dev": "node --test scripts/native-dev-lib.test.mjs",
    "native:e2e": "vitest run --config tests/native-e2e/vitest.config.ts",
    "native:e2e:mock-host": "node scripts/native-e2e.mjs mock",
    "native:e2e:real-host": "node scripts/native-e2e.mjs real",
    "smoke:integration": "node .agents/skills/interactive-testing/scripts/run-poracode-smoke.mjs",
    "update-server": "node scripts/update-server.mjs",
    "db:clone": "node scripts/clone-db.mjs",
    "db:clone:nightly": "node scripts/clone-db.mjs nightly",
    "i18n:extract": "lingui extract",
    "i18n:extract:clean": "lingui extract --clean",
    "prepare": "husky"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@chenglou/pretext": "^0.0.8",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/geometry": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@dnd-kit/state": "^0.5.0",
    "@git-diff-view/core": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@huggingface/transformers": "^4.2.0",
    "@legendapp/list": "3.3.3",
    "@lingui/core": "6.6.0",
    "@lingui/react": "6.6.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@number-flow/react": "^0.6.2",
    "@opencode-ai/sdk": "^1.18.27",
    "@poracode/agents-usage": "workspace:*",
    "@poracode/codex-protocol": "workspace:*",
    "@sentry/electron": "7.17.0",
    "@sentry/node": "10.72.0",
    "@sindresorhus/slugify": "2.2.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@vercel/analytics": "^2.0.1",
    "@xterm/addon-clipboard": "0.3.0-beta.302",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-image": "0.10.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.303",
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.9",
    "json5": "^2.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "1.41.0",
    "material-icon-theme": "^5.38.1",
    "micromatch": "^4.0.8",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "0.35.4",
    "shiki": "^4.4.3",
    "smol-toml": "^1.8.0",
    "streamdown": "^2.6.0",
    "tailwindcss": "4.3.3",
    "unified": "^11.0.5",
    "vscode-jsonrpc": "^9.0.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electron/rebuild": "^4.1.0",
    "@lingui/babel-plugin-lingui-macro": "6.6.0",
    "@lingui/cli": "6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/vite-plugin": "6.6.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/cli": "^3.7.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "acorn": "^8.18.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "esbuild": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.5.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.26",
    "react-devtools": "^7.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@12.3.4",
  "electronmon": {
    "patterns": [
      "!*",
      "!*/**",
      "dist/main/**",
      "dist/electron-native/**",
      "dist/server-native/**"
    ]
  }
}
