{
  "name": "lightcode",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal-native AI agents desktop app for Windows and WSL.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicepkg/lightcode"
  },
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "postinstall": "electron-rebuild --only better-sqlite3 && node scripts/ensure-native-deps.mjs",
    "setup:native": "electron-rebuild --only better-sqlite3 && node scripts/ensure-native-deps.mjs",
    "dev": "concurrently -k -n renderer,electron,app -c cyan,magenta,yellow \"pnpm run dev:renderer\" \"pnpm run dev:electron\" \"pnpm run dev:app\"",
    "dev:renderer": "node scripts/free-port.mjs 5173 && vite",
    "dev:electron": "tsdown --watch",
    "dev:app": "pnpm run setup:native && wait-on tcp:5173 dist/main/main.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electronmon .",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsdown",
    "start": "pnpm run setup:native && electron .",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "typecheck": "pnpm exec tsgo --noEmit -p tsconfig.json",
    "typecheck:compat": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm exec oxlint --type-aware --import-plugin --node-plugin --react-plugin --jsx-a11y-plugin --vitest-plugin --deny-warnings src vite.config.ts tsdown.config.ts vitest.config.ts",
    "lint:fix": "pnpm exec oxlint --type-aware --import-plugin --node-plugin --react-plugin --jsx-a11y-plugin --vitest-plugin --fix src vite.config.ts tsdown.config.ts vitest.config.ts",
    "fmt": "pnpm exec oxfmt --write .",
    "fmt:check": "pnpm exec oxfmt --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@git-diff-view/core": "^0.1.3",
    "@git-diff-view/react": "^0.1.3",
    "@heroui/react": "^3.0.1",
    "@heroui/styles": "^3.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.7.0",
    "material-icon-theme": "^5.33.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-git": "^3.33.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electron/rebuild": "^4.0.3",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "jsdom": "^29.0.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.18.1",
    "postcss": "^8.5.8",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
