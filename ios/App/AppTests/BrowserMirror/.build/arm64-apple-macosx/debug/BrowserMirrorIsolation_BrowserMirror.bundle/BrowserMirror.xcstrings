    "browser-mirror.viewport-hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to click, drag to scroll."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Klicken, ziehen zum Scrollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para hacer clic, arrastra para desplazar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour cliquer, faites glisser pour défiler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでクリック、ドラッグでスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 클릭, 드래그하면 스크롤됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij, aby kliknąć; przeciągnij, aby przewinąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para clicar, arraste para rolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите для клика, потяните для прокрутки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tıklamak için dokun, kaydırmak için sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб клацнути; потягніть, щоб прокрутити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để nhấp, kéo để cuộn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点为点击，拖动为滚动。"
          }
        }
      }
