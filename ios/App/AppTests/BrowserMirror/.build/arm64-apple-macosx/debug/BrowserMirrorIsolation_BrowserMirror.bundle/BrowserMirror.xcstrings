    "browser-mirror.ambiguous": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result of the last action is unknown. The browser state was refreshed instead of repeating it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der letzten Aktion ist unbekannt. Der Browserzustand wurde aktualisiert, anstatt sie zu wiederholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la última acción es desconocido. Se actualizó el estado del navegador en lugar de repetirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la dernière action est inconnu. L’état du navigateur a été actualisé au lieu de la répéter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の操作の結果は不明です。操作を繰り返す代わりにブラウザの状態を再取得しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 작업의 결과를 알 수 없습니다. 작업을 반복하지 않고 브라우저 상태를 새로 가져왔습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik ostatniej akcji jest nieznany. Zamiast jej powtórzenia odświeżono stan przeglądarki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da última ação é desconhecido. O estado do navegador foi atualizado em vez de repeti-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат последнего действия неизвестен. Вместо повтора состояние браузера было обновлено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son işlemin sonucu bilinmiyor. İşlem yinelenmek yerine tarayıcı durumu yenilendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат останньої дії невідомий. Замість повторення стан браузера було оновлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không rõ kết quả của hành động vừa rồi. Trạng thái trình duyệt đã được làm mới thay vì thực hiện lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一个操作的结果未知。已刷新浏览器状态，而不是重复该操作。"
          }
        }
      }
    },
    "browser-mirror.ambiguous-unresolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result of the last action is unknown and could not be confirmed. Refresh before repeating it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der letzten Aktion ist unbekannt und konnte nicht bestätigt werden. Aktualisiere, bevor du sie wiederholst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la última acción es desconocido y no se pudo confirmar. Actualiza antes de repetirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la dernière action est inconnu et n’a pas pu être confirmé. Actualisez avant de la répéter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の操作の結果は不明で、確認できませんでした。繰り返す前に再取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 작업의 결과를 알 수 없고 확인할 수도 없습니다. 반복하기 전에 새로 고치세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik ostatniej akcji jest nieznany i nie udało się go potwierdzić. Odśwież przed jej powtórzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da última ação é desconhecido e não pôde ser confirmado. Atualize antes de repeti-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат последнего действия неизвестен и не подтверждён. Обновите состояние перед повтором."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son işlemin sonucu bilinmiyor ve doğrulanamadı. Yinelemeden önce yenile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат останньої дії невідомий і його не вдалося підтвердити. Оновіть стан перед повторенням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không rõ và không thể xác nhận kết quả của hành động vừa rồi. Hãy làm mới trước khi thực hiện lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一个操作的结果未知且无法确认。请先刷新再重复该操作。"
          }
        }
      }
    },
