    "browser-mirror.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirrored pages can show personal content. Frames stay on this device and are cleared when you leave this screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespiegelte Seiten können persönliche Inhalte zeigen. Bilder bleiben auf diesem Gerät und werden beim Verlassen dieses Bildschirms gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas duplicadas pueden mostrar contenido personal. Los fotogramas permanecen en este dispositivo y se borran al salir de esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages dupliquées peuvent afficher du contenu personnel. Les images restent sur cet appareil et sont effacées lorsque vous quittez cet écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラーリングされたページには個人的な内容が表示される場合があります。フレームはこの端末内に留まり、この画面を離れると消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미러링된 페이지에는 개인 정보가 표시될 수 있습니다. 프레임은 이 기기에만 남고 이 화면을 벗어나면 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dublowane strony mogą zawierać treści osobiste. Klatki pozostają na tym urządzeniu i są usuwane po opuszczeniu tego ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas espelhadas podem mostrar conteúdo pessoal. Os quadros ficam neste dispositivo e são apagados ao sair desta tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зеркалируемые страницы могут содержать личные данные. Кадры остаются на этом устройстве и удаляются при выходе с этого экрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yansıtılan sayfalar kişisel içerik gösterebilir. Kareler bu cihazda kalır ve bu ekrandan çıktığınızda silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзеркальні сторінки можуть показувати особистий вміст. Кадри залишаються на цьому пристрої та видаляються, коли ви покидаєте цей екран."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang được phản chiếu có thể hiển thị nội dung cá nhân. Khung hình chỉ nằm trên thiết bị này và bị xoá khi bạn rời màn hình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像页面可能显示个人内容。画面仅保留在本设备上，离开此界面后即被清除。"
          }
        }
      }
    },
