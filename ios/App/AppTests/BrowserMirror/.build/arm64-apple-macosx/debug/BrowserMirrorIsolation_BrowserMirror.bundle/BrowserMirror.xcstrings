    "browser-mirror.background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring pauses while Poracode is in the background."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiegeln pausiert, während Poracode im Hintergrund ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplicación se pausa mientras Poracode está en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La duplication est suspendue lorsque Poracode est en arrière-plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode がバックグラウンドの間、ミラーリングは一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode가 백그라운드에 있는 동안 미러링이 일시 중지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dublowanie jest wstrzymane, gdy Poracode działa w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espelhamento pausa enquanto o Poracode está em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зеркалирование приостановлено, пока Poracode в фоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode arka plandayken yansıtma duraklatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дзеркалювання призупинено, поки Poracode у фоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản chiếu tạm dừng khi Poracode ở chế độ nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode 处于后台时镜像会暂停。"
          }
        }
      }
    },
