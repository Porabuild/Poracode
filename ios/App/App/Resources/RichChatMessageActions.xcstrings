"Fork thread"}},"de":{"stringUnit":{"state":"translated","value":"Unterhaltung verzweigen"}},"es":{"stringUnit":{"state":"translated","value":"Bifurcar conversación"}},"fr":{"stringUnit":{"state":"translated","value":"Créer une branche de conversation"}},"ja":{"stringUnit":{"state":"translated","value":"会話を分岐"}},"ko":{"stringUnit":{"state":"translated","value":"대화 분기"}},"pl":{"stringUnit":{"state":"translated","value":"Rozgałęź rozmowę"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ramificar conversa"}},"ru":{"stringUnit":{"state":"translated","value":"Ответвить разговор"}},"tr":{"stringUnit":{"state":"translated","value":"Konuşmayı dallandır"}},"uk":{"stringUnit":{"state":"translated","value":"Відгалузити розмову"}},"vi":{"stringUnit":{"state":"translated","value":"Tạo nhánh trò chuyện"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分支对话"}}}},"rich.fork.create":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Create fork"}},"de":{"stringUnit":{"state":"translated","value":"Abzweigung erstellen"}},"es":{"stringUnit":{"state":"translated","value":"Crear bifurcación"}},"fr":{"stringUnit":{"state":"translated","value":"Créer une branche"}},"ja":{"stringUnit":{"state":"translated","value":"分岐を作成"}},"ko":{"stringUnit":{"state":"translated","value":"분기 만들기"}},"pl":{"stringUnit":{"state":"translated","value":"Utwórz odgałęzienie"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Criar ramificação"}},"ru":{"stringUnit":{"state":"translated","value":"Создать ответвление"}},"tr":{"stringUnit":{"state":"translated","value":"Dal oluştur"}},"uk":{"stringUnit":{"state":"translated","value":"Створити відгалуження"}},"vi":{"stringUnit":{"state":"translated","value":"Tạo nhánh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建分支"}}}},"rich.fork.explanation":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Creates an independent conversation through a completed turn. Files stay in the same checkout."}},"de":{"stringUnit":{"state":"translated","value":"Erstellt eine unabhängige Unterhaltung bis zu einem abgeschlossenen Durchgang. Dateien bleiben im selben Checkout."}},"es":{"stringUnit":{"state":"translated","value":"Crea una conversación independiente hasta un turno completado. Los archivos permanecen en el mismo árbol de trabajo."}},"fr":{"stringUnit":{"state":"translated","value":"Crée une conversation indépendante jusqu’à un tour terminé. Les fichiers restent dans le même répertoire de travail."}},"ja":{"stringUnit":{"state":"translated","value":"完了したターンまでの独立した会話を作成します。ファイルは同じチェックアウトに残ります。"}},"ko":{"stringUnit":{"state":"translated","value":"완료된 턴까지의 독립적인 대화를 만듭니다. 파일은 같은 체크아웃에 유지됩니다."}},"pl":{"stringUnit":{"state":"translated","value":"Tworzy niezależną rozmowę do zakończonej tury. Pliki pozostają w tym samym katalogu roboczym."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cria uma conversa independente até um turno concluído. Os arquivos permanecem na mesma cópia de trabalho."}},"ru":{"stringUnit":{"state":"translated","value":"Создаёт независимый разговор до завершённого хода. Файлы остаются в той же рабочей копии."}},"tr":{"stringUnit":{"state":"translated","value":"Tamamlanmış bir tura kadar bağımsız bir konuşma oluşturur. Dosyalar aynı çalışma kopyasında kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Створює незалежну розмову до завершеного ходу. Файли залишаються в тій самій робочій копії."}},"vi":{"stringUnit":{"state":"translated","value":"Tạo cuộc trò chuyện độc lập đến hết một lượt đã hoàn tất. Các tệp vẫn ở cùng bản làm việc."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建截至某个已完成轮次的独立对话。文件保留在同一工作副本中。"}}}},"rich.fork.name":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Thread name"}},"de":{"stringUnit":{"state":"translated","value":"Name der Unterhaltung"}},"es":{"stringUnit":{"state":"translated","value":"Nombre de la conve