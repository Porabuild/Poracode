{"sourceLanguage":"en","strings":{"rich.message.copy":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Message"}},"de":{"stringUnit":{"state":"translated","value":"Nachricht kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar mensaje"}},"fr":{"stringUnit":{"state":"translated","value":"Copier le message"}},"ja":{"stringUnit":{"state":"translated","value":"メッセージをコピー"}},"ko":{"stringUnit":{"state":"translated","value":"메시지 복사"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj wiadomość"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar mensagem"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать сообщение"}},"tr":{"stringUnit":{"state":"translated","value":"İletiyi kopyala"}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати повідомлення"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép tin nhắn"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"复制消息"}}}},"rich.message.revert.action":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Revert to This Checkpoint"}},"de":{"stringUnit":{"state":"translated","value":"Zu diesem Checkpoint zurückkehren"}},"es":{"stringUnit":{"state":"translated","value":"Volver a este punto de control"}},"fr":{"stringUnit":{"state":"translated","value":"Revenir à ce point de contrôle"}},"ja":{"stringUnit":{"state":"translated","value":"このチェックポイントに戻す"}},"ko":{"stringUnit":{"state":"translated","value":"이 체크포인트로 되돌리기"}},"pl":{"stringUnit":{"state":"translated","value":"Przywróć ten punkt kontrolny"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reverter para este ponto de controle"}},"ru":{"stringUnit":{"state":"translated","value":"Вернуться к этой контрольной точке"}},"tr":{"stringUnit":{"state":"translated","value":"Bu kontrol noktasına geri dön"}},"uk":{"stringUnit":{"state":"translated","value":"Повернутися до цієї контрольної точки"}},"vi":{"stringUnit":{"state":"translated","value":"Quay lại điểm kiểm tra này"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还原到此检查点"}}}},"rich.message.revert.title":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Revert to checkpoint?"}},"de":{"stringUnit":{"state":"translated","value":"Zum Checkpoint zurückkehren?"}},"es":{"stringUnit":{"state":"translated","value":"¿Volver al punto de control?"}},"fr":{"stringUnit":{"state":"translated","value":"Revenir au point de contrôle ?"}},"ja":{"stringUnit":{"state":"translated","value":"チェックポイントに戻しますか？"}},"ko":{"stringUnit":{"state":"translated","value":"체크포인트로 되돌릴까요?"}},"pl":{"stringUnit":{"state":"translated","value":"Przywrócić punkt kontrolny?"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reverter para o ponto de controle?"}},"ru":{"stringUnit":{"state":"translated","value":"Вернуться к контрольной точке?"}},"tr":{"stringUnit":{"state":"translated","value":"Kontrol noktasına geri dönülsün mü?"}},"uk":{"stringUnit":{"state":"translated","value":"Повернутися до контрольної точки?"}},"vi":{"stringUnit":{"state":"translated","value":"Quay lại điểm kiểm tra?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还原到检查点？"}}}},"rich.message.revert.message":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This removes later messages and restores files when a checkpoint snapshot is available."}},"de":{"stringUnit":{"state":"translated","value":"Dadurch werden spätere Nachrichten entfernt und Dateien wiederhergestellt, wenn ein Checkpoint-Snapshot verfügbar ist."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina los mensajes posteriores y restaura los archivos cuando hay una instantánea del punto de control disponible."}},"fr":{"stringUnit":{"state":"translated","value":"Cette action supprime les messages suivants et restaure les fichiers lorsqu’un instantané de point de contrôle est disponible."}},"ja":{"stringUnit":{"state":"translated","value":"後続のメッセージを削除し、チェックポイントのスナップショットがある場合はファイルを復元します。"}},"ko":{"stringUnit":{"state":"translated","value":"이후 메시지를 제거하고 체크포인트 스냅샷이 있으면 파일을 복원합니다."}},"pl":{"stringUnit":{"state":"translated","value":"Spowoduje to usunięcie późniejszych wiadomości i przywrócenie plików, jeśli jest dostępna migawka punktu kontrolnego."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Isso remove as mensagens posteriores e restaura os arquivos quando há um snapshot do ponto de controle disponível."}},"ru":{"stringUnit":{"state":"translated","value":"Последующие сообщения будут удалены, а файлы восстановлены, если доступен снимок контрольной точки."}},"tr":{"stringUnit":{"state":"translated","value":"Bu işlem sonraki iletileri kaldırır ve bir kontrol noktası anlık görüntüsü varsa dosyaları geri yükler."}},"uk":{"stringUnit":{"state":"translated","value":"Наступні повідомлення буде видалено, а файли відновлено, якщо доступний знімок контрольної точки."}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này xóa các tin nhắn sau đó và khôi phục tệp khi có ảnh chụp điểm kiểm tra."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会删除后续消息，并在有检查点快照时恢复文件。"}}}},"rich.message.revert.noFiles":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No file checkpoint is stored for this message."}},"de":{"stringUnit":{"state":"translated","value":"Für diese Nachricht ist kein Datei-Checkpoint gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"No hay un punto de control de archivos guardado para este mensaje."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun point de contrôle de fichiers n’est enregistré pour ce message."}},"ja":{"stringUnit":{"state":"translated","value":"このメッセージのファイルチェックポイントは保存されていません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 메시지에 저장된 파일 체크포인트가 없습니다."}},"pl":{"stringUnit":{"state":"translated","value":"Dla tej wiadomości nie zapisano punktu kontrolnego plików."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum ponto de controle de arquivos foi salvo para esta mensagem."}},"ru":{"stringUnit":{"state":"translated","value":"Для этого сообщения нет сохранённой контрольной точки файлов."}},"tr":{"stringUnit":{"state":"translated","value":"Bu ileti için kayıtlı bir dosya kontrol noktası yok."}},"uk":{"stringUnit":{"state":"translated","value":"Для цього повідомлення немає збереженої контрольної точки файлів."}},"vi":{"stringUnit":{"state":"translated","value":"Không có điểm kiểm tra tệp nào được lưu cho tin nhắn này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未为此消息保存文件检查点。"}}}},"rich.message.revert.shared.one":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Another chat uses this same tree. File restore could overwrite that chat's changes."}},"de":{"stringUnit":{"state":"translated","value":"Ein anderer Chat verwendet denselben Baum. Die Dateiwiederherstellung könnte dessen Änderungen überschreiben."}},"es":{"stringUnit":{"state":"translated","value":"Otro chat usa este mismo árbol. Restaurar archivos podría sobrescribir sus cambios."}},"fr":{"stringUnit":{"state":"translated","value":"Un autre chat utilise la même arborescence. La restauration pourrait écraser ses modifications."}},"ja":{"stringUnit":{"state":"translated","value":"別のチャットが同じツリーを使用しています。ファイルの復元によって、そのチャットの変更が上書きされる可能性があります。"}},"ko":{"stringUnit":{"state":"translated","value":"다른 채팅이 같은 트리를 사용합니다. 파일 복원으로 해당 채팅의 변경 사항을 덮어쓸 수 있습니다."}},"pl":{"stringUnit":{"state":"translated","value":"Inny czat używa tego samego drzewa. Przywrócenie plików może nadpisać jego zmiany."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Outro chat usa a mesma árvore. A restauração pode sobrescrever as alterações desse chat."}},"ru":{"stringUnit":{"state":"translated","value":"Другой чат использует то же дерево. Восстановление файлов может перезаписать его изменения."}},"tr":{"stringUnit":{"state":"translated","value":"Başka bir sohbet aynı ağacı kullanıyor. Dosya geri yükleme o sohbetin değişikliklerinin üzerine yazabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Інший чат використовує те саме дерево. Відновлення файлів може перезаписати його зміни."}},"vi":{"stringUnit":{"state":"translated","value":"Một cuộc trò chuyện khác dùng cùng cây này. Việc khôi phục tệp có thể ghi đè thay đổi của cuộc trò chuyện đó."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另一个聊天正在使用同一工作树。恢复文件可能会覆盖该聊天的更改。"}}}},"rich.message.revert.shared.many":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld other chats use this same tree. File restore could overwrite their changes."}},"de":{"stringUnit":{"state":"translated","value":"%lld weitere Chats verwenden denselben Baum. Die Dateiwiederherstellung könnte deren Änderungen überschreiben."}},"es":{"stringUnit":{"state":"translated","value":"%lld chats más usan este mismo árbol. Restaurar archivos podría sobrescribir sus cambios."}},"fr":{"stringUnit":{"state":"translated","value":"%lld autres chats utilisent la même arborescence. La restauration pourrait écraser leurs modifications."}},"ja":{"stringUnit":{"state":"translated","value":"ほかに %lld 件のチャットが同じツリーを使用しています。ファイルの復元によって変更が上書きされる可能性があります。"}},"ko":{"stringUnit":{"state":"translated","value":"다른 채팅 %lld개가 같은 트리를 사용합니다. 파일 복원으로 변경 사항을 덮어쓸 수 있습니다."}},"pl":{"stringUnit":{"state":"translated","value":"%lld innych czatów używa tego samego drzewa. Przywrócenie plików może nadpisać ich zmiany."}},"pt-BR":{"stringUnit":{"state":"translated","value":"%lld outros chats usam a mesma árvore. A restauração pode sobrescrever as alterações deles."}},"ru":{"stringUnit":{"state":"translated","value":"Ещё %lld чатов используют то же дерево. Восстановление файлов может перезаписать их изменения."}},"tr":{"stringUnit":{"state":"translated","value":"%lld başka sohbet aynı ağacı kullanıyor. Dosya geri yükleme değişikliklerinin üzerine yazabilir."}},"uk":{"stringUnit":{"state":"translated","value":"Ще %lld чатів використовують те саме дерево. Відновлення файлів може перезаписати їхні зміни."}},"vi":{"stringUnit":{"state":"translated","value":"%lld cuộc trò chuyện khác dùng cùng cây này. Việc khôi phục tệp có thể ghi đè thay đổi của họ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另有 %lld 个聊天正在使用同一工作树。恢复文件可能会覆盖它们的更改。"}}}},"rich.message.revert.confirm":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Revert"}},"de":{"stringUnit":{"state":"translated","value":"Zurücksetzen"}},"es":{"stringUnit":{"state":"translated","value":"Revertir"}},"fr":{"stringUnit":{"state":"translated","value":"Rétablir"}},"ja":{"stringUnit":{"state":"translated","value":"元に戻す"}},"ko":{"stringUnit":{"state":"translated","value":"되돌리기"}},"pl":{"stringUnit":{"state":"translated","value":"Przywróć"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Reverter"}},"ru":{"stringUnit":{"state":"translated","value":"Вернуть"}},"tr":{"stringUnit":{"state":"translated","value":"Geri döndür"}},"uk":{"stringUnit":{"state":"translated","value":"Повернути"}},"vi":{"stringUnit":{"state":"translated","value":"Hoàn nguyên"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还原"}}}},"rich.image.copy":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy Image"}},"de":{"stringUnit":{"state":"translated","value":"Bild kopieren"}},"es":{"stringUnit":{"state":"translated","value":"Copiar imagen"}},"fr":{"stringUnit":{"state":"translated","value":"Copier l’image"}},"ja":{"stringUnit":{"state":"translated","value":"画像をコピー"}},"ko":{"stringUnit":{"state":"translated","value":"이미지 복사"}},"pl":{"stringUnit":{"state":"translated","value":"Kopiuj obraz"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copiar imagem"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать изображение"}},"tr":{"stringUnit":{"state":"translated","value":"Görseli kop