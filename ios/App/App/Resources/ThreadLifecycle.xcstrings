    "thread.lifecycle.moveWorktree.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Move Thread to Worktree?" } },
        "de": { "stringUnit": { "state": "translated", "value": "Thread in einen Worktree verschieben?" } },
        "es": { "stringUnit": { "state": "translated", "value": "¿Mover el hilo a un árbol de trabajo?" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Déplacer le fil vers un arbre de travail ?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "スレッドをワークツリーに移動しますか？" } },
        "ko": { "stringUnit": { "state": "translated", "value": "스레드를 워크트리로 이동할까요?" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przenieść wątek do drzewa roboczego?" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Mover a conversa para uma árvore de trabalho?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Переместить ветку в рабочее дерево?" } },
        "tr": { "stringUnit": { "state": "translated", "value": "İleti dizisi çalışma ağacına taşınsın mı?" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Перемістити гілку в робоче дерево?" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Di chuyển luồng vào cây làm việc?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "将线程移至工作树？" } }
      }
    },
    "thread.lifecycle.moveWorktree.withChanges.message": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current runtime will stop. A new worktree and branch will be created, and uncommitted changes will move there before the thread resumes." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die aktuelle Laufzeit wird beendet. Ein neuer Worktree und Branch werden erstellt und nicht übertragene Änderungen dorthin verschoben, bevor der Thread fortgesetzt wird." } },
        "es": { "stringUnit": { "state": "translated", "value": "La ejecución actual se detendrá. Se crearán un árbol de trabajo y una rama nuevos, y los cambios sin confirmar se moverán allí antes de reanudar el hilo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’exécution actuelle va s’arrêter. Un nouvel arbre de travail et une nouvelle branche seront créés, puis les modifications non validées y seront déplacées avant la reprise du fil." } },
        "ja": { "stringUnit": { "state": "translated", "value": "現在のランタイムを停止します。新しいワークツリーとブランチを作成し、未コミットの変更をそこへ移動してからスレッドを再開します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "현재 런타임이 중지됩니다. 새 워크트리와 브랜치를 만들고 커밋되지 않은 변경 사항을 이동한 후 스레드를 다시 시작합니다." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Bieżące środowisko zostanie zatrzymane. Zostanie utworzone nowe drzewo robocze i gałąź, a niezatwierdzone zmiany zostaną tam przeniesione przed wznowieniem wątku." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "A execução atual será interrompida. Uma nova árvore de trabalho e ramificação serão criadas, e as alterações não confirmadas serão movidas para lá antes de a conversa continuar." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Текущая среда выполнения будет остановлена. Будут созданы новое рабочее дерево и ветка, а незакоммиченные изменения перенесены туда до возобновления ветки." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Geçerli çalışma durdurulacak. Yeni bir çalışma ağacı ve dal oluşturulacak, kaydedilmemiş değişiklikler ileti dizisi sürdürülmeden önce buraya taşınacak." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Поточне середовище виконання буде зупинено. Буде створено нове робоче дерево й гілку, а незафіксовані зміни перенесено туди до відновлення гілки." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Phiên chạy hiện tại sẽ dừng. Một cây làm việc và nhánh mới sẽ được tạo, rồi các thay đổi chưa commit sẽ được chuyển sang đó trước khi luồng tiếp tục." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前运行时将停止。系统会创建新的工作树和分支，并在恢复线程前将未提交的更改移到其中。" } }
      }
    },
    "thread.lifecycle.moveWorktree.clean.message": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The current runtime will stop. A clean worktree and branch will be created before the thread resumes." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die aktuelle Laufzeit wird beendet. Ein sauberer Worktree und Branch werden erstellt, bevor der Thread fortgesetzt wird." } },
        "es": { "stringUnit": { "state": "translated", "value": "La ejecución actual se detendrá. Se crearán un árbol de trabajo limpio y una rama antes de reanudar el hilo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’exécution actuelle va s’arrêter. Un arbre de travail propre et une branche seront créés avant la reprise du fil." } },
        "ja": { "stringUnit": { "state": "translated", "value": "現在のランタイムを停止します。クリーンなワークツリーとブランチを作成してからスレッドを再開します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "현재 런타임이 중지됩니다. 깨끗한 워크트리와 브랜치를 만든 후 스레드를 다시 시작합니다." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Bieżące środowisko zostanie zatrzymane. Czyste drzewo robocze i gałąź zostaną utworzone przed wznowieniem wątku." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "A execução atual será interrompida. Uma árvore de trabalho limpa e uma ramificação serão criadas antes de a conversa continuar." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Текущая среда выполнения будет остановлена. Перед возобновлением ветки будут созданы чистое рабочее дерево и новая ветка." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Geçerli çalışma durdurulacak. İleti dizisi sürdürülmeden önce temiz bir çalışma ağacı ve dal oluşturulacak." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Поточне середовище виконання буде зупинено. Перед відновленням гілки буде створено чисте робоче дерево й нову гілку." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Phiên chạy hiện tại sẽ dừng. Một cây làm việc sạch và nhánh mới sẽ được tạo trước khi luồng tiếp tục." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前运行时将停止。系统会先创建干净的工作树和分支，再恢复线程。" } }
      }
    },
