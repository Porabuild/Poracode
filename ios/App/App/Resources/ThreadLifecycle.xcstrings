    "thread.lifecycle.failure.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thread action could not be completed. Refresh the list and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
