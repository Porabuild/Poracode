    "thread.status.support.hooks.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Status updates come from the CLI hook plugin." } },
        "de": { "stringUnit": { "state": "translated", "value": "Statusaktualisierungen stammen vom CLI-Hook-Plugin." } },
        "es": { "stringUnit": { "state": "translated", "value": "Las actualizaciones de estado provienen del complemento de hooks de la CLI." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Les mises à jour d’état proviennent du plug-in de hook CLI." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ステータス更新はCLIフックプラグインから取得されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "상태 업데이트는 CLI 후크 플러그인에서 제공됩니다." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Aktualizacje stanu pochodzą z wtyczki hooków CLI." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "As atualizações de status vêm do plugin de hooks da CLI." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Обновления статуса поступают из плагина CLI-хуков." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Durum güncellemeleri CLI kanca eklentisinden gelir." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Оновлення стану надходять із плагіна CLI-хуків." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Cập nhật trạng thái đến từ plugin hook CLI." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "状态更新来自 CLI 钩子插件。" } }
      }
    },
    "thread.status.support.cli.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Status is inferred from terminal output. Install the hook plugin in desktop settings for structured updates." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Status wird aus der Terminalausgabe abgeleitet. Installieren Sie das Hook-Plugin in den Desktop-Einstellungen für strukturierte Aktualisierungen." } },
        "es": { "stringUnit": { "state": "translated", "value": "El estado se infiere de la salida del terminal. Instala el complemento de hooks en los ajustes del escritorio para obtener actualizaciones estructuradas." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’état est déduit de la sortie du terminal. Installez le plug-in de hook dans les réglages du bureau pour obtenir des mises à jour structurées." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ステータスはターミナル出力から推定されます。構造化された更新を利用するには、デスクトップ設定でフックプラグインをインストールしてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "상태는 터미널 출력에서 추론됩니다. 구조화된 업데이트를 받으려면 데스크톱 설정에서 후크 플러그인을 설치하세요." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Stan jest określany na podstawie wyjścia terminala. Aby otrzymywać strukturalne aktualizacje, zainstaluj wtyczkę hooków w ustawieniach komputera." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O status é inferido pela saída do terminal. Instale o plugin de hooks nas configurações do desktop para receber atualizações estruturadas." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Статус определяется по выводу терминала. Установите плагин хуков в настройках десктопа для структурированных обновлений." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Durum terminal çıktısından belirlenir. Yapılandırılmış güncellemeler için masaüstü ayarlarından kanca eklentisini yükleyin." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Стан визначається з виводу термінала. Установіть плагін хуків у налаштуваннях комп’ютера для структурованих оновлень." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Trạng thái được suy ra từ đầu ra terminal. Hãy cài plugin hook trong phần cài đặt máy tính để nhận cập nhật có cấu trúc." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "状态根据终端输出推断。请在桌面端设置中安装钩子插件，以获得结构化更新。" } }
      }
    },
    "thread.status.support.acp.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Status is provided by the agent control protocol (ACP)." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Status wird vom Agent Control Protocol (ACP) bereitgestellt." } },
        "es": { "stringUnit": { "state": "translated", "value": "El estado lo proporciona el protocolo de control de agentes (ACP)." } },
        "fr": { "stringUnit": { "state": "translated", "value": "L’état est fourni par le protocole de contrôle des agents (ACP)." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ステータスはエージェント制御プロトコル（ACP）から提供されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "상태는 에이전트 제어 프로토콜(ACP)에서 제공됩니다." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Stan jest dostarczany przez protokół sterowania agentem (ACP)." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O status é fornecido pelo protocolo de controle de agentes (ACP)." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Статус предоставляется протоколом управления агентом (ACP)." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Durum, aracı kontrol protokolü (ACP) tarafından sağlanır." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Стан надається протоколом керування агентом (ACP)." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Trạng thái được cung cấp bởi giao thức điều khiển tác nhân (ACP)." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "状态由智能体控制协议（ACP）提供。" } }
      }
    },
    "thread.status.support.pending.description": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Support mode appears once the session connects." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Unterstützungsmodus wird angezeigt, sobald die Sitzung verbunden ist." } },
        "es": { "stringUnit": { "state": "translated", "value": "El modo de compatibilidad aparecerá cuando se conecte la sesión." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Le mode de prise en charge apparaît une fois la session connectée." } },
        "ja": { "stringUnit": { "state": "translated", "value": "セッションに接続するとサポートモードが表示されます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "세션이 연결되면 지원 모드가 표시됩니다." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Tryb obsługi pojawi się po połączeniu sesji." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O modo de suporte aparece quando a sessão se conecta." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Режим поддержки появится после подключения сеанса." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Destek modu oturum bağlandıktan sonra görünür." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Режим підтримки з’явиться після підключення сеансу." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Chế độ hỗ trợ sẽ xuất hiện sau khi phiên kết nối." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "会话连接后将显示支持模式。" } }
      }
    },
