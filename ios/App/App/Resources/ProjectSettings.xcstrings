    "projectSettings.worktrees.copy.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitignored files to copy from the main project into each new worktree. Gitignore-style patterns, one per line (e.g., .env.*)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitignorierte Dateien zum Kopieren aus dem Hauptprojekt in jeden neuen Arbeitsbaum. Muster im Gitignore-Stil, eines pro Zeile (z. B. .env.*)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos ignorados por Git para copiar del proyecto principal a cada nuevo worktree. Patrones estilo gitignore, uno por línea (p. ej., .env.*)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers Gitignorés à copier du projet principal dans chaque nouvel arbre de travail. Modèles de style Gitignore, un par ligne (par exemple, .env.*)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン プロジェクトから各新しいワークツリーにコピーする、Gitignored ファイル。 Gitignore スタイルのパターン、1 行に 1 つ (例: .env.*)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 프로젝트에서 각각의 새 작업 트리로 복사할 Gitignored 파일입니다. Gitignore 스타일 패턴, 한 줄에 하나씩(예: .env.*)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki ignorowane przez Git do skopiowania z głównego projektu do każdego nowego drzewa roboczego. Wzorce w stylu Gitignore, po jednym w wierszu (np. .env.*)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos gitignorados para copiar do projeto principal para cada nova árvore de trabalho. Padrões estilo Gitignore, um por linha (por exemplo, .env.*)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игнорируемые Git файлы для копирования из основного проекта в каждый новый worktree. Шаблоны в стиле gitignore, по одному на строку (напр., .env.*)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana projeden her yeni çalışma ağacına kopyalanacak Git yok sayılan dosyalar. Gitignore tarzı desenler, her satıra bir tane (ör. .env.*)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ігноровані Git файли для копіювання з основного проєкту до кожного нового worktree. Шаблони у стилі gitignore, по одному на рядок (напр., .env.*)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp được Gitignored để sao chép từ dự án chính vào từng cây làm việc mới. Các mẫu kiểu Gitignore, mỗi mẫu một dòng (ví dụ: .env.*)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitignored 文件从主项目复制到每个新工作树中。 Gitignore 风格的模式，每行一个（例如 .env.*）。"
          }
        }
      }
    },
