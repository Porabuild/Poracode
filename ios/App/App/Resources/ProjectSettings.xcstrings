    "projectSettings.search.exclude.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files matching these globs are hidden from the @file mention search."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die mit diesen Globs übereinstimmen, werden bei der @file-Erwähnungssuche ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que coinciden con estos globs se ocultan de la búsqueda de menciones @file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers correspondant à ces globs sont masqués dans la recherche de mention @file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのグロブに一致するファイルは、@file メンション検索から非表示になります。"
