    "projectSettings.worktrees.location.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override where this project's worktrees are created. Applies to worktrees created from now on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt abweichend fest, wo die Worktrees dieses Projekts erstellt werden. Gilt für ab jetzt erstellte Worktrees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula dónde se crean los worktrees de este proyecto. Se aplica a los worktrees creados a partir de ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez l'emplacement de création des arbres de travail de ce projet. S'applique aux arbres de travail créés à partir de maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトのワークツリーが作成される場所をオーバーライドします。これ以降に作成されるワークツリーに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트의 작업 트리가 생성되는 위치를 재정의합니다. 지금부터 생성되는 작업 트리에 적용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp miejsce tworzenia drzew roboczych tego projektu. Dotyczy drzew roboczych tworzonych od teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui onde as árvores de trabalho deste projeto são criadas. Aplica-se às árvores de trabalho criadas a partir de agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределить, где создаются worktree этого проекта. Применяется к worktree, создаваемым с этого момента."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu projenin çalışma ağaçlarının nerede oluşturulacağını geçersiz kılın. Bundan sonra oluşturulan çalışma ağaçları için geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевизначте, де створюються worktree цього проєкту. Застосовується до worktree, створених відтепер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi đè nơi tạo các cây làm việc của dự án này. Áp dụng cho các cây làm việc được tạo từ giờ trở đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖此项目工作树的创建位置。适用于从现在起创建的工作树。"
          }
        }
      }
    },
