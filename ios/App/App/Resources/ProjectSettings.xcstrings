        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki pasujące do tych globów są ukryte przed wyszukiwaniem wzmianek @file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos que correspondem a esses globs ficam ocultos na pesquisa de menção @file."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, соответствующие этим glob-шаблонам, скрыты из поиска упоминаний @file."
