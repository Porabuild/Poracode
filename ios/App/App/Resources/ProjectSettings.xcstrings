    "projectSettings.mcp.error.configuration": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Complete the server configuration with valid values."}},"de":{"stringUnit":{"state":"translated","value":"Vervollständige die Serverkonfiguration mit gültigen Werten."}},"es":{"stringUnit":{"state":"translated","value":"Completa la configuración del servidor con valores válidos."}},"fr":{"stringUnit":{"state":"translated","value":"Complétez la configuration du serveur avec des valeurs valides."}},"ja":{"stringUnit":{"state":"translated","value":"有効な値でサーバー設定を完了してください。"}},"ko":{"stringUnit":{"state":"translated","value":"올바른 값으로 서버 구성을 완료하세요."}},"pl":{"stringUnit":{"state":"translated","value":"Uzupełnij konfigurację serwera prawidłowymi wartościami."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conclua a configuração do servidor com valores válidos."}},"ru":{"stringUnit":{"state":"translated","value":"Заполните конфигурацию сервера допустимыми значениями."}},"tr":{"stringUnit":{"state":"translated","value":"Sunucu yapılandırmasını geçerli değerlerle tamamlayın."}},"uk":{"stringUnit":{"state":"translated","value":"Заповніть конфігурацію сервера припустимими значеннями."}},"vi":{"stringUnit":{"state":"translated","value":"Hoàn tất cấu hình máy chủ bằng các giá trị hợp lệ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用有效值完成服务器配置。"}}}},
