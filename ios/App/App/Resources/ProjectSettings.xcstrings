    "projectSettings.general.folder.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository location on disk. Update it if you moved the folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherort des Repositorys auf der Festplatte. Aktualisieren Sie ihn, wenn Sie den Ordner verschoben haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación del repositorio en el disco. Actualízala si moviste la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement du dépôt sur le disque. Mettez-le à jour si vous avez déplacé le dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上のリポジトリの場所。フォルダーを移動した場合は更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크에 있는 저장소 위치입니다. 폴더를 옮겼다면 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja repozytorium na dysku. Zaktualizuj ją, jeśli przeniesiono folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização do repositório no disco. Atualize-a se você moveu a pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположение репозитория на диске. Обновите его, если вы переместили папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deponun diskteki konumu. Klasörü taşıdıysanız güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташування репозиторію на диску. Оновіть його, якщо ви перемістили папку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí của kho lưu trữ trên đĩa. Hãy cập nhật nếu bạn đã di chuyển thư mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储库在磁盘上的位置。如果您移动了该文件夹，请更新此位置。"
          }
        }
      }
    },
