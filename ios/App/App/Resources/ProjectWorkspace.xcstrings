    "workspace.content.truncated": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ersten 10.000 Diff-Zeilen werden angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the first 10,000 diff lines are shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las primeras 10.000 líneas de diferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les 10 000 premières lignes de différences sont affichées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分の先頭 10,000 行のみ表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차이의 처음 10,000줄만 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlono tylko pierwsze 10 000 wierszy różnic."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as primeiras 10.000 linhas de diferenças são exibidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только первые 10 000 строк различий."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ilk 10.000 fark satırı gösteriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано лише перші 10 000 рядків відмінностей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hiển thị 10.000 dòng khác biệt đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示前 10,000 行差异。"
          }
        }
      }
    },
    "workspace.error.denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung hat keine Berechtigung für diese Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session does not have permission for that action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión no tiene permiso para esa acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session n’est pas autorisée à effectuer cette action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションには、その操作を行う権限がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에는 해당 작업에 대한 권한이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sesja nie ma uprawnień do tej czynności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão não tem permissão para essa ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого сеанса нет разрешения на данное действие."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumun söz konusu işlem için izni yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сеанс не має дозволу на цю дію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên này không có quyền thực hiện thao tác đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话无权执行该操作。"
          }
        }
      }
    },
    "workspace.error.expired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopple den Desktop erneut, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with the desktop again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a vincular el escritorio para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez de nouveau l’ordinateur pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するにはデスクトップを再度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 데스크톱을 다시 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparuj komputer ponownie, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe o computador novamente para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, выполните сопряжение с компьютером заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için masaüstünü yeniden eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, знову сполучіть комп’ютер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi lại với máy tính để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新与桌面设备配对以继续。"
          }
        }
      }
    },
    "workspace.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Desktop konnte diese Arbeitsbereichsanfrage nicht abschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop could not complete this workspace request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escritorio no pudo completar esta solicitud del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur n’a pas pu terminer cette demande d’espace de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップはこのワークスペース要求を完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱에서 이 작업 공간 요청을 완료하지 못했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer nie mógł ukończyć tego żądania obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não conseguiu concluir esta solicitação do espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеру не удалось выполнить этот запрос рабочей области."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü bu çalışma alanı isteğini tamamlayamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комп’ютер не зміг виконати цей запит робочої області."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính không thể hoàn tất yêu cầu không gian làm việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面设备无法完成此工作区请求。"
          }
        }
      }
    },
