          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego pliku nie można edytować jako tekstu na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não pode ser editado como texto neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл нельзя редактировать как текст на данном устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bu cihazda metin olarak düzenlenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
