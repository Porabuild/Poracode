    "workspace.state.connecting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die Desktop-Sitzung vollständig geladen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the desktop session to finish loading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine de cargarse la sesión del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin du chargement de la session de l’ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップセッションの読み込みが完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱 세션 로드가 끝날 때까지 기다리세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie ładowania sesji komputera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde o carregamento da sessão do computador terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подождите, пока загрузится сеанс компьютера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü oturumunun yüklenmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачекайте, доки завантажиться сеанс комп’ютера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chờ phiên trên máy tính tải xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待桌面会话加载完成。"
          }
        }
      }
    },
