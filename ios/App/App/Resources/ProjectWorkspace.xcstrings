    },
    "workspace.file.conflict.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gespeichert werden. Sie wurde möglicherweise auf dem Desktop geändert; lade sie vor einem neuen Versuch neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be saved. It may have changed on the desktop; reload it before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el archivo. Puede haber cambiado en el escritorio; vuelve a cargarlo antes de reintentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le fichier. Il a peut-être changé sur l’ordinateur ; rechargez-le avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを保存できませんでした。デスクトップ側で変更された可能性があります。再試行する前に再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 저장할 수 없습니다. 데스크톱에서 변경되었을 수 있으므로 다시 시도하기 전에 새로 로드하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać pliku. Mógł zostać zmieniony na komputerze; wczytaj go ponownie przed kolejną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o arquivo. Ele pode ter sido alterado no computador; recarregue antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить файл. Возможно, он изменился на компьютере; перезагрузите его перед повторной попыткой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kaydedilemedi. Masaüstünde değişmiş olabilir; yeniden denemeden önce dosyayı yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти файл. Можливо, його змінено на комп’ютері; перезавантажте його перед повторною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu tệp. Tệp có thể đã thay đổi trên máy tính; hãy tải lại trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存文件。它可能已在桌面设备上更改；请先重新加载再重试。"
          }
        }
      }
    },
