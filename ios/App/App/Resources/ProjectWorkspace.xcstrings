    "workspace.state.selectionChanged": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Projekt oder der Desktop hat sich geändert. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected project or desktop changed. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto o escritorio seleccionado cambió. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet ou l’ordinateur sélectionné a changé. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したプロジェクトまたはデスクトップが変更されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 프로젝트 또는 데스크톱이 변경되었습니다. 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany projekt lub komputer uległ zmianie. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto ou computador selecionado mudou. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный проект или компьютер изменился. Повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili proje veya masaüstü değişti. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний проєкт або комп’ютер змінився. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự án hoặc máy tính đã chọn đã thay đổi. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目或桌面设备已更改。请重试。"
          }
        }
      }
    },
