    "workspace.state.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien und Git sind nicht verfügbar, solange der Desktop offline ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files and Git are unavailable while the desktop is offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos y Git no están disponibles mientras el escritorio esté sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers et Git sont indisponibles lorsque l’ordinateur est hors ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップがオフラインの間は、ファイルと Git を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱이 오프라인인 동안 파일과 Git을 사용할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki i Git są niedostępne, gdy komputer jest offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos e Git ficam indisponíveis enquanto o computador está offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы и Git недоступны, пока компьютер не в сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü çevrimdışıyken dosyalar ve Git kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли та Git недоступні, поки комп’ютер не в мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp và Git không khả dụng khi máy tính đang ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面设备离线时无法使用文件和 Git。"
          }
        }
      }
    },
