    "workspace.state.permission": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung kann keine Projektdateien lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session cannot read project files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión no puede leer los archivos del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session ne peut pas lire les fichiers du projet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションではプロジェクトファイルを読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에서는 프로젝트 파일을 읽을 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sesja nie może odczytywać plików projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão não pode ler os arquivos do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сеанс не может читать файлы проекта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturum proje dosyalarını okuyamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сеанс не може читати файли проєкту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên này không thể đọc các tệp của dự án."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话无法读取项目文件。"
          }
        }
      }
    },
