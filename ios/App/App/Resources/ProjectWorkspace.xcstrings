            "state": "translated",
            "value": "Diese Datei kann auf diesem Gerät nicht als Text bearbeitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be edited as text on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede editar como texto en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
