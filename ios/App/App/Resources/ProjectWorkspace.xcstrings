    "workspace.state.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Desktop aus, um dieses Projekt zu durchsuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a desktop to browse this project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un escritorio para explorar este proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un ordinateur pour parcourir ce projet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトを参照するデスクトップを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트를 탐색할 데스크톱을 선택하세요."
          }
        },
        "pl": {
