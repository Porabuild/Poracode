    "workspace.git.select.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine vorgemerkte oder nicht vorgemerkte Datei aus, um ihren Diff zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a staged or unstaged file to inspect its diff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo preparado o sin preparar para examinar sus diferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier indexé ou non indexé pour examiner ses différences."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分を確認するステージ済みまたは未ステージのファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차이를 확인할 스테이징된 파일 또는 스테이징되지 않은 파일을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz przygotowany lub nieprzygotowany plik, aby sprawdzić jego różnice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo preparado ou não preparado para inspecionar as diferenças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите подготовленный или неподготовленный файл, чтобы изучить различия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklarını incelemek için hazırlanmış veya hazırlanmamış bir dosya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть підготовлений або непідготовлений файл, щоб переглянути його відмінності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một tệp đã hoặc chưa chuẩn bị để xem phần khác biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已暂存或未暂存的文件以检查其差异。"
          }
        }
      }
    },
