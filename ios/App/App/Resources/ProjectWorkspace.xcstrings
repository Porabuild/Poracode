            "state": "translated",
            "value": "El escritorio no pudo completar esta solicitud del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur n’a pas pu terminer cette demande d’espace de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップはこのワークスペース要求を完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱에서 이 작업 공간 요청을 완료하지 못했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer nie mógł ukończyć tego żądania obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não conseguiu concluir esta solicitação do espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютеру не удалось выполнить этот запрос рабочей области."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü bu çalışma alanı isteğini tamamlayamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комп’ютер не зміг виконати цей запит робочої області."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính không thể hoàn tất yêu cầu không gian làm việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面设备无法完成此工作区请求。"
          }
        }
      }
    },
    "workspace.error.uncertain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde beendet, bevor der Desktop das Speichern bestätigt hat. Lade die Datei vor einer weiteren Änderung neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection ended before the desktop confirmed the save. Reload before making another change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión terminó antes de que el escritorio confirmara el guardado. Vuelve a cargar antes de hacer otro cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s’est interrompue avant la confirmation de l’enregistrement. Rechargez le fichier avant toute autre modification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップが保存を確認する前に接続が終了しました。別の変更を行う前に再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱이 저장을 확인하기 전에 연결이 종료되었습니다. 다른 변경을 하기 전에 다시 로드하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie zostało zakończone przed potwierdzeniem zapisu przez komputer. Wczytaj plik ponownie przed następną zmianą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão terminou antes da confirmação do salvamento pelo computador. Recarregue antes de fazer outra alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервалось до подтверждения сохранения компьютером. Перезагрузите файл перед следующим изменением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü kaydı onaylamadan bağlantı sona erdi. Başka bir değişiklik yapmadan önce yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднання завершилося до підтвердження збереження комп’ютером. Перезавантажте файл перед наступною зміною."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đã kết thúc trước khi máy tính xác nhận lưu. Hãy tải lại trước khi thực hiện thay đổi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面设备确认保存前连接已结束。请先重新加载再进行其他更改。"
          }
        }
      }
    },
