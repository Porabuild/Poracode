          "stringUnit": {
            "state": "translated",
            "value": "Scan the pairing code shown in Remote Access on your desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie den Kopplungscode, der im Remotezugriff auf dem Desktop angezeigt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código de emparejamiento que aparece en Acceso Remoto en el escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code d'association affiché dans l'accès distant du bureau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップのリモートアクセスに表示されるペアリングコードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱 원격 액세스에 표시된 페어링 코드를 스캔하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj kod parowania wyświetlany w dostępie zdalnym na pulpicie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código de emparelhamento exibido no Acesso Remoto do desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте код сопряжения, показанный в удалённом доступе на компьютере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstündeki Uzaktan Erişim'de görünen eşleme kodunu tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відскануйте код спарювання, показаний у віддаленому доступі на комп'ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã ghép đôi hiển thị trong Truy cập Từ xa trên máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描桌面端远程访问中显示的配对码。"
          }
        }
      }
    },
    "onboarding.subtitle.protocolIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app cannot talk to the paired desktop. Update Poracode on both devices to the same version, then Disconnect and re-pair."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App kann nicht mit dem gekoppelten Desktop kommunizieren. Aktualisieren Sie Poracode auf beiden Geräten auf dieselbe Version, trennen Sie die Verbindung und koppeln Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no puede comunicarse con el escritorio emparejado. Actualiza Poracode en ambos dispositivos a la misma versión, luego Desconecta y vuelve a emparejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app ne peut pas communiquer avec le bureau associé. Mettez à jour Poracode sur les deux appareils vers la même version, déconnectez-vous et reassociez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはペアリング済みのデスクトップと通信できません。両方のデバイスでPoracodeを同じバージョンにアップデートし、切断して再ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 페어링된 데스크톱과 통신할 수 없습니다. 두 기기에서 Poracode를 같은 버전으로 업데이트한 후 연결을 끊고 다시 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie może komunikować się z sparowanym komputerem. Zaktualizuj Poracode na obu urządzeniach do tej samej wersji, rozłącz i sparuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não consegue se comunicar com o desktop emparelhado. Atualize o Poracode em ambos os dispositivos para a mesma versão, desconecte e emparelhe novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не может связаться со спаренным компьютером. Обновите Poracode на обоих устройствах до одной версии, затем отключитесь и выполните повторное сопряжение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama eşlenmiş masaüstüyle iletişim kuramıyor. Poracode'u her iki cihazda da aynı sürüme güncelleyin, Bağlantıyı Kesin ve yeniden eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця програма не може спілкуватися зі спарованим комп'ютером. Оновіть Poracode на обох пристроях до однієї версії, відключіться та виконайте повторне спарювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này không thể giao tiếp với máy tính đã ghép đôi. Hãy cập nhật Poracode trên cả hai thiết bị lên cùng một phiên bản, ngắt kết nối và ghép đôi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用无法与已配对的桌面通信。请将两台设备上的 Poracode 更新到相同版本，然后断开连接并重新配对。"
          }
        }
      }
    },
    "onboarding.subtitle.storeInconsistent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored credentials on this device are inconsistent or unreadable. Disconnect to clear them, then pair again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Anmeldedaten auf diesem Gerät sind inkonsistent oder nicht lesbar. Trennen Sie die Verbindung, um sie zu löschen, und koppeln Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales almacenadas en este dispositivo son incoherentes o ilegibles. Desconecta para borrarlas y vuelve a emparejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants stockés sur cet appareil sont incohérents ou illisibles. Déconnectez-vous pour les effacer, puis réassociez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されている認証情報に不整合があるか、読み取れません。切断して消去し、再ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 자격 증명이 일관되지 않거나 읽을 수 없습니다. 연결을 끊고 지운 후 다시 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane poświadczenia na tym urządzeniu są niespójne lub nieczytelne. Rozłącz, aby je wyczyścić, i sparuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais armazenadas neste dispositivo são inconsistentes ou ilegíveis. Desconecte para limpá-las e emparelhe novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые учётные данные на этом устройстве противоречивы или нечитаемы. Отключитесь, чтобы очистить их, и выполните повторное сопряжение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda depolanan kimlik bilgileri tutarsız veya okunamıyor. Temizlemek için bağlantıyı kesin ve yeniden eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені облікові дані на цьому пристрої є неузгодженими або нечитабельними. Відключіться, щоб очистити їх, і виконайте повторне спарювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin xác thực được lưu trữ trên thiết bị này không nhất quán hoặc không thể đọc được. Ngắt kết nối để xóa chúng, sau đó ghép đôi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上存储的凭据不一致或无法读取。断开连接以清除它们，然后重新配对。"
          }
        }
      }
    },
