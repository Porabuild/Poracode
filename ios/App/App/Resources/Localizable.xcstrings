    "onboarding.scan.denied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode needs the camera to read the pairing code. Turn it on in iOS Settings, or pair with a link instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode benötigt die Kamera, um den Kopplungscode zu lesen. Aktivieren Sie sie in den iOS-Einstellungen oder koppeln Sie stattdessen per Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode necesita la cámara para leer el código de emparejamiento. Actívala en Ajustes de iOS o empareja con un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode a besoin de l'appareil photo pour lire le code d'association. Activez-le dans les Réglages iOS ou associez avec un lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードを読み取るにはカメラが必要です。iOS の設定でオンにするか、リンクでペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드를 읽으려면 카메라가 필요합니다. iOS 설정에서 켜거나 링크로 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode potrzebuje kamery, aby odczytać kod parowania. Włącz ją w Ustawieniach iOS albo sparuj za pomocą łącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Poracode precisa da câmera para ler o código de emparelhamento. Ative-a nos Ajustes do iOS ou emparelhe com um link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode нужна камера, чтобы прочитать код сопряжения. Включите её в настройках iOS или выполните сопряжение по ссылке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode, eşleme kodunu okumak için kameraya ihtiyaç duyar. iOS Ayarları'ndan açın ya da bağlantıyla eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode потрібна камера, щоб прочитати код спарювання. Увімкніть її в налаштуваннях iOS або виконайте спарювання за посиланням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode cần camera để đọc mã ghép đôi. Hãy bật trong Cài đặt iOS, hoặc ghép đôi bằng liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode 需要使用相机读取配对码。请在 iOS 设置中开启，或改用配对链接。"
          }
        }
      }
    },
