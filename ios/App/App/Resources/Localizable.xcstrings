    "onboarding.banner.protocolIncompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The paired desktop is running a different remote protocol. Credentials stay on this device until you disconnect or re-pair with a compatible server. Snapshot and live connection are paused."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gekoppelte Desktop verwendet ein anderes Remote-Protokoll. Anmeldedaten bleiben auf diesem Gerät, bis Sie die Verbindung trennen oder mit einem kompatiblen Server neu koppeln. Schnappschuss und Live-Verbindung sind pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escritorio emparejado ejecuta un protocolo remoto diferente. Las credenciales permanecen en este dispositivo hasta que te desconectes o vuelvas a emparejar con un servidor compatible. La instantánea y la conexión en vivo están en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bureau associé utilise un protocole distant différent. Les identifiants restent sur cet appareil jusqu'à ce que vous vous déconnectiez ou réassociiez avec un serveur compatible. L'instantané et la connexion en direct sont en pause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデスクトップが異なるリモートプロトコルを実行しています。認証情報は切断するか互換性のあるサーバーと再ペアリングするまでこのデバイスに残ります。スナップショットとライブ接続は一時停止中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 데스크톱이 다른 원격 프로토콜을 실행 중입니다. 연결을 끊거나 호환되는 서버와 다시 페어링할 때까지 자격 증명이 이 기기에 유지됩니다. 스냅샷 및 실시간 연결이 일시 중지되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparowany pulpit używa innego protokołu zdalnego. Poświadczenia pozostają na tym urządzeniu, dopóki nie rozłączysz się lub nie sparujesz ponownie z kompatybilnym serwerem. Migawka i połączenie na żywo są wstrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desktop emparelhado está executando um protocolo remoto diferente. As credenciais permanecem neste dispositivo até você desconectar ou re-emparelhar com um servidor compatível. O snapshot e a conexão ao vivo estão pausados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спаренный компьютер использует другой удалённый протокол. Учётные данные остаются на этом устройстве, пока вы не отключитесь или не выполните повторное сопряжение с совместимым сервером. Снимок и активное подключение приостановлены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşlenmiş masaüstü farklı bir uzak protokol çalıştırıyor. Bağlantıyı kesene veya uyumlu bir sunucuyla yeniden eşleyene kadar kimlik bilgileri bu cihazda kalır. Anlık görüntü ve canlı bağlantı duraklatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спарений комп'ютер використовує інший віддалений протокол. Облікові дані залишаються на цьому пристрої, доки ви не відключитеся або не виконаєте повторне спарювання з сумісним сервером. Знімок та пряме з'єднання призупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính đã ghép đôi đang chạy một giao thức từ xa khác. Thông tin xác thực vẫn còn trên thiết bị này cho đến khi bạn ngắt kết nối hoặc ghép đôi lại với máy chủ tương thích. Ảnh chụp và kết nối trực tiếp đã bị tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的桌面正在运行不同的远程协议。凭据将保留在此设备上，直到您断开连接或与兼容的服务器重新配对。快照和实时连接已暂停。"
          }
        }
      }
    },
    "onboarding.banner.protocolIncompatible.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incompatible server protocol. Update both apps or disconnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkompatibles Serverprotokoll. Aktualisieren Sie beide Apps oder trennen Sie die Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolo de servidor incompatible. Actualiza ambas apps o desconecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocole serveur incompatible. Mettez à jour les deux apps ou déconnectez-vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性のないサーバープロトコル。両方のアプリをアップデートするか切断してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환되지 않는 서버 프로토콜. 두 앱을 모두 업데이트하거나 연결을 끊으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekompatybilny protokół serwera. Zaktualizuj obie aplikacje lub rozłącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolo de servidor incompatível. Atualize ambos os apps ou desconecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несовместимый протокол сервера. Обновите оба приложения или отключитесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyumsuz sunucu protokolü. Her iki uygulamayı da güncelleyin veya bağlantıyı kesin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Несумісний протокол сервера. Оновіть обидві програми або відключіться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao thức máy chủ không tương thích. Hãy cập nhật cả hai ứng dụng hoặc ngắt kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不兼容的服务器协议。更新两个应用或断开连接。"
          }
        }
      }
    },
    "onboarding.banner.sessionExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your remote session expired. Credentials are still on this device — re-pair with a new link, wait for automatic retry, or disconnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Remote-Sitzung ist abgelaufen. Anmeldedaten sind noch auf diesem Gerät — koppeln Sie erneut mit einem neuen Link, warten Sie auf automatischen Wiederholungsversuch oder trennen Sie die Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión remota expiró. Las credenciales siguen en este dispositivo — vuelve a emparejar con un nuevo enlace, espera el reintento automático o desconecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session à distance a expiré. Les identifiants sont toujours sur cet appareil — reassociez avec un nouveau lien, attendez la tentative automatique ou déconnectez-vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションの有効期限が切れました。認証情報はこのデバイスに残っています — 新しいリンクで再ペアリングするか、自動再試行を待つか、切断してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 세션이 만료되었습니다. 자격 증명은 이 기기에 남아 있습니다 — 새 링크로 다시 페어링하거나, 자동 재시도를 기다리거나, 연결을 끊으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja zdalna sesja wygasła. Poświadczenia są nadal na tym urządzeniu — sparuj ponownie z nowym łączem, poczekaj na automatyczną ponowną próbę lub rozłącz się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão remota expirou. As credenciais ainda estão neste dispositivo — re-emparelhe com um novo link, aguarde a tentativa automática ou desconecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия вашего удалённого сеанса истёк. Учётные данные всё ещё на этом устройстве — выполните повторное сопряжение по новой ссылке, дождитесь автоматической повторной попытки или отключитесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan oturumunuz sona erdi. Kimlik bilgileri hâlâ bu cihazda — yeni bir bağlantıyla yeniden eşleyin, otomatik yeniden denemeyi bekleyin veya bağlantıyı kesin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії вашого віддаленого сеансу закінчився. Облікові дані все ще на цьому пристрої — виконайте повторне спарювання з новим посиланням, зачекайте автоматичного повтору або відключіться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên từ xa của bạn đã hết hạn. Thông tin xác thực vẫn còn trên thiết bị này — hãy ghép đôi lại bằng liên kết mới, chờ thử lại tự động hoặc ngắt kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的远程会话已过期。凭据仍在此设备上 — 使用新链接重新配对、等待自动重试或断开连接。"
          }
        }
      }
    },
    "onboarding.banner.sessionExpired.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expired. Re-pair or disconnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung abgelaufen. Erneut koppeln oder trennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión expirada. Re-empareja o desconecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session expirée. Réassociez ou déconnectez-vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限切れ。再ペアリングするか切断してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 만료. 다시 페어링하거나 연결을 끊으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja wygasła. Sparuj ponownie lub rozłącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão expirada. Re-emparelhe ou desconecte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок сеанса истёк. Выполните повторное сопряжение или отключитесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum süresi doldu. Yeniden eşleyin veya bağlantıyı kesin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс закінчився. Виконайте повторне спарювання або відключіться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đã hết hạn. Ghép đôi lại hoặc ngắt kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已过期。重新配对或断开连接。"
          }
        }
      }
    },
    "onboarding.banner.storeInconsistent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local credentials are inconsistent or unreadable. Stored material is left untouched until you Disconnect. Disconnect clears this device so you can pair again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Anmeldedaten sind inkonsistent oder nicht lesbar. Gespeicherte Daten bleiben unberührt, bis Sie die Verbindung trennen. Trennen löscht dieses Gerät, damit Sie erneut koppeln können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales locales son incoherentes o ilegibles. El material almacenado no se toca hasta que Desconectes. Desconectar limpia este dispositivo para que puedas emparejar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants locaux sont incohérents ou illisibles. Les données stockées restent intactes jusqu'à ce que vous vous déconnectiez. La déconnexion efface cet appareil pour vous permettre de réassocier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの認証情報に不整合があるか、読み取れません。保存されたデータは切断するまで変更されません。切断するとこのデバイスがクリアされ、再ペアリングできるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 자격 증명이 일관되지 않거나 읽을 수 없습니다. 연결을 끊을 때까지 저장된 자료는 그대로 유지됩니다. 연결을 끊으면 이 기기가 지워져 다시 페어링할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne poświadczenia są niespójne lub nieczytelne. Przechowywane dane pozostają nietknięte do momentu rozłączenia. Rozłączenie czyści to urządzenie, aby można było sparować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais locais são inconsistentes ou ilegíveis. O material armazenado não é tocado até você Desconectar. Desconectar limpa este dispositivo para que você possa emparelhar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные учётные данные противоречивы или нечитаемы. Сохранённый материал остаётся нетронутым до отключения. Отключение очищает это устройство, чтобы вы могли выполнить повторное сопряжение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kimlik bilgileri tutarsız veya okunamıyor. Bağlantıyı Kesene kadar depolanan verilere dokunulmaz. Bağlantıyı Kesmek bu cihazı temizler, böylece yeniden eşleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальні облікові дані є неузгодженими або нечитабельними. Збережений матеріал залишається недоторканим, доки ви не Відключитеся. Відключення очищає цей пристрій, щоб ви могли виконати повторне спарювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin xác thực cục bộ không nhất quán hoặc không thể đọc được. Dữ liệu được lưu trữ sẽ không bị ảnh hưởng cho đến khi bạn Ngắt kết nối. Ngắt kết nối sẽ xóa thiết bị này để bạn có thể ghép đôi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地凭据不一致或无法读取。在您断开连接之前，存储的资料将保持不变。断开连接将清除此设备，以便您可以重新配对。"
          }
        }
      }
    },
    "onboarding.banner.storeInconsistent.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local credentials inconsistent. Disconnect to clear, then pair again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Anmeldedaten inkonsistent. Trennen Sie die Verbindung zum Löschen und koppeln Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciales locales incoherentes. Desconecta para borrar y vuelve a emparejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants locaux incohérents. Déconnectez-vous pour effacer, puis réassociez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの認証情報に不整合があります。切断して消去し、再ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 자격 증명이 일관되지 않습니다. 연결을 끊고 지운 후 다시 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne poświadczenia niespójne. Rozłącz, aby wyczyścić, i sparuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciais locais inconsistentes. Desconecte para limpar e emparelhe novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные учётные данные противоречивы. Отключитесь, чтобы очистить, и выполните повторное сопряжение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kimlik bilgileri tutarsız. Temizlemek için bağlantıyı kesin ve yeniden eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальні облікові дані неузгоджені. Відключіться, щоб очистити, і виконайте повторне спарювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin xác thực cục bộ không nhất quán. Ngắt kết nối để xóa, sau đó ghép đôi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地凭据不一致。断开连接以清除，然后重新配对。"
          }
        }
      }
    },
    "onboarding.cleartext.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This endpoint uses plain HTTP on a local network address. Prefer HTTPS or Tailscale when possible. iOS allows local-network cleartext via NSAllowsLocalNetworking only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Endpunkt verwendet HTTP auf einer lokalen Netzwerkadresse. Bevorzugen Sie nach Möglichkeit HTTPS oder Tailscale. iOS erlaubt lokales Klartext-Netzwerk nur über NSAllowsLocalNetworking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint usa HTTP en una dirección de red local. Prefiere HTTPS o Tailscale cuando sea posible. iOS solo permite texto claro en red local mediante NSAllowsLocalNetworking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point d'accès utilise HTTP sur une adresse réseau locale. Préférez HTTPS ou Tailscale lorsque c'est possible. iOS autorise le texte clair sur le réseau local via NSAllowsLocalNetworking uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンドポイントはローカルネットワークアドレスでHTTPを使用しています。可能な場合はHTTPSまたはTailscaleを推奨します。iOSではNSAllowsLocalNetworking経由でのみローカルネットワークの平文通信が許可されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔드포인트는 로컬 네트워크 주소에서 HTTP를 사용합니다. 가능하면 HTTPS 또는 Tailscale을 사용하세요. iOS는 NSAllowsLocalNetworking을 통해서만 로컬 네트워크 평문 통신을 허용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten punkt końcowy używa HTTP na lokalnym adresie sieciowym. Preferuj HTTPS lub Tailscale, gdy to możliwe. iOS zezwala na lokalny ruch jawny tylko przez NSAllowsLocalNetworking."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint usa HTTP em um endereço de rede local. Prefira HTTPS ou Tailscale quando possível. O iOS permite texto claro em rede local apenas via NSAllowsLocalNetworking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта конечная точка использует HTTP на локальном сетевом адресе. По возможности используйте HTTPS или Tailscale. iOS разрешает локальный незашифрованный трафик только через NSAllowsLocalNetworking."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uç nokta, yerel ağ adresinde HTTP kullanıyor. Mümkün olduğunda HTTPS veya Tailscale tercih edin. iOS, yerel ağda düz metne yalnızca NSAllowsLocalNetworking ile izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця кінцева точка використовує HTTP на локальній мережевій адресі. По можливості використовуйте HTTPS або Tailscale. iOS дозволяє локальний незашифрований трафік лише через NSAllowsLocalNetworking."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối này sử dụng HTTP trên địa chỉ mạng cục bộ. Ưu tiên HTTPS hoặc Tailscale nếu có thể. iOS chỉ cho phép văn bản rõ trên mạng cục bộ thông qua NSAllowsLocalNetworking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此端点使用本地网络地址上的 HTTP。尽可能使用 HTTPS 或 Tailscale。iOS 仅通过 NSAllowsLocalNetworking 允许本地网络明文。"
          }
        }
      }
    },
    "onboarding.cleartext.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is plain HTTP on a non-loopback host. Traffic is not encrypted. Continue only on a trusted network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist HTTP auf einem Nicht-Loopback-Host. Der Datenverkehr wird nicht verschlüsselt. Nur in einem vertrauenswürdigen Netzwerk fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es HTTP en un host no loopback. El tráfico no está cifrado. Continúa solo en una red de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en HTTP sur un hôte non local. Le trafic n'est pas chiffré. Continuez uniquement sur un réseau de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は非ループバックホスト上のHTTPです。トラフィックは暗号化されません。信頼できるネットワークでのみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 비루프백 호스트의 HTTP입니다. 트래픽이 암호화되지 않습니다. 신뢰할 수 있는 네트워크에서만 계속하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to HTTP na hoście innym niż pętla zwrotna. Ruch nie jest szyfrowany. Kontynuuj tylko w zaufanej sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é HTTP em um host não loopback. O tráfego não é criptografado. Continue somente em uma rede confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — это HTTP на хосте, отличном от локального. Трафик не шифруется. Продолжайте только в доверенной сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, döngüsel olmayan bir ana bilgisayarda HTTP'dir. Trafik şifrelenmez. Yalnızca güvenilir bir ağda devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — це HTTP на хості, відмінному від локального. Трафік не шифрується. Продовжуйте лише в довіреній мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là HTTP trên máy chủ không phải loopback. Lưu lượng không được mã hóa. Chỉ tiếp tục trên mạng đáng tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是非回环主机上的 HTTP。流量未加密。仅在受信任的网络上继续。"
          }
        }
      }
    },
