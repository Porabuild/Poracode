    },
    "onboarding.scan.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not start. Close other apps that may be using it and try again, or pair with a link instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera konnte nicht gestartet werden. Schließen Sie andere Apps, die sie verwenden könnten, und versuchen Sie es erneut — oder koppeln Sie per Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la cámara. Cierra otras apps que puedan estar usándola e inténtalo de nuevo, o empareja con un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer l'appareil photo. Fermez les autres apps qui l'utilisent peut-être et réessayez, ou associez avec un lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを起動できませんでした。カメラを使用している可能性のある他のアプリを閉じて再試行するか、リンクでペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 시작할 수 없습니다. 카메라를 사용 중일 수 있는 다른 앱을 닫고 다시 시도하거나 링크로 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić kamery. Zamknij inne aplikacje, które mogą jej używać, i spróbuj ponownie albo sparuj za pomocą łącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a câmera. Feche outros apps que possam estar usando-a e tente novamente, ou emparelhe com um link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить камеру. Закройте другие приложения, которые могут её использовать, и повторите попытку — или выполните сопряжение по ссылке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera başlatılamadı. Kamerayı kullanıyor olabilecek diğer uygulamaları kapatıp yeniden deneyin ya da bağlantıyla eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити камеру. Закрийте інші програми, які можуть її використовувати, і спробуйте ще раз — або виконайте спарювання за посиланням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khởi động camera. Hãy đóng các ứng dụng khác có thể đang dùng camera rồi thử lại, hoặc ghép đôi bằng liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动相机。请关闭可能正在使用相机的其他应用后重试，或改用配对链接。"
          }
        }
      }
    },
