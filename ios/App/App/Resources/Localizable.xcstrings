    "onboarding.scan.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the pairing code in Settings → Remote Access on your desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie die Kamera auf den Kopplungscode unter Einstellungen → Remotezugriff auf dem Desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara al código de emparejamiento en Configuración → Acceso Remoto del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez l'appareil photo vers le code d'association dans Paramètres → Accès distant du bureau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップの「設定」→「リモートアクセス」に表示されるペアリングコードにカメラを向けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱의 설정 → 원격 액세스에 표시된 페어링 코드에 카메라를 비추세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj kamerę na kod parowania w Ustawienia → Dostęp zdalny na pulpicie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera para o código de emparelhamento em Configurações → Acesso Remoto no desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на код сопряжения в «Настройки» → «Удалённый доступ» на компьютере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı masaüstündeki Ayarlar → Uzaktan Erişim bölümündeki eşleme koduna doğrultun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть камеру на код спарювання в «Налаштування» → «Віддалений доступ» на комп'ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng camera vào mã ghép đôi trong Cài đặt → Truy cập Từ xa trên máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将相机对准桌面端「设置 → 远程访问」中的配对码。"
          }
        }
      }
    },
    "onboarding.scan.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a Poracode pairing code. Keep the Remote Access code in view."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Poracode-Kopplungscode. Halten Sie den Remotezugriff-Code im Bild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese no es un código de emparejamiento de Poracode. Mantén el código de Acceso Remoto a la vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un code d'association Poracode. Gardez le code d'accès distant dans le cadre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは Poracode のペアリングコードではありません。リモートアクセスのコードを画面内に収めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode 페어링 코드가 아닙니다. 원격 액세스 코드를 화면에 유지하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest kod parowania Poracode. Utrzymuj kod dostępu zdalnego w kadrze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse não é um código de emparelhamento do Poracode. Mantenha o código do Acesso Remoto no enquadramento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не код сопряжения Poracode. Держите код удалённого доступа в кадре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir Poracode eşleme kodu değil. Uzaktan Erişim kodunu kadrada tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не код спарювання Poracode. Тримайте код віддаленого доступу в кадрі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây không phải mã ghép đôi Poracode. Hãy giữ mã Truy cập Từ xa trong khung hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Poracode 配对码。请将远程访问的配对码保持在取景框内。"
          }
        }
      }
    },
    "onboarding.scan.noCamera.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no camera Poracode can use — the iOS Simulator included. Paste a pairing link or enter the details manually."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gibt es keine Kamera, die Poracode nutzen kann — auch nicht im iOS-Simulator. Fügen Sie einen Kopplungslink ein oder geben Sie die Daten manuell ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene una cámara que Poracode pueda usar, incluido el Simulador de iOS. Pega un enlace de emparejamiento o introduce los datos manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'a pas d'appareil photo utilisable par Poracode, simulateur iOS compris. Collez un lien d'association ou saisissez les informations manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には Poracode が使用できるカメラがありません（iOS シミュレータを含む）。ペアリングリンクを貼り付けるか、情報を手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 Poracode가 사용할 수 있는 카메라가 없습니다(iOS 시뮬레이터 포함). 페어링 링크를 붙여넣거나 정보를 직접 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma kamery, której Poracode mógłby użyć — dotyczy to także symulatora iOS. Wklej łącze parowania lub wprowadź dane ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem uma câmera que o Poracode possa usar — inclusive o Simulador do iOS. Cole um link de emparelhamento ou insira os dados manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве нет камеры, доступной Poracode, — включая симулятор iOS. Вставьте ссылку для сопряжения или введите данные вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda Poracode'un kullanabileceği bir kamera yok — iOS Simulator dahil. Bir eşleme bağlantısı yapıştırın ya da bilgileri elle girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої немає камери, доступної для Poracode, — включно з симулятором iOS. Вставте посилання для спарювання або введіть дані вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không có camera mà Poracode có thể dùng — bao gồm cả iOS Simulator. Hãy dán liên kết ghép đôi hoặc nhập thông tin thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有 Poracode 可用的相机（包括 iOS 模拟器）。请粘贴配对链接或手动输入信息。"
          }
        }
      }
    },
