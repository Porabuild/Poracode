    "home.compose.defaults.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses this project’s most recent agent and model settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die zuletzt gewählten Agent- und Modelleinstellungen dieses Projekts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los ajustes de agente y modelo más recientes de este proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les derniers réglages d’agent et de modèle de ce projet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトで最近使用したエージェントとモデルの設定を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트에서 가장 최근에 사용한 에이전트 및 모델 설정을 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa ostatnich ustawień agenta i modelu w tym projekcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa as configurações mais recentes de agente e modelo deste projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используются последние настройки агента и модели этого проекта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu projenin en son aracı ve model ayarlarını kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуються останні налаштування агента й моделі цього проєкту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cài đặt tác nhân và mô hình gần nhất của dự án này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此项目最近的智能体和模型设置。"
          }
        }
      }
    },
    "home.compose.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan, ask, build…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen, fragen, entwickeln…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica, pregunta, crea…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifier, demander, créer…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画、質問、作成…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획하고, 묻고, 만들기…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planuj, pytaj, twórz…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje, pergunte, crie…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планируйте, спрашивайте, создавайте…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planla, sor, geliştir…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плануйте, запитуйте, створюйте…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lập kế hoạch, hỏi, xây dựng…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规划、提问、构建…"
          }
        }
      }
    },
    "home.compose.unavailable.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a thread from the desktop first to save launch settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte zuerst einen Thread am Desktop, um Starteinstellungen zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia primero un hilo desde el escritorio para guardar los ajustes de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez d’abord un fil depuis l’ordinateur pour enregistrer les réglages de lancement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動設定を保存するには、先にデスクトップからスレッドを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 설정을 저장하려면 먼저 데스크톱에서 스레드를 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw rozpocznij wątek na komputerze, aby zapisać ustawienia uruchamiania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma thread pelo computador primeiro para salvar as configurações de inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала запустите ветку на компьютере, чтобы сохранить настройки запуска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatma ayarlarını kaydetmek için önce masaüstünden bir iş parçacığı başlatın."
          }
        },
        "uk": {
          "stringUnit": {
