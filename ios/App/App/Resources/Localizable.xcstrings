          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el último cambio haya llegado al escritorio. Actualiza antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière modification a peut-être atteint l’ordinateur. Actualisez avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の変更がデスクトップに届いた可能性があります。再試行する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 변경 사항이 데스크톱에 전달되었을 수 있습니다. 다시 시도하기 전에 새로고침하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnia zmiana mogła dotrzeć do aplikacji komputerowej. Odśwież przed ponowną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última alteração pode ter chegado ao computador. Atualize antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее изменение могло дойти до компьютера. Обновите данные перед повторной попыткой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son değişiklik masaüstüne ulaşmış olabilir. Yeniden denemeden önce yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання зміна могла надійти на комп’ютер. Оновіть дані перед повторною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi gần nhất có thể đã đến ứng dụng máy tính. Hãy làm mới trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次更改可能已送达桌面端。重试前请先刷新。"
          }
        }
      }
    },
