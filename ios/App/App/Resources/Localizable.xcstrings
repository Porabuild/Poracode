    "notifications.hostSwitch.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This notification belongs to a different desktop. Switch to open the thread there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mitteilung gehört zu einem anderen Desktop. Wechseln Sie, um den Thread dort zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta notificación pertenece a otro escritorio. Cambia para abrir el hilo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette notification appartient à un autre bureau. Changez de bureau pour ouvrir le fil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通知は別のデスクトップのものです。切り替えてそのスレッドを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알림은 다른 데스크톱에 속합니다. 전환하여 해당 스레드를 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To powiadomienie należy do innego komputera. Przełącz, aby otworzyć ten wątek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta notificação pertence a outro desktop. Troque para abrir a conversa lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это уведомление относится к другому компьютеру. Переключитесь, чтобы открыть ветку там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bildirim farklı bir masaüstüne ait. İleti dizisini orada açmak için masaüstünü değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це сповіщення належить іншому комп’ютеру. Перемкніться, щоб відкрити гілку там."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo này thuộc về một máy tính khác. Hãy chuyển sang để mở luồng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此通知属于另一个桌面。切换后即可在那里打开该线程。"
          }
        }
      }
    },
