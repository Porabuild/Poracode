    "hosts.add.cleartext.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server uses HTTP. Continue only on a trusted network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet HTTP. Fahren Sie nur in einem vertrauenswürdigen Netzwerk fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa HTTP. Continúa solo en una red de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise HTTP. Continuez uniquement sur un réseau de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはHTTPを使用します。信頼できるネットワークでのみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 HTTP를 사용합니다. 신뢰할 수 있는 네트워크에서만 계속하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer używa HTTP. Kontynuuj tylko w zaufanej sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa HTTP. Continue somente em uma rede confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер использует HTTP. Продолжайте только в доверенной сети."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu HTTP kullanıyor. Yalnızca güvenilir bir ağda devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сервер використовує HTTP. Продовжуйте лише в довіреній мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này dùng HTTP. Chỉ tiếp tục trên mạng đáng tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器使用 HTTP。请仅在可信网络上继续。"
          }
        }
      }
    },
