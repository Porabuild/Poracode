    "hosts.remove.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will forget the desktop and delete its stored credentials. You can pair again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät vergisst den Desktop und löscht seine gespeicherten Zugangsdaten. Sie können ihn später erneut koppeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo olvidará el escritorio y eliminará sus credenciales guardadas. Podrás volver a enlazarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil oubliera le bureau et supprimera ses identifiants enregistrés. Vous pourrez l’associer à nouveau plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからデスクトップと保存済みの認証情報を削除します。後でもう一度ペアリングできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 데스크톱과 저장된 자격 증명을 삭제합니다. 나중에 다시 페어링할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie zapomni komputer i usunie zapisane dane logowania. Później możesz sparować go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo esquecerá o desktop e excluirá as credenciais salvas. Você poderá emparelhá-lo novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство забудет компьютер и удалит сохранённые учётные данные. Позже его можно подключить снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıt masaüstünü unutacak ve kayıtlı kimlik bilgilerini silecek. Daha sonra yeniden eşleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій забуде комп’ютер і видалить збережені облікові дані. Пізніше його можна спарувати знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này sẽ quên máy tính và xóa thông tin đăng nhập đã lưu. Bạn có thể ghép đôi lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备将忘记该桌面并删除已存储的凭据。之后可以重新配对。"
          }
        }
      }
    },
