    "projects.remove.confirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ and permanently delete all of its threads? This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen und alle zugehörigen Threads dauerhaft löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %@ y eliminar permanentemente todos sus hilos? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ et effacer définitivement tous ses fils de discussion ? Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除し、そのすべてのスレッドを完全に削除しますか？この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 제거하고 모든 스레드를 영구적으로 삭제할까요? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %@ i trwale usunąć wszystkie jego wątki? Tego nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@ e excluir permanentemente todos os seus tópicos? Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ и навсегда удалить все его треды? Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öğesini kaldırıp tüm konularını kalıcı olarak silinsin mi? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити %@ і назавжди видалити всі його треди? Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %@ và xóa vĩnh viễn tất cả các luồng của dự án này? Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@ 并永久删除其所有线程？此操作无法撤销。"
          }
        }
      }
    },
