    "rich_chat_terminal_deferred_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive terminal streaming is not available in this native build yet. Open this conversation on the desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktives Terminal-Streaming ist in diesem nativen Build noch nicht verfügbar. Öffne diese Unterhaltung auf dem Desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmisión interactiva del terminal aún no está disponible en esta compilación nativa. Abre esta conversación en el escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La diffusion interactive du terminal n’est pas encore disponible dans cette version native. Ouvrez cette conversation sur l’ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネイティブビルドでは、対話型ターミナルストリーミングをまだ利用できません。デスクトップでこの会話を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네이티브 빌드에서는 대화형 터미널 스트리밍을 아직 사용할 수 없습니다. 데스크톱에서 이 대화를 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktywne przesyłanie strumieniowe terminala nie jest jeszcze dostępne w tej natywnej wersji. Otwórz tę rozmowę w aplikacji komputerowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transmissão interativa do terminal ainda não está disponível nesta compilação nativa. Abra esta conversa no computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интерактивная трансляция терминала пока недоступна в этой нативной сборке. Откройте разговор на компьютере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkileşimli terminal akışı bu yerel sürümde henüz kullanılamıyor. Bu konuşmayı masaüstünde açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інтерактивна трансляція термінала ще недоступна в цій нативній збірці. Відкрийте розмову на комп’ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng truyền phát đầu cuối tương tác chưa có trong bản dựng gốc này. Hãy mở cuộc trò chuyện này trên ứng dụng máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此原生版本暂不支持交互式终端流。请在桌面端打开此对话。"
          }
        }
      }
    },
