    "rich_chat_close_thread_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop stops this thread’s runtime. The transcript stays available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Desktop beendet die Laufzeit dieses Threads. Die Unterhaltung bleibt verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escritorio detiene el entorno de ejecución de este hilo. La conversación seguirá disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bureau arrête l’exécution de ce fil. La conversation reste disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップはこのスレッドのランタイムを停止します。会話は引き続き参照できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱이 이 스레드의 런타임을 중지합니다. 대화 내용은 계속 볼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer zatrzyma środowisko uruchomieniowe tego wątku. Zapis rozmowy pozostanie dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desktop interrompe o runtime desta conversa. O histórico continua disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер остановит среду выполнения этой ветки. Переписка останется доступной."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü, bu ileti dizisinin çalışma zamanını durdurur. Konuşma dökümü erişilebilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комп’ютер зупинить середовище виконання цієї гілки. Розмова залишиться доступною."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính sẽ dừng môi trường chạy của luồng này. Bản ghi cuộc trò chuyện vẫn còn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面端会停止此线程的运行时。对话记录仍可查看。"
          }
        }
      }
    },
