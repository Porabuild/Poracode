    "onboarding.pending.unencryptedWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This endpoint uses plain HTTP on a local network address. Traffic is not encrypted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Endpunkt verwendet HTTP auf einer lokalen Netzwerkadresse. Der Datenverkehr wird nicht verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint usa HTTP en una dirección de red local. El tráfico no está cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point d'accès utilise HTTP sur une adresse réseau locale. Le trafic n'est pas chiffré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンドポイントはローカルネットワークアドレスでHTTPを使用しています。トラフィックは暗号化されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔드포인트는 로컬 네트워크 주소에서 HTTP를 사용합니다. 트래픽이 암호화되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten punkt końcowy używa HTTP na lokalnym adresie sieciowym. Ruch nie jest szyfrowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint usa HTTP em um endereço de rede local. O tráfego não é criptografado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта конечная точка использует HTTP на локальном сетевом адресе. Трафик не шифруется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uç nokta, yerel ağ adresinde HTTP kullanıyor. Trafik şifrelenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця кінцева точка використовує HTTP на локальній мережевій адресі. Трафік не шифрується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối này sử dụng HTTP trên địa chỉ mạng cục bộ. Lưu lượng truy cập không được mã hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此端点使用本地网络地址上的 HTTP。流量未加密。"
          }
        }
      }
    },
