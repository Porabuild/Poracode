    "rich_chat_truncate_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop removes every later item from this thread’s runtime. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Desktop entfernt alle späteren Einträge aus der Laufzeit dieses Threads. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escritorio quita todos los elementos posteriores del entorno de ejecución de este hilo. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bureau retire tous les éléments suivants de l’exécution de ce fil. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップはこのスレッドのランタイムから以降のすべての項目を削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱이 이 스레드 런타임에서 이후의 모든 항목을 제거합니다. 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer usunie wszystkie późniejsze elementy ze środowiska uruchomieniowego tego wątku. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desktop remove todos os itens seguintes do runtime desta conversa. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер удалит все последующие элементы из среды выполнения этой ветки. Отменить это нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü, bu ileti dizisinin çalışma zamanından sonraki tüm ögeleri kaldırır. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комп’ютер вилучить усі подальші елементи із середовища виконання цієї гілки. Скасувати це неможливо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy tính sẽ gỡ mọi mục sau đó khỏi môi trường chạy của luồng này. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面端会从此线程的运行时中移除其后的所有条目。此操作无法撤销。"
          }
        }
      }
    },
    "rich_chat_truncate_confirm_title": {
