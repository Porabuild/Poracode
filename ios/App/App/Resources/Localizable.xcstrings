    "rich_chat_restore_checkpoint_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in the project will be restored to this checkpoint. Later conversation messages are not removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Projektdateien werden auf diesen Prüfpunkt zurückgesetzt. Spätere Nachrichten werden nicht entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del proyecto se restaurarán a este punto de control. Los mensajes posteriores no se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers du projet seront restaurés à ce point de contrôle. Les messages ultérieurs ne seront pas supprimés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのファイルをこのチェックポイントに復元します。後の会話メッセージは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 파일을 이 체크포인트로 복원합니다. 이후 대화 메시지는 삭제되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki w projekcie zostaną przywrócone do tego punktu kontrolnego. Późniejsze wiadomości w rozmowie nie zostaną usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos do projeto serão restaurados para este ponto de controle. As mensagens posteriores não serão removidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы проекта будут восстановлены до этой точки. Последующие сообщения не удалятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projedeki dosyalar bu kontrol noktasına geri yüklenecek. Daha sonraki konuşma mesajları kaldırılmayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли проєкту буде відновлено до цієї точки. Пізніші повідомлення не буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp trong dự án sẽ được khôi phục về điểm kiểm tra này. Những tin nhắn sau đó trong cuộc trò chuyện sẽ không bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目文件将恢复到此检查点。之后的对话消息不会被删除。"
          }
        }
      }
    },
