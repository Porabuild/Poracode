            "state": "translated",
            "value": "Заменить текущее сопряжение?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut eşleme değiştirilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінити поточне спарювання?"
          }
