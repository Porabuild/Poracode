            "value": "点击 + 在桌面端添加文件夹或克隆存储库。"
          }
        }
      }
    },
    "projects.manage.noScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection can view projects but not manage them. Re-pair to enable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung kann Projekte anzeigen, aber nicht verwalten. Kopple erneut, um dies zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión puede ver proyectos, pero no administrarlos. Vuelve a emparejarla para habilitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion peut voir les projets, mais pas les gérer. Associez-la à nouveau pour l’activer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続ではプロジェクトを表示できますが、管理はできません。有効にするには再度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결은 프로젝트를 볼 수 있지만 관리할 수 없습니다. 활성화하려면 다시 페어링하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To połączenie może wyświetlać projekty, ale nie może nimi zarządzać. Sparuj ponownie, aby włączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão pode ver projetos, mas não gerenciá-los. Faça o pareamento novamente para habilitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это подключение может просматривать проекты, но не управлять ими. Выполните сопряжение заново, чтобы включить управление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantı projeleri görüntüleyebilir ancak yönetemez. Etkinleştirmek için yeniden eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це підключення може переглядати проєкти, але не керувати ними. Створіть сполучення заново, щоб увімкнути керування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối này có thể xem dự án nhưng không thể quản lý. Hãy ghép nối lại để bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接可以查看项目，但不能管理项目。请重新配对以启用。"
          }
        }
      }
    },
