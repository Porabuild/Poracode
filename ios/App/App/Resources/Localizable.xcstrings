    "projects.manage.empty.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + to add a folder or clone a repository on your desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf +, um auf Ihrem Desktop einen Ordner hinzuzufügen oder ein Repository zu klonen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
