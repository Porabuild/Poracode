    "onboarding.scan.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → Remote Access on your desktop to show the code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf dem Desktop Einstellungen → Remotezugriff, um den Code anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Configuración → Acceso Remoto en el escritorio para mostrar el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Paramètres → Accès distant sur le bureau pour afficher le code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップで「設定」→「リモートアクセス」を開いてコードを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱에서 설정 → 원격 액세스를 열어 코드를 표시하세요."
          }
        },
        "pl": {
