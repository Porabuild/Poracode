    "rich_chat_request_uncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection ended before the desktop confirmed the change. Refresh before trying again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde beendet, bevor der Desktop die Änderung bestätigt hat. Aktualisiere vor einem erneuten Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión terminó antes de que el escritorio confirmara el cambio. Actualiza antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s’est interrompue avant la confirmation de la modification. Actualisez avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップが変更を確認する前に接続が終了しました。再試行する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱이 변경을 확인하기 전에 연결이 종료되었습니다. 다시 시도하기 전에 새로고침하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie zakończyło się, zanim aplikacja komputerowa potwierdziła zmianę. Odśwież przed ponowną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão terminou antes da confirmação da alteração. Atualize antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервалось до подтверждения изменения. Обновите данные перед повторной попыткой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü değişikliği onaylamadan bağlantı kesildi. Yeniden denemeden önce yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднання завершилося до підтвердження зміни. Оновіть дані перед повторною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đã kết thúc trước khi ứng dụng máy tính xác nhận thay đổi. Hãy làm mới trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面端确认更改前连接已结束。重试前请先刷新。"
          }
        }
      }
    },
