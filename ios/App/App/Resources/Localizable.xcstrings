          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij +, aby dodać folder lub sklonować repozytorium na komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em + para adicionar uma pasta ou clonar um repositório no seu desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите +, чтобы добавить папку или клонировать репозиторий на компьютере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstünüzde bir klasör eklemek veya bir depoyu klonlamak için + öğesine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть +, щоб додати папку або клонувати репозиторій на вашому робочому столі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn + để thêm một thư mục hoặc sao chép một kho lưu trữ trên máy tính của bạn."
          }
