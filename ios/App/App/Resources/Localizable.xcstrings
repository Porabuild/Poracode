    "rich_chat_rollback_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider conversation will move back one completed turn. Refresh before continuing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anbieterunterhaltung wird um eine abgeschlossene Runde zurückgesetzt. Aktualisiere vor dem Fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación del proveedor retrocederá un turno completado. Actualiza antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation du fournisseur reculera d’un tour terminé. Actualisez avant de continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの会話を完了済みの 1 ターン分戻します。続行する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급자 대화를 완료된 한 턴만큼 되돌립니다. 계속하기 전에 새로고침하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa dostawcy zostanie cofnięta o jedną ukończoną turę. Odśwież przed kontynuowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa do provedor voltará um turno concluído. Atualize antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разговор провайдера вернётся на один завершённый ход. Обновите данные перед продолжением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı konuşması tamamlanmış bir tur geri alınacak. Devam etmeden önce yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмова провайдера повернеться на один завершений хід. Оновіть дані перед продовженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện của nhà cung cấp sẽ quay lại một lượt đã hoàn tất. Hãy làm mới trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供方对话将回退一个已完成轮次。继续前请刷新。"
          }
        }
      }
    },
