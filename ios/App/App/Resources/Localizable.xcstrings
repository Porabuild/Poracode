    "hosts.add.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a pairing link or enter the server URL and a one-time token. Tokens are never shown after you connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Kopplungslink ein oder geben Sie Server-URL und Einmaltoken ein. Token werden nach dem Verbinden nie angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un enlace de emparejamiento o introduce la URL del servidor y un token de un solo uso. Los tokens nunca se muestran después de conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien d’association ou saisissez l’URL du serveur et un jeton à usage unique. Les jetons ne sont jamais affichés après la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングリンクを貼り付けるか、サーバーURLと1回限りのトークンを入力してください。接続後にトークンが表示されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 링크를 붙여넣거나 서버 URL과 일회용 토큰을 입력하세요. 연결 후에는 토큰이 표시되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej łącze parowania albo podaj adres URL serwera i jednorazowy token. Tokeny nie są wyświetlane po połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um link de emparelhamento ou informe a URL do servidor e um token de uso único. Os tokens nunca são exibidos depois da conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ссылку для подключения или укажите URL сервера и одноразовый токен. После подключения токены никогда не отображаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eşleme bağlantısı yapıştırın veya sunucu URL’si ile tek kullanımlık belirteci girin. Bağlandıktan sonra belirteçler asla gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте посилання для спарювання або введіть URL-адресу сервера й одноразовий токен. Після підключення токени ніколи не відображаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán liên kết ghép đôi hoặc nhập URL máy chủ và mã dùng một lần. Mã sẽ không bao giờ hiển thị sau khi kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴配对链接，或输入服务器 URL 和一次性令牌。连接后绝不会显示令牌。"
          }
        }
      }
    },
