          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przesłać załącznika. Twoja wiadomość została zachowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar o anexo. Sua mensagem foi mantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить вложение. Ваше сообщение сохранено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek yüklenemedi. Mesajınız korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити вкладення. Ваше повідомлення збережено."
