            "state": "translated",
            "value": "Der Anhang konnte nicht hochgeladen werden. Deine Nachricht wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir el archivo adjunto. Tu mensaje se conservó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce jointe n’a pas pu être envoyée. Votre message a été conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルをアップロードできませんでした。メッセージは保持されています。"
