    "terminal.close.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der laufende Terminalprozess wird beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running terminal process will be stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso del terminal en ejecución se detendrá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus de terminal en cours sera arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のターミナルプロセスが停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 터미널 프로세스가 중지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działający proces terminala zostanie zatrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo em execução no terminal será interrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущенный процесс терминала будет остановлен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan terminal işlemi durdurulacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущений процес термінала буде зупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình thiết bị đầu cuối đang chạy sẽ bị dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行的终端进程将停止。"
          }
        }
      }
    },
