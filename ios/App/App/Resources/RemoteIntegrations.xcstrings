    "remoteIntegrations.schedule.preset.weeklyReview.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize this week's progress, unfinished work, and the most important risks for next week."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasse den Fortschritt dieser Woche, unerledigte Arbeit und die wichtigsten Risiken für nächste Woche zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume el progreso de esta semana, el trabajo pendiente y los riesgos más importantes para la próxima semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résume les progrès de cette semaine, le travail inachevé et les risques les plus importants pour la semaine prochaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の進捗、未完了の作業、来週の重要なリスクをまとめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주의 진행 상황, 미완료 작업, 다음 주의 가장 중요한 위험을 요약해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumuj postępy w tym tygodniu, niedokończoną pracę i najważniejsze ryzyka na przyszły tydzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuma o progresso desta semana, o trabalho inacabado e os riscos mais importantes para a próxima semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обобщи прогресс этой недели, незавершённую работу и самые важные риски на следующую неделю."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftanın ilerlemesini, tamamlanmamış işleri ve gelecek haftanın en önemli risklerini özetle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумуй прогрес цього тижня, незавершену роботу й найважливіші ризики на наступний тиждень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt tiến độ tuần này, công việc chưa hoàn thành và những rủi ro quan trọng nhất cho tuần tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总结本周进展、未完成的工作以及下周最重要的风险。"
