        "pl": { "stringUnit": { "state": "translated", "value": "Przegląd tygodniowy" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Revisão semanal" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Еженедельный обзор" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Haftalık değerlendirme" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Щотижневий огляд" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Đánh giá hằng tuần" } },
