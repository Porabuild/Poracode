        "ja": { "stringUnit": { "state": "translated", "value": "デイリーブリーフ" } },
        "ko": { "stringUnit": { "state": "translated", "value": "일일 브리핑" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Codzienne podsumowanie" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Resumo diário" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Ежедневная сводка" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Günlük özet" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Щоденний огляд" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Bản tóm tắt hằng ngày" } },
