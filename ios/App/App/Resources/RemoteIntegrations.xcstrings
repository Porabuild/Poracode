    "remoteIntegrations.schedule.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the schedule and all its saved run results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden der Zeitplan und alle gespeicherten Ausführungsergebnisse gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la programación y todos sus resultados de ejecución guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime la planification et tous ses résultats d’exécution enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールと、保存されているすべての実行結果が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정과 저장된 모든 실행 결과가 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie harmonogramu i wszystkich zapisanych wyników jego uruchomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o agendamento e todos os seus resultados de execução salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расписание и все сохранённые результаты его запусков будут удалены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem zamanlamayı ve kayıtlı tüm çalıştırma sonuçlarını kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розклад і всі збережені результати його запусків буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa lịch và tất cả kết quả chạy đã lưu của lịch."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将删除计划及其所有已保存的运行结果。"
          }
        }
      }
    },
