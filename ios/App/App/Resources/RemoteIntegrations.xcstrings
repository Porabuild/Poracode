    "remoteIntegrations.schedule.preset.keepOnTrack.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check my recent progress and give me one focused recommendation for what to do next."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe meinen letzten Fortschritt und gib mir eine konkrete Empfehlung für den nächsten Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa mi progreso reciente y dame una recomendación concreta sobre qué hacer a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examine mes progrès récents et donne-moi une recommandation précise pour la suite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の進捗を確認し、次に何をすべきか具体的な提案を1つしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 진행 상황을 확인하고 다음에 할 일에 대한 구체적인 권장 사항 하나를 알려 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź moje ostatnie postępy i podaj jedną konkretną rekomendację, co zrobić dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique meu progresso recente e dê uma recomendação objetiva sobre o que fazer em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверь мой недавний прогресс и дай одну конкретную рекомендацию о следующем шаге."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ilerlememi kontrol et ve sırada ne yapmam gerektiğine dair tek bir net öneri ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевір мій нещодавній прогрес і дай одну конкретну рекомендацію щодо наступного кроку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra tiến độ gần đây của tôi và đưa ra một đề xuất cụ thể về việc cần làm tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查我最近的进展，并针对下一步给出一条明确建议。"
          }
        }
      }
    },
