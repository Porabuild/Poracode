      }
    },
    "remoteIntegrations.schedule.preset.dailyBrief.prompt": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review my recent work and summarize today's priorities and next steps." } },
        "de": { "stringUnit": { "state": "translated", "value": "Prüfe meine letzte Arbeit und fasse die heutigen Prioritäten und nächsten Schritte zusammen." } },
        "es": { "stringUnit": { "state": "translated", "value": "Revisa mi trabajo reciente y resume las prioridades y los próximos pasos de hoy." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Examine mon travail récent et résume les priorités et les prochaines étapes d'aujourd'hui." } },
        "ja": { "stringUnit": { "state": "translated", "value": "最近の作業を確認し、今日の優先事項と次のステップをまとめてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "최근 작업을 검토하고 오늘의 우선순위와 다음 단계를 요약해 주세요." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przejrzyj moją ostatnią pracę i podsumuj dzisiejsze priorytety oraz kolejne kroki." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Revise meu trabalho recente e resuma as prioridades e os próximos passos de hoje." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Просмотри мою недавнюю работу и обобщи сегодняшние приоритеты и следующие шаги." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Son çalışmalarımı incele ve bugünün öncelikleriyle sonraki adımları özetle." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Переглянь мою нещодавню роботу та підсумуй сьогоднішні пріоритети й наступні кроки." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Xem lại công việc gần đây của tôi và tóm tắt các ưu tiên cùng bước tiếp theo của hôm nay." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "查看我最近的工作，并总结今天的优先事项和后续步骤。" } }
      }
    },
    "remoteIntegrations.schedule.preset.keepOnTrack": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep me on track" } },
        "de": { "stringUnit": { "state": "translated", "value": "Halte mich auf Kurs" } },
        "es": { "stringUnit": { "state": "translated", "value": "Manténme encaminado" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Garde-moi sur la bonne voie" } },
        "ja": { "stringUnit": { "state": "translated", "value": "順調に進める" } },
        "ko": { "stringUnit": { "state": "translated", "value": "계획대로 진행하기" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Pomóż mi trzymać się planu" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Mantenha-me no caminho certo" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Помогай мне не сбиваться с курса" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Beni yolunda tut" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Допомагай мені тримати курс" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Giúp tôi đi đúng hướng" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "让我保持正轨" } }
      }
    },
    "remoteIntegrations.schedule.preset.keepOnTrack.prompt": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check my recent progress and give me one focused recommendation for what to do next." } },
        "de": { "stringUnit": { "state": "translated", "value": "Prüfe meinen letzten Fortschritt und gib mir eine konkrete Empfehlung für den nächsten Schritt." } },
        "es": { "stringUnit": { "state": "translated", "value": "Revisa mi progreso reciente y dame una recomendación concreta sobre qué hacer a continuación." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Examine mes progrès récents et donne-moi une recommandation précise pour la suite." } },
        "ja": { "stringUnit": { "state": "translated", "value": "最近の進捗を確認し、次に何をすべきか具体的な提案を1つしてください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "최근 진행 상황을 확인하고 다음에 할 일에 대한 구체적인 권장 사항 하나를 알려 주세요." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Sprawdź moje ostatnie postępy i podaj jedną konkretną rekomendację, co zrobić dalej." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Verifique meu progresso recente e dê uma recomendação objetiva sobre o que fazer em seguida." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверь мой недавний прогресс и дай одну конкретную рекомендацию о следующем шаге." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Son ilerlememi kontrol et ve sırada ne yapmam gerektiğine dair tek bir net öneri ver." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Перевір мій нещодавній прогрес і дай одну конкретну рекомендацію щодо наступного кроку." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Kiểm tra tiến độ gần đây của tôi và đưa ra một đề xuất cụ thể về việc cần làm tiếp theo." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查我最近的进展，并针对下一步给出一条明确建议。" } }
      }
    },
    "remoteIntegrations.schedule.preset.weeklyReview": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Weekly review" } },
        "de": { "stringUnit": { "state": "translated", "value": "Wochenrückblick" } },
