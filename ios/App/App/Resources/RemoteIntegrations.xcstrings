    "remoteIntegrations.state.selectPR.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look up one host-owned PR watch at a time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlage jeweils eine vom Host verwaltete PR-Überwachung nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta un seguimiento de PR del host cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez une surveillance de PR gérée par l’hôte à la fois."
          }
        },
        "ja": {
