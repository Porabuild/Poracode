    "remoteIntegrations.schedule.preset.dailyBrief.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review my recent work and summarize today's priorities and next steps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe meine letzte Arbeit und fasse die heutigen Prioritäten und nächsten Schritte zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa mi trabajo reciente y resume las prioridades y los próximos pasos de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examine mon travail récent et résume les priorités et les prochaines étapes d'aujourd'hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の作業を確認し、今日の優先事項と次のステップをまとめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 작업을 검토하고 오늘의 우선순위와 다음 단계를 요약해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj moją ostatnią pracę i podsumuj dzisiejsze priorytety oraz kolejne kroki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise meu trabalho recente e resuma as prioridades e os próximos passos de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотри мою недавнюю работу и обобщи сегодняшние приоритеты и следующие шаги."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son çalışmalarımı incele ve bugünün öncelikleriyle sonraki adımları özetle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянь мою нещодавню роботу та підсумуй сьогоднішні пріоритети й наступні кроки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại công việc gần đây của tôi và tóm tắt các ưu tiên cùng bước tiếp theo của hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看我最近的工作，并总结今天的优先事项和后续步骤。"
          }
        }
      }
    },
