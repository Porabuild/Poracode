    "remoteIntegrations.schedule.createWithAgent.prompt": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Help me create a schedule. Ask for any missing details, then use the Poracode schedule controls to create it for me." } },
        "de": { "stringUnit": { "state": "translated", "value": "Hilf mir, einen Zeitplan zu erstellen. Frage nach fehlenden Details und erstelle ihn dann mit den Poracode-Zeitplansteuerungen für mich." } },
        "es": { "stringUnit": { "state": "translated", "value": "Ayúdame a crear una programación. Pregunta por los detalles que falten y usa los controles de programación de Poracode para crearla." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Aide-moi à créer une planification. Demande les détails manquants, puis utilise les contrôles de planification Poracode pour la créer." } },
        "ja": { "stringUnit": { "state": "translated", "value": "スケジュール作成を手伝ってください。不足している詳細を確認し、Poracodeのスケジュール操作を使って作成してください。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "일정 생성을 도와주세요. 누락된 세부 정보를 물어본 다음 Poracode 일정 제어를 사용하여 만들어 주세요." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Pomóż mi utworzyć harmonogram. Zapytaj o brakujące szczegóły, a następnie użyj kontrolek harmonogramu Poracode, aby go utworzyć." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Ajude-me a criar um agendamento. Pergunte os detalhes que faltarem e use os controles de agendamento do Poracode para criá-lo." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Помоги мне создать расписание. Спроси недостающие детали, а затем создай его с помощью элементов управления расписаниями Poracode." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bir zamanlama oluşturmama yardım et. Eksik ayrıntıları sor, ardından Poracode zamanlama kontrollerini kullanarak benim için oluştur." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Допоможи мені створити розклад. Запитай відсутні деталі, а потім створи його за допомогою елементів керування розкладами Poracode." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Hãy giúp tôi tạo lịch. Hỏi những chi tiết còn thiếu, sau đó dùng các điều khiển lịch của Poracode để tạo giúp tôi." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "帮助我创建计划。询问缺失的详细信息，然后使用 Poracode 计划控件为我创建。" } }
      }
    },
    "remoteIntegrations.schedule.preset.dailyBrief": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Daily brief" } },
        "de": { "stringUnit": { "state": "translated", "value": "Tägliche Zusammenfassung" } },
        "es": { "stringUnit": { "state": "translated", "value": "Resumen diario" } },
