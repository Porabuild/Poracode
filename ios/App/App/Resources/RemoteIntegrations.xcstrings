    "remoteIntegrations.update.install.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop app will restart and this connection may briefly go offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Desktop-App wird neu gestartet und diese Verbindung ist möglicherweise kurzzeitig offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación de escritorio se reiniciará y esta conexión podría quedar sin conexión brevemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application de bureau va redémarrer et cette connexion peut être brièvement hors ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップアプリが再起動し、この接続が一時的にオフラインになる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱 앱이 재시작되며 이 연결이 잠시 오프라인이 될 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja komputerowa uruchomi się ponownie, a to połączenie może na chwilę przejść w tryb offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app para desktop será reiniciado e esta conexão poderá ficar offline por alguns instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение на компьютере перезапустится, и это подключение может ненадолго пропасть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü uygulaması yeniden başlatılacak ve bu bağlantı kısa süreliğine çevrimdışı olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма на комп’ютері перезапуститься, і це з’єднання може ненадовго перейти в автономний режим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng máy tính sẽ khởi động lại và kết nối này có thể ngoại tuyến trong chốc lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面端应用将重新启动，此连接可能会短暂离线。"
          }
        }
      }
    },
