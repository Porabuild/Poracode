        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte um monitoramento de PR do host por vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте по одному отслеживанию PR, принадлежащему хосту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana bilgisayara ait PR izlemelerini tek tek arayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте по одному відстеженню PR, що належить хосту."
