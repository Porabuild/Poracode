    "automations.completionUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent cannot run completion checks. Choose another agent or remove the stop condition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Agent kann keine Abschlussprüfungen ausführen. Wähle einen anderen Agenten oder entferne die Stoppbedingung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este agente no puede comprobar la finalización. Elige otro agente o elimina la condición de parada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet agent ne peut pas vérifier la fin de la tâche. Choisissez un autre agent ou supprimez la condition d’arrêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントは完了チェックを実行できません。別のエージェントを選択するか、停止条件を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 에이전트는 완료 검사를 실행할 수 없습니다. 다른 에이전트를 선택하거나 중지 조건을 제거하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten agent nie może sprawdzać ukończenia. Wybierz innego agenta lub usuń warunek zatrzymania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este agente não pode verificar a conclusão. Escolha outro agente ou remova a condição de parada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот агент не может проверять завершение. Выберите другого агента или удалите условие остановки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ajan tamamlanma denetimlerini çalıştıramaz. Başka bir ajan seçin veya durdurma koşulunu kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей агент не може перевіряти завершення. Виберіть іншого агента або видаліть умову зупинки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác nhân này không thể kiểm tra hoàn tất. Chọn tác nhân khác hoặc xóa điều kiện dừng."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理无法执行完成检查。请选择其他代理或移除停止条件。"
          }
        }
      }
    }
