      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a task to run an agent automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Aufgabe, um einen Agenten automatisch auszuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una tarea para ejecutar un agente automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une tâche pour exécuter automatiquement un agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントを自動実行するタスクを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 자동으로 실행할 작업을 만드세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz zadanie, aby automatycznie uruchamiać agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma tarefa para executar um agente automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте задачу для автоматического запуска агента."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aracıyı otomatik çalıştırmak için görev oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть завдання для автоматичного запуску агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo tác vụ để tự động chạy một tác nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建任务以自动运行智能体。"
