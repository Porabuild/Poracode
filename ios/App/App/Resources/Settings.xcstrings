    "settings.notice.ambiguousRefreshFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save result was uncertain and the latest values could not be refreshed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speicherergebnis war unsicher und die neuesten Werte konnten nicht aktualisiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado del guardado era incierto y no se pudieron actualizar los valores más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la sauvegarde était incertain et les dernières valeurs n'ont pas pu être actualisées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存結果が不確実であり、最新の値を更新できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 결과가 불확실하여 최신 값을 새로 고칠 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik zapisu był niepewny i nie można było odświeżyć najnowszych wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado do salvamento era incerto e os valores mais recentes não puderam ser atualizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат сохранения был неопределенным, и последние значения не удалось обновить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetme sonucu belirsizdi ve en son değerler yenilenemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат збереження був невизначеним, і останні значення не вдалося оновити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả lưu không chắc chắn và không thể làm mới các giá trị mới nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存结果不确定，无法刷新最新值。"
          }
        }
      }
    },
    "settings.notice.ambiguousRefreshed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save result was uncertain. The latest host values were refreshed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speicherergebnis war ungewiss. Die neuesten Hostwerte wurden aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la salvación fue incierto. Se actualizaron los valores de host más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la sauvegarde était incertain. Les dernières valeurs d'hôte ont été actualisées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存結果は不確実でした。最新のホスト値が更新されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 결과가 불확실했습니다. 최신 호스트 값이 새로 고쳐졌습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik zapisu był niepewny. Najnowsze wartości hosta zostały odświeżone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado do salvamento era incerto. Os valores de host mais recentes foram atualizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат сохранения был неопределенным. Последние значения хоста обновлены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetme sonucu belirsizdi. En son ana bilgisayar değerleri yenilendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат збереження був непевним. Останні значення хосту оновлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả lưu không chắc chắn. Các giá trị máy chủ mới nhất đã được làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存结果不确定。最新主机值已刷新。"
          }
        }
      }
