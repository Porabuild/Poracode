    "settings.appearance.theme.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Popular editor themes adapted to Poracode. Each follows the selected appearance mode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebte Editor-Themes, angepasst an Poracode. Jedes folgt dem gewählten Darstellungsmodus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas populares de editores adaptados a Poracode. Cada uno sigue el modo de apariencia seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thèmes d’éditeur populaires adaptés à Poracode. Chacun suit le mode d’apparence sélectionné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気のエディタテーマをPoracode向けに調整しました。選択した外観モードに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기 편집기 테마를 Poracode에 맞게 조정했습니다. 각 테마는 선택한 화면 모드를 따릅니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popularne motywy edytorów dostosowane do Poracode. Każdy używa wybranego trybu wyglądu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas populares de editores adaptados ao Poracode. Cada um segue o modo de aparência selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Популярные темы редакторов, адаптированные для Poracode. Каждая следует выбранному режиму оформления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode’a uyarlanan popüler düzenleyici temaları. Her biri seçilen görünüm modunu izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Популярні теми редакторів, адаптовані для Poracode. Кожна відповідає вибраному режиму вигляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chủ đề trình soạn thảo phổ biến được điều chỉnh cho Poracode. Mỗi chủ đề theo chế độ giao diện đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Poracode 调整的热门编辑器主题。每个主题都会遵循所选的外观模式。"
          }
        }
      }
    },
