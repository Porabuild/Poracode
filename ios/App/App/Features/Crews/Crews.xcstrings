    "A scout maps the code, a builder implements and verifies, and a reviewer checks the diff; the lead plans and decides.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scout maps the code, a builder implements and verifies, and a reviewer checks the diff; the lead plans and decides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Scout erfasst den Code, ein Entwickler setzt um und verifiziert, ein Prüfer prüft den Diff; das Leitmodell plant und entscheidet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un explorador mapea el código, un constructor implementa y verifica, y un revisor revisa el diff; el principal planifica y decide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un éclaireur cartographie le code, un constructeur implémente et vérifie, un réviseur relit le diff ; le principal planifie et décide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカウトがコードを把握し、ビルダーが実装と検証を行い、レビュアーが差分を確認します。主モデルは計画と判断を担当します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스카우트가 코드를 파악하고, 빌더가 구현과 검증을 하며, 리뷰어가 diff를 확인합니다. 주 모델은 계획하고 결정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwiadowca mapuje kod, budowniczy implementuje i weryfikuje, a recenzent sprawdza diff; model główny planuje i decyduje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um explorador mapeia o código, um construtor implementa e verifica, e um revisor confere o diff; o principal planeja e decide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследователь изучает код, разработчик реализует и проверяет, ревьюер просматривает diff; основная модель планирует и принимает решения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir keşifçi kodu haritalar, bir uygulayıcı uygular ve doğrular, bir inceleyici diff'i kontrol eder; ana model planlar ve karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розвідник вивчає код, розробник реалізує й перевіряє, рецензент переглядає diff; основна модель планує й ухвалює рішення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người trinh sát nắm bắt mã, người xây dựng triển khai và xác minh, người đánh giá kiểm tra diff; mô hình chính lập kế hoạch và quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侦察员梳理代码，构建者实现并验证，审查者检查 diff；主模型负责规划和决策。"
          }
        }
      }
    },
