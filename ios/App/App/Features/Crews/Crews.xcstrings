    "Writes and runs the tests for the change, reproduces reported bugs, and reports each failure with the exact command and failing assertion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes and runs the tests for the change, reproduces reported bugs, and reports each failure with the exact command and failing assertion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt und startet Tests für die Änderung, reproduziert gemeldete Fehler und meldet jeden Fehlschlag mit genauem Befehl und fehlgeschlagener Assertion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe y ejecuta las pruebas del cambio, reproduce los errores reportados e informa cada fallo con el comando exacto y la aserción que falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit et lance les tests du changement, reproduit les bogues signalés et rapporte chaque échec avec la commande exacte et l’assertion en échec."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更のテストを書いて実行し、報告されたバグを再現して、失敗ごとに正確なコマンドと失敗したアサーションを報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경에 대한 테스트를 작성해 실행하고, 보고된 버그를 재현하며, 실패마다 정확한 명령과 실패한 어서션을 보고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisze i uruchamia testy zmiany, odtwarza zgłoszone błędy i podaje każdą porażkę z dokładnym poleceniem i niespełnioną asercją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve e roda os testes da mudança, reproduz os bugs relatados e informa cada falha com o comando exato e a asserção que falhou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишет и запускает тесты для изменения, воспроизводит ошибки из отчётов и сообщает о каждом сбое с точной командой и упавшей проверкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliğin testlerini yazıp çalıştırır, bildirilen hataları yeniden üretir ve her başarısızlığı tam komut ve başarısız doğrulamayla bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пише й запускає тести для зміни, відтворює повідомлені помилки й повідомляє про кожен збій з точною командою та перевіркою, що не пройшла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết và chạy kiểm thử cho thay đổi, tái hiện lỗi được báo, rồi báo từng lần thất bại kèm lệnh chính xác và assertion không đạt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为改动编写并运行测试，复现已报告的缺陷，并为每个失败附上确切命令和失败的断言。"
          }
        }
      }
    },
