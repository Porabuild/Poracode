    "A tester writes and runs failing tests, and a builder makes them pass; the lead sets the cases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tester writes and runs failing tests, and a builder makes them pass; the lead sets the cases."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tester schreibt und startet fehlschlagende Tests, ein Entwickler bringt sie zum Laufen; das Leitmodell legt die Fälle fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tester escribe y ejecuta pruebas que fallan, y un constructor las hace pasar; el principal define los casos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un testeur écrit et lance des tests qui échouent, un constructeur les fait passer ; le principal fixe les cas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスターが失敗するテストを書いて実行し、ビルダーが通るようにします。ケースは主モデルが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스터가 실패하는 테스트를 작성해 실행하고, 빌더가 통과시킵니다. 케이스는 주 모델이 정합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester pisze i uruchamia nieprzechodzące testy, a budowniczy sprawia, że przechodzą; model główny ustala przypadki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um testador escreve e roda testes que falham, e um construtor faz eles passarem; o principal define os casos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестировщик пишет и запускает падающие тесты, разработчик добивается их прохождения; основная модель задаёт сценарии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir test uzmanı başarısız testler yazıp çalıştırır, bir uygulayıcı onları geçirir; senaryoları ana model belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестувальник пише й запускає тести, що падають, розробник домагається їх проходження; основна модель задає сценарії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người kiểm thử viết và chạy bài kiểm thử lỗi, người xây dựng làm chúng vượt qua; mô hình chính đặt các ca kiểm thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试者编写并运行失败的测试，构建者让它们通过；测试用例由主模型确定。"
          }
        }
      }
    },
