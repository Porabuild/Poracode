    "Explores the codebase, implements the lead's task end to end, runs the narrowest checks, and reports what changed with evidence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explores the codebase, implements the lead's task end to end, runs the narrowest checks, and reports what changed with evidence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkundet die Codebasis, setzt die Aufgabe des Leitmodells vollständig um, führt die engsten passenden Prüfungen aus und belegt die Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora el código, hace la tarea del principal de principio a fin, ejecuta las comprobaciones mínimas e informa los cambios con evidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore le code, réalise la tâche du principal de bout en bout, lance les vérifications ciblées et résume les changements avec preuves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードベースを調査し、主モデルのタスクを最後まで実装し、必要最小限のチェックを実行して、変更点を根拠とともに報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드베이스를 탐색하고 주 모델의 작업을 끝까지 구현하며, 필요한 최소한의 검사를 실행하고 변경 사항을 근거와 함께 보고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bada kod, realizuje zadanie modelu głównego w całości, uruchamia najwęższe potrzebne testy i opisuje zmiany wraz z dowodami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora o código, faz a tarefa do principal de ponta a ponta, roda as verificações mínimas e informa o que mudou com evidências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучает код, выполняет задачу основной модели целиком, запускает минимально нужные проверки и сообщает об изменениях с доказательствами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tabanını inceler, ana modelin görevini baştan sona yapar, en dar kapsamlı kontrolleri çalıştırır ve değişiklikleri kanıtla bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчає код, виконує задачу основної моделі повністю, запускає мінімально потрібні перевірки й повідомляє про зміни з доказами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá mã nguồn, làm trọn tác vụ của mô hình chính, chạy các kiểm tra hẹp nhất cần thiết, rồi báo những gì đã đổi kèm bằng chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索代码库，端到端完成主模型的任务，运行范围最小的检查，并附证据报告改动。"
          }
        }
      }
    },
