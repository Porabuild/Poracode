    "%1$@ can't lead a crew. Pick another model first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't lead a crew. Pick another model first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann kein Team leiten. Wähle zuerst ein anderes Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no puede liderar un equipo. Elige otro modelo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne peut pas diriger une équipe. Choisissez d'abord un autre modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は Crew を率いられません。先に別のモデルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 크루를 이끌 수 없습니다. 먼저 다른 모델을 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nie może prowadzić zespołu. Najpierw wybierz inny model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não pode liderar uma equipe. Escolha outro modelo primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не может возглавить команду. Сначала выберите другую модель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bir ekibe liderlik edemez. Önce başka bir model seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не може очолювати команду. Спочатку виберіть іншу модель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ không thể dẫn dắt một nhóm. Trước tiên hãy chọn mô hình khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法领导团队。请先选择其他模型。"
          }
        }
      }
    },
    "%1$@ isn't available, so %2$@ stays the lead.": {
      "extractionState": "manual",
