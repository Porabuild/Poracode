    },
    "This Crew changed elsewhere. Reload before saving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Crew changed elsewhere. Reload before saving."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Crew wurde anderswo geändert. Lade sie vor dem Speichern neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Crew cambió en otro lugar. Recárgala antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette Crew a été modifiée ailleurs. Rechargez-la avant d’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このCrewは別の場所で変更されました。保存する前に再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에서 이 Crew가 변경되었습니다. 저장하기 전에 다시 불러오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ekipa została zmieniona gdzie indziej. Wczytaj ją ponownie przed zapisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Crew foi alterada em outro lugar. Recarregue antes de salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту команду изменили в другом месте. Перезагрузите её перед сохранением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekip başka bir yerde değiştirildi. Kaydetmeden önce yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю команду змінили в іншому місці. Перезавантажте її перед збереженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm này đã được thay đổi ở nơi khác. Hãy tải lại trước khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此团队已在其他位置更改。请重新加载后再保存。"
          }
        }
      }
    },
    "The host did not apply this change. Reconnect or update it, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host did not apply this change. Reconnect or update it, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host hat die Änderung nicht übernommen. Verbinde dich erneut oder aktualisiere ihn und versuche es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El host no aplicó el cambio. Vuelve a conectarte o actualízalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hôte n’a pas appliqué ce changement. Reconnectez-vous ou mettez-le à jour, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストが変更を適用しませんでした。再接続または更新してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트가 변경 사항을 적용하지 않았습니다. 다시 연결하거나 업데이트한 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Host nie zastosował zmiany. Połącz się ponownie lub zaktualizuj go i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host não aplicou a alteração. Reconecte ou atualize o host e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хост не применил изменение. Подключитесь заново или обновите его и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana makine değişikliği uygulamadı. Yeniden bağlanın veya güncelleyin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хост не застосував зміну. Підключіться знову або оновіть його та повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ chưa áp dụng thay đổi. Hãy kết nối lại hoặc cập nhật rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机未应用此更改。请重新连接或更新主机，然后重试。"
          }
        }
      }
    },
    "Switch back to the source host to edit this Crew.": {
