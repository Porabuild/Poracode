    "Two independent read-only reviews of a change, and a sidekick applies the fixes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two independent read-only reviews of a change, and a sidekick applies the fixes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei unabhängige Prüfungen einer Änderung ohne Bearbeitung, und ein Hilfsmodell setzt die Korrekturen um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos revisiones independientes de solo lectura de un cambio, y un auxiliar aplica los arreglos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux relectures indépendantes en lecture seule d’un changement, et un auxiliaire applique les corrections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更に対する 2 つの独立した読み取り専用レビューと、修正を適用する補助モデル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경에 대한 독립적인 읽기 전용 리뷰 2개와, 수정을 적용하는 보조 모델."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa niezależne przeglądy zmiany tylko do odczytu, a model pomocniczy wprowadza poprawki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas revisões independentes somente leitura de uma mudança, e um auxiliar aplica as correções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две независимые проверки изменения только для чтения, а вспомогательная модель вносит исправления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir değişikliğin iki bağımsız, salt okunur incelemesi ve düzeltmeleri uygulayan bir yardımcı model."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві незалежні перевірки зміни лише для читання, а допоміжна модель вносить виправлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai lượt đánh giá độc lập, chỉ đọc, cho một thay đổi, và một mô hình phụ áp dụng các bản sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对一个改动的两次独立只读审查，并由辅助模型应用修复。"
          }
        }
      }
    },
