    },
    "Takes any hands-on task the lead hands off: exploring, editing and running checks, then reports back with evidence.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes any hands-on task the lead hands off: exploring, editing and running checks, then reports back with evidence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt jede praktische Aufgabe des Leitmodells: erkunden, bearbeiten und Prüfungen ausführen, und berichtet dann mit Belegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asume cualquier tarea práctica que le pase el principal: explorar, editar y ejecutar comprobaciones, e informa con evidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend toute tâche concrète confiée par le principal : explorer, modifier et lancer des vérifications, puis rend compte avec preuves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主モデルから渡された実作業を何でも引き受けます。調査、編集、チェック実行を行い、根拠とともに報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 모델이 넘기는 실무 작업을 무엇이든 맡습니다. 탐색, 편집, 검사 실행을 하고 근거와 함께 보고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejmuje każde praktyczne zadanie od modelu głównego: bada kod, edytuje i uruchamia testy, po czym raportuje z dowodami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assume qualquer tarefa prática que o principal passar: explorar, editar e rodar verificações, e depois informa com evidências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берёт любую практическую задачу от основной модели: изучает код, вносит правки и запускает проверки, затем отчитывается с доказательствами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana modelin devrettiği her uygulamalı görevi üstlenir: keşfeder, düzenler ve kontrolleri çalıştırır, sonra kanıtla bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бере будь-яку практичну задачу від основної моделі: вивчає код, вносить правки й запускає перевірки, потім звітує з доказами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận mọi việc thực hành mô hình chính giao: khám phá, chỉnh sửa và chạy kiểm tra, rồi báo lại kèm bằng chứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "承接主模型交出的任何实际任务：探索、编辑和运行检查，然后附证据汇报。"
          }
        }
      }
    },
