    "The lead plans and reviews; a cheaper sidekick explores, builds and verifies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lead plans and reviews; a cheaper sidekick explores, builds and verifies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Leitmodell plant und prüft, ein günstigeres Hilfsmodell erkundet, setzt um und verifiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El principal planifica y revisa; un auxiliar más barato explora, construye y verifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principal planifie et relit ; un auxiliaire moins cher explore, construit et vérifie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主モデルが計画とレビューを行い、安価な補助モデルが調査、実装、検証を担当します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 모델이 계획하고 리뷰하며, 더 저렴한 보조 모델이 탐색, 구현, 검증을 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model główny planuje i przegląda, tańszy model pomocniczy bada kod, buduje i weryfikuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O principal planeja e revisa; um auxiliar mais barato explora, constrói e verifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная модель планирует и проверяет результат, более дешёвая вспомогательная модель изучает код, реализует и тестирует изменения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana model planlar ve inceler; daha ucuz bir yardımcı model keşfeder, uygular ve doğrular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основна модель планує й перевіряє результат, дешевша допоміжна модель вивчає код, реалізує й тестує зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình chính lập kế hoạch và đánh giá; mô hình phụ rẻ hơn khám phá, xây dựng và xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型负责规划和审查，更便宜的辅助模型负责探索、构建和验证。"
          }
        }
      }
    },
