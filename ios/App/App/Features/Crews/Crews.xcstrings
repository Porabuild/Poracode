    "Reproduces the bug and traces it to the root cause, then reports the evidence, the failing code path and a suggested fix.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduces the bug and traces it to the root cause, then reports the evidence, the failing code path and a suggested fix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduziert den Fehler, verfolgt ihn bis zur Ursache und meldet die Belege, den fehlerhaften Codepfad und einen Lösungsvorschlag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el error y lo rastrea hasta la causa raíz; luego informa la evidencia, la ruta de código que falla y un arreglo sugerido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduit le bogue et remonte à sa cause racine, puis rapporte les preuves, le chemin de code fautif et un correctif suggéré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バグを再現して根本原因まで追跡し、根拠、失敗するコードパス、修正案を報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그를 재현하고 근본 원인까지 추적한 뒤, 근거와 실패하는 코드 경로, 수정 제안을 보고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza błąd i śledzi go do przyczyny źródłowej, po czym podaje dowody, błędną ścieżkę kodu i proponowaną poprawkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o bug e o rastreia até a causa raiz; depois informa as evidências, o caminho de código que falha e uma correção sugerida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводит ошибку и прослеживает её до первопричины, затем сообщает доказательства, сбойный путь в коде и предлагаемое исправление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatayı yeniden üretir ve kök nedenine kadar izler; ardından kanıtları, hatalı kod yolunu ve önerilen düzeltmeyi bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює помилку й простежує її до першопричини, потім повідомляє докази, збійний шлях у коді й запропоноване виправлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tái hiện lỗi và lần tới nguyên nhân gốc, rồi báo bằng chứng, đường mã gây lỗi và bản sửa đề xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复现缺陷并追踪到根本原因，然后报告证据、出错的代码路径和建议的修复。"
          }
        }
      }
    },
