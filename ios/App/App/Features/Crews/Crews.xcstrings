          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указание не редактировать файлы. Не принудительно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları düzenlememesi söylendi. Zorunlu değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вказівка не редагувати файли. Не примусово."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được dặn không chỉnh sửa tệp. Không được thực thi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指示不要编辑文件。不会强制执行。"
          }
        }
      }
    },
    "Enter a valid name, lead and at least one role.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid name, lead and at least one role."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen gültigen Namen, ein Leitmodell und mindestens eine Rolle an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre válido, un líder y al menos un rol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom valide, un responsable et au moins un rôle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な名前、リード、1つ以上のロールを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 이름, 리드, 하나 이상의 역할을 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj poprawną nazwę, model prowadzący i co najmniej jedną rolę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um nome válido, um líder e pelo menos uma função."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите корректное имя, ведущую модель и хотя бы одну роль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli bir ad, bir lider ve en az bir rol girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть коректну назву, провідну модель і принаймні одну роль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên hợp lệ, mô hình chính và ít nhất một vai trò."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效名称、主导模型和至少一个角色。"
          }
        }
      }
    },
    "You can save up to 24 Crews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can save up to 24 Crews."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu 24 Crews speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes guardar hasta 24 Crews."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez enregistrer jusqu’à 24 Crews."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大24個のCrewを保存できます。"
          }
        },
        "ko": {
