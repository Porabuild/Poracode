    "Implements the lead's task end to end and verifies it with the narrowest build and tests; reports changed files, check results and deviations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Implements the lead's task end to end and verifies it with the narrowest build and tests; reports changed files, check results and deviations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Aufgabe des Leitmodells vollständig um und prüft sie mit engstem Build und Tests; meldet geänderte Dateien, Prüfergebnisse und Abweichungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace la tarea del principal de principio a fin y la verifica con la compilación y pruebas mínimas; informa archivos cambiados, resultados y desvíos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réalise la tâche du principal de bout en bout et la vérifie avec le build et les tests ciblés ; indique fichiers modifiés, résultats et écarts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主モデルのタスクを最後まで実装し、必要最小限のビルドとテストで検証します。変更ファイル、チェック結果、タスクとの差異を報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 모델의 작업을 끝까지 구현하고 최소한의 빌드와 테스트로 검증합니다. 변경된 파일, 검사 결과, 작업과 달라진 점을 보고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizuje zadanie modelu głównego w całości i weryfikuje je najwęższym buildem i testami; podaje zmienione pliki, wyniki testów i odstępstwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz a tarefa do principal de ponta a ponta e a verifica com o build e os testes mínimos; informa arquivos alterados, resultados e desvios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет задачу основной модели целиком и проверяет её минимальной сборкой и тестами; сообщает изменённые файлы, итоги проверок и отклонения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana modelin görevini baştan sona uygular, en dar derleme ve testlerle doğrular; değişen dosyaları, kontrol sonuçlarını ve sapmaları bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконує задачу основної моделі повністю й перевіряє її мінімальною збіркою та тестами; повідомляє змінені файли, підсумки перевірок і відхилення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm trọn tác vụ của mô hình chính và xác minh bằng bản dựng và kiểm thử hẹp nhất; báo tệp đã đổi, kết quả kiểm tra và điểm sai lệch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端到端完成主模型的任务，并用范围最小的构建和测试验证；报告改动的文件、检查结果和偏差。"
          }
        }
      }
    },
