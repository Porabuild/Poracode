    "Implements the fix the lead settles, adds a regression test, and confirms the reproduction now passes with the narrowest check.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Implements the fix the lead settles, adds a regression test, and confirms the reproduction now passes with the narrowest check."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die vom Leitmodell festgelegte Korrektur um, ergänzt einen Regressionstest und bestätigt mit der engsten Prüfung, dass die Reproduktion besteht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Implementa el arreglo que fija el principal, añade una prueba de regresión y confirma con la comprobación mínima que la reproducción ya pasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Implémente le correctif décidé par le principal, ajoute un test de régression et confirme par la vérification ciblée que la reproduction passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主モデルが決めた修正を実装し、回帰テストを追加して、必要最小限のチェックで再現が通るようになったことを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 모델이 정한 수정을 구현하고 회귀 테스트를 추가한 뒤, 최소한의 검사로 재현이 이제 통과하는지 확인합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadza poprawkę ustaloną przez model główny, dodaje test regresji i najwęższym testem potwierdza, że reprodukcja już przechodzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Implementa a correção definida pelo principal, adiciona um teste de regressão e confirma com a verificação mínima que a reprodução passa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вносит исправление, выбранное основной моделью, добавляет регрессионный тест и минимальной проверкой подтверждает, что воспроизведение проходит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana modelin belirlediği düzeltmeyi uygular, bir regresyon testi ekler ve en dar kontrolle yeniden üretimin artık geçtiğini doğrular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вносить виправлення, обране основною моделлю, додає регресійний тест і мінімальною перевіркою підтверджує, що відтворення проходить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Triển khai bản sửa mà mô hình chính đã chốt, thêm bài kiểm thử hồi quy và xác nhận bằng kiểm tra hẹp nhất rằng lỗi tái hiện đã qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实现主模型确定的修复，添加回归测试，并用范围最小的检查确认复现现已通过。"
          }
        }
      }
    },
