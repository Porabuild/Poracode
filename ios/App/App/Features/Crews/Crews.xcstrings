    "The lead splits the work; up to three builders implement and verify independent tasks at once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lead splits the work; up to three builders implement and verify independent tasks at once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Leitmodell teilt die Arbeit auf; bis zu drei Entwickler setzen unabhängige Aufgaben gleichzeitig um und verifizieren sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El principal reparte el trabajo; hasta tres constructores implementan y verifican tareas independientes a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principal découpe le travail ; jusqu’à trois constructeurs implémentent et vérifient des tâches indépendantes en même temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主モデルが作業を分割し、最大 3 つのビルダーが独立したタスクを同時に実装・検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 모델이 작업을 나누고, 최대 3개의 빌더가 독립적인 작업을 동시에 구현하고 검증합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model główny dzieli pracę; do trzech budowniczych jednocześnie implementuje i weryfikuje niezależne zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O principal divide o trabalho; até três construtores implementam e verificam tarefas independentes ao mesmo tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная модель делит работу; до трёх разработчиков одновременно реализуют и проверяют независимые задачи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana model işi böler; en fazla üç uygulayıcı bağımsız görevleri aynı anda uygular ve doğrular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основна модель ділить роботу; до трьох розробників одночасно реалізують і перевіряють незалежні задачі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình chính chia việc; tối đa ba người xây dựng cùng lúc triển khai và xác minh các tác vụ độc lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型拆分工作；最多三个构建者同时实现并验证相互独立的任务。"
          }
        }
      }
    },
