    "Reads the full diff and the code it touches, runs targeted checks, and reports bugs, regressions and missing tests by file and line.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the full diff and the code it touches, runs targeted checks, and reports bugs, regressions and missing tests by file and line."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den ganzen Diff und den betroffenen Code, führt gezielte Prüfungen aus und meldet Fehler, Regressionen und fehlende Tests mit Datei und Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el diff completo y el código que toca, ejecuta comprobaciones puntuales e informa errores, regresiones y pruebas faltantes por archivo y línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit tout le diff et le code concerné, lance des vérifications ciblées et signale bogues, régressions et tests manquants par fichier et ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分全体と関連コードを読み、対象を絞ったチェックを実行して、バグ、リグレッション、不足しているテストをファイルと行で報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 diff와 관련 코드를 읽고 필요한 검사를 실행해 버그, 회귀, 누락된 테스트를 파일과 줄 단위로 보고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyta cały diff i kod, którego dotyczy, uruchamia celowane testy i zgłasza błędy, regresje oraz brakujące testy z plikiem i wierszem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o diff completo e o código que ele toca, roda verificações pontuais e informa bugs, regressões e testes faltantes por arquivo e linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает весь diff и затронутый код, запускает точечные проверки и сообщает об ошибках, регрессиях и недостающих тестах с файлом и строкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm diff'i ve dokunduğu kodu okur, hedefli kontroller çalıştırır; hataları, regresyonları ve eksik testleri dosya ve satırla bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає весь diff і зачеплений код, запускає точкові перевірки й повідомляє про помилки, регресії та бракуючі тести з файлом і рядком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc toàn bộ diff và mã liên quan, chạy kiểm tra có mục tiêu, rồi báo lỗi, hồi quy và kiểm thử còn thiếu theo tệp và dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读完整 diff 及其涉及的代码，运行有针对性的检查，按文件和行报告缺陷、回归和缺失的测试。"
          }
        }
      }
    },
