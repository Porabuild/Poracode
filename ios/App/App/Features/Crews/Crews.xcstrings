    "An investigator finds the root cause, and a fixer lands the fix with a regression test.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An investigator finds the root cause, and a fixer lands the fix with a regression test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ermittler findet die Ursache, ein Fixer liefert die Korrektur mit einem Regressionstest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un investigador encuentra la causa raíz, y un reparador aplica el arreglo con una prueba de regresión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enquêteur trouve la cause racine, et un correcteur livre le correctif avec un test de régression."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調査担当が根本原因を突き止め、修正担当が回帰テスト付きで修正を入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조사 담당이 근본 원인을 찾고, 수정 담당이 회귀 테스트와 함께 수정을 반영합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledczy znajduje przyczynę źródłową, a naprawiacz wprowadza poprawkę z testem regresji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um investigador encontra a causa raiz, e um corretor aplica a correção com um teste de regressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следователь находит первопричину, а исправитель вносит исправление с регрессионным тестом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir araştırmacı kök nedeni bulur, bir düzeltici de düzeltmeyi bir regresyon testiyle uygular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідчий знаходить першопричину, а виправник вносить виправлення з регресійним тестом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người điều tra tìm nguyên nhân gốc, người sửa lỗi đưa vào bản sửa kèm bài kiểm thử hồi quy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调查者找出根本原因，修复者落地修复并附回归测试。"
          }
        }
      }
    },
