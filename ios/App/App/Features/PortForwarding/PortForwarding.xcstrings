          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O navegador não conseguiu abrir este encaminhamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузеру не удалось открыть это перенаправление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı bu yönlendirmeyi açamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузеру не вдалося відкрити це перенаправлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình duyệt không thể mở cổng chuyển tiếp này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器无法打开此转发。"
