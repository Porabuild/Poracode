    "port-forwarding.empty.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a dev server on your desktop, then tap refresh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie einen Dev-Server auf Ihrem Desktop und tippen Sie dann auf Aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un servidor de desarrollo en tu escritorio y luego toca actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez un serveur de développement sur votre bureau, puis appuyez sur actualiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップで開発サーバーを起動し、更新をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱에서 개발 서버를 시작한 다음 새로고침을 탭하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom serwer deweloperski na komputerze, a następnie dotknij Odśwież."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie um servidor de desenvolvimento no seu desktop e toque em atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите сервер разработки на десктопе, затем нажмите «Обновить»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstünüzde bir geliştirme sunucusu başlatın, ardından yenile'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть сервер розробки на комп'ютері, потім торкніться «Оновити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động một máy chủ phát triển trên máy tính của bạn, sau đó nhấn làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在桌面上启动一个开发服务器，然后点击刷新。"
          }
        }
      }
    },
