    "port-forwarding.ambiguous": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain. Scan again before repeating the action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist ungewiss. Scanne erneut, bevor du die Aktion wiederholst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es incierto. Vuelve a explorar antes de repetir la acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat est incertain. Relancez l’analyse avant de répéter l’action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が不明です。操作を繰り返す前に再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 확인할 수 없습니다. 작업을 반복하기 전에 다시 검색하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik jest niepewny. Przeskanuj ponownie przed powtórzeniem działania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é incerto. Examine novamente antes de repetir a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат неизвестен. Повторите сканирование перед повтором действия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç belirsiz. İşlemi yinelemeden önce yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат невідомий. Повторіть сканування перед повторенням дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả chưa chắc chắn. Hãy quét lại trước khi lặp lại thao tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定。请在重复操作前重新扫描。"
          }
        }
      }
    },
    "port-forwarding.browser-unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser could not open this forward."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browser konnte diese Weiterleitung nicht öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
