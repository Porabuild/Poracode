        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các công cụ này được quản lý trong cài đặt của tác tử này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些工具由此智能体的设置管理。"
          }
        }
