        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các máy chủ MCP đã bật vẫn được bật cho luồng mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用的 MCP 服务器会在新会话中保持启用。"
          }
        }
      }
    },
    "These tools are managed in this agent’s settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These tools are managed in this agent’s settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werkzeuge werden in den Einstellungen dieses Agenten verwaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas herramientas se administran en los ajustes de este agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces outils se gèrent dans les réglages de cet agent."
