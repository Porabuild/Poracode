{
  "sourceLanguage": "en",
  "strings": {
    "Enabled plugins stay on for new threads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled plugins stay on for new threads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Plugins bleiben für neue Threads eingeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los complementos activados siguen activos en los hilos nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plugins activés restent actifs pour les nouveaux fils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なプラグインは新しいスレッドでも有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화한 플러그인은 새 스레드에서도 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone wtyczki pozostają włączone w nowych wątkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os plugins ativados continuam ativos nas novas conversas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включённые плагины остаются включёнными в новых ветках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin eklentiler yeni sohbetlerde de açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнені плагіни залишаються ввімкненими в нових гілках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các plugin đã bật vẫn được bật cho luồng mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用的插件会在新会话中保持启用。"
          }
        }
      }
    },
    "Enabled MCP servers stay on for new threads.": {
