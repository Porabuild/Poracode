    "Use the microphone to try your selected engine and model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie das Mikrofon, um Ihren ausgewählten Motor und Ihr ausgewähltes Modell auszuprobieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone to try your selected engine and model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el micrófono para probar el motor y modelo seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "utilisez le microphone pour essayer le moteur et le modèle sélectionnés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを使用して、選択したエンジンとモデルを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 사용하여 선택한 엔진과 모델을 시험해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj mikrofonu, aby wypróbować wybrany silnik i model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o microfone para testar o motor e modelo selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте микрофон, чтобы проверить выбранный движок и модель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz motoru ve modeli denemek için mikrofonu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте вибрані рушій і модель за допомогою мікрофона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng micrô để thử động cơ và kiểu máy bạn đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用麦克风尝试您选择的引擎和型号。"
          }
        }
      }
    },
    "Your test transcript will appear here. It is not sent to a conversation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Testprotokoll wird hier angezeigt. Es wird nicht an eine Konversation gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your test transcript will appear here. It is not sent to a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción de su examen aparecerá aquí. No se envía a una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "votre relevé de notes de test apparaîtra ici. Il n'est pas envoyé à une conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストの成績証明書がここに表示されます。会話には送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 기록이 여기에 표시됩니다. 대화로 전송되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawi się transkrypcja testu. Nie jest wysyłany do rozmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição do seu teste aparecerá aqui. Não é enviado para uma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появится распознанный текст. Он не будет отправлен в беседу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test transkriptiniz burada görünecek. Bir konuşmaya gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’явиться розпізнаний текст. Його не буде надіслано в розмову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng điểm bài kiểm tra của bạn sẽ xuất hiện ở đây. Nó không được gửi đến một cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的测试成绩单将显示在此处。它不会发送到对话。"
          }
        }
      }
    },
