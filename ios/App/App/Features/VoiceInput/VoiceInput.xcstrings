    "Audio is sent to the selected host for transcription.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is sent to the selected host for transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird zur Transkription an den ausgewählten Host gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se envía al host seleccionado para transcribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio est envoyé à l’hôte sélectionné pour être transcrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は文字起こしのために選択したホストに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 호스트로 오디오를 보내 텍스트로 변환합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk jest wysyłany do wybranego hosta w celu transkrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio é enviado ao host selecionado para transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио отправляется на выбранный хост для расшифровки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, yazıya dönüştürülmek üzere seçilen ana makineye gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо надсилається на вибраний хост для розшифрування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh được gửi đến máy chủ đã chọn để chuyển thành văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频将发送到所选主机进行转写。"
          }
        }
      }
    },
    "Audio is transcribed on this device.": {
