          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 Hex 엔진이 무결성 또는 서명 확인에 실패했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrany silnik Hex nie przeszedł kontroli integralności lub podpisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo Hex transferido por download falhou na verificação de integridade ou assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженный движок Hex не прошёл проверку целостности или подписи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen Hex motoru bütünlük veya imza kontrolünde başarısız oldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
