      }
    },
    "Hex is unavailable on this host. Install a compatible Hex executable and restart Poracode, or choose the built-in backend.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex is unavailable on this host. Install a compatible Hex executable and restart Poracode, or choose the built-in backend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex ist auf diesem Host nicht verfügbar. Installiere eine kompatible Hex-Datei und starte Poracode neu oder wähle das integrierte Backend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex no está disponible en este host. Instala un ejecutable compatible de Hex y reinicia Poracode, o elige el sistema integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex n’est pas disponible sur cet hôte. Installez un exécutable Hex compatible et redémarrez Poracode, ou choisissez le moteur intégré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストでは Hex を利用できません。互換性のある Hex 実行ファイルをインストールして Poracode を再起動するか、内蔵バックエンドを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 호스트에서 Hex를 사용할 수 없습니다. 호환되는 Hex 실행 파일을 설치하고 Poracode를 다시 시작하거나 내장형 백엔드를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex jest niedostępny na tym hoście. Zainstaluj zgodny plik wykonywalny Hex i uruchom ponownie Poracode albo wybierz wbudowany mechanizm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hex não está disponível neste host. Instale um executável compatível do Hex e reinicie o Poracode ou escolha o mecanismo integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex недоступен на этом хосте. Установите совместимый исполняемый файл Hex и перезапустите Poracode или выберите встроенную транскрипцию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex bu ana makinede kullanılamıyor. Uyumlu bir Hex çalıştırılabilir dosyası yükleyip Poracode'u yeniden başlatın veya yerleşik arka ucu seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex недоступний на цьому хості. Установіть сумісний виконуваний файл Hex і перезапустіть Poracode або виберіть вбудовану транскрипцію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex không khả dụng trên máy chủ này. Hãy cài đặt tệp thực thi Hex tương thích và khởi động lại Poracode, hoặc chọn phần xử lý tích hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机上无法使用 Hex。请安装兼容的 Hex 可执行文件并重启 Poracode，或选择内置后端。"
          }
        }
      }
    },
