    "Choose how you record and where your speech is transcribed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how you record and where your speech is transcribed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wie Sie Ihre Rede aufzeichnen und wo sie transkribiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "elija cómo grabar y dónde se transcribe su discurso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez comment vous enregistrez et où votre discours est transcrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を録音する方法と、音声を文字に起こす場所を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 방법과 음성이 기록되는 위치를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sposób nagrywania i miejsce transkrypcji wypowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como você grava e onde sua fala será transcrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
