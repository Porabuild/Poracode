    "Hex could not process this request. Check the model and language in Audio settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex could not process this request. Check the model and language in Audio settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex konnte diese Anfrage nicht verarbeiten. Überprüfe Modell und Sprache in den Audioeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex no pudo procesar esta solicitud. Comprueba el modelo y el idioma en los ajustes de Audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex n’a pas pu traiter cette demande. Vérifiez le modèle et la langue dans les paramètres Audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex でリクエストを処理できませんでした。Audio 設定でモデルと言語を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex에서 요청을 처리할 수 없습니다. 오디오 설정에서 모델과 언어를 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex nie może przetworzyć tego żądania. Sprawdź model i język w ustawieniach Audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hex não conseguiu processar esta solicitação. Verifique o modelo e o idioma nas configurações de Áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать запрос в Hex. Проверьте модель и язык в настройках звука."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex bu isteği işleyemedi. Ses ayarlarından modeli ve dili kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex не вдалося обробити цей запит. Перевірте модель і мову в налаштуваннях аудіо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex không thể xử lý yêu cầu này. Hãy kiểm tra mô hình và ngôn ngữ trong phần cài đặt Âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex 无法处理此请求。请在音频设置中检查模型和语言。"
          }
        }
      }
    },
    "Hex is busy with another voice request. Try again shortly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex is busy with another voice request. Try again shortly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex verarbeitet gerade eine andere Sprachanfrage. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex está ocupado con otra solicitud de voz. Vuelve a intentarlo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
