    "The Hex engine download failed. Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hex engine download failed. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download der Hex-Engine ist fehlgeschlagen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la descarga del motor Hex. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement du moteur Hex a échoué. Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex エンジンのダウンロードに失敗しました。接続を確認して、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex 엔진 다운로드에 실패했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie silnika Hex nie powiodło się. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download do mecanismo Hex falhou. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить движок Hex. Проверьте подключение и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex motorunun indirilmesi başarısız oldu. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити рушій Hex. Перевірте підключення та повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống công cụ Hex không thành công. Hãy kiểm tra kết nối của bạn và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex 引擎下载失败。检查您的连接并重试。"
          }
        }
      }
    },
    "The Hex engine is incompatible with this host or Poracode version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hex engine is incompatible with this host or Poracode version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hex-Engine ist mit dieser Host- oder Poracode-Version nicht kompatibel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor Hex es incompatible con este host o versión Poracode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Hex est incompatible avec cet hôte ou cette version Poracode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex エンジンは、このホストまたは Poracode バージョンと互換性がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex 엔진은 이 호스트 또는 Poracode 버전과 호환되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik Hex jest niekompatybilny z tym hostem lub wersją Poracode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo Hex é incompatível com este host ou versão Poracode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок Hex несовместим с этим хостом или версией Poracode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex motoru bu ana bilgisayarla veya Poracode sürümüyle uyumlu değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рушій Hex несумісний із цим хостом або версією Poracode."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ Hex không tương thích với máy chủ này hoặc phiên bản Poracode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hex 引擎与此主机或 Poracode 版本不兼容。"
          }
        }
      }
    },
    "The connected Poracode host is unavailable. Reconnect and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connected Poracode host is unavailable. Reconnect and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verbundene Poracode-Host ist nicht verfügbar. Stellen Sie die Verbindung wieder her und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El host Poracode conectado no está disponible. Vuelve a conectarte y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hôte Poracode connecté n'est pas disponible. Reconnectez-vous et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続された Poracode ホストが使用できません。再接続してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 Poracode 호스트를 사용할 수 없습니다. 다시 연결하고 다시 시도해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłączony host Poracode jest niedostępny. Połącz się ponownie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host Poracode conectado está indisponível. Reconecte e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключенный хост Poracode недоступен. Подключитесь и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı Poracode ana bilgisayarı kullanılamıyor. Yeniden bağlanın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключений хост Poracode недоступний. Підключіться знову й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ Poracode được kết nối không khả dụng. Hãy kết nối lại và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接的 Poracode 主机不可用。重新连接并重试。"
          }
        }
      }
    },
    "The downloaded Hex engine failed its integrity or signature check.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded Hex engine failed its integrity or signature check."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heruntergeladene Hex-Engine hat die Integritäts- oder Signaturprüfung nicht bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor Hex descargado falló en la verificación de integridad o firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Hex téléchargé a échoué lors de sa vérification d'intégrité ou de signature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
