          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ Hex đã tải xuống không thể kiểm tra tính toàn vẹn hoặc chữ ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的 Hex 引擎未通过完整性或签名检查。"
          }
        }
