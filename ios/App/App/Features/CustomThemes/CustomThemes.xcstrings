          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "— は自動設定の塗りつぶし、または無効な色を示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "— indica um preenchimento automático ou uma cor inválida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "— steht für eine automatische Füllung oder eine ungültige Farbe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "— indique un remplissage automatique ou une couleur invalide."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "—는 자동 채우기 또는 유효하지 않은 색상을 의미합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "— oznacza automatyczne wypełnienie lub nieprawidłowy kolor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "— biểu thị màu nền tự động hoặc màu không hợp lệ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "— otomatik dolgu veya geçersiz renk anlamına gelir."
          }
        }
      }
    },
    "Ratios for opaque theme surfaces. Aim for at least 4.5:1 for text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratios for opaque theme surfaces. Aim for at least 4.5:1 for text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores para superficies opacas del tema. Procura un contraste de al menos 4,5:1 para el texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения для непрозрачных поверхностей темы. Для текста стремитесь к контрасту не ниже 4,5:1."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення для непрозорих поверхонь теми. Для тексту прагніть контрасту не нижче 4,5:1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些比率适用于主题的不透明表面。文字对比度建议至少为 4.5:1。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマの不透明な面での比率です。文字は4.5:1以上を目安にしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores para superfícies opacas do tema. Busque um contraste de pelo menos 4,5:1 para o texto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte für undurchsichtige Designflächen. Strebe für Text mindestens 4,5:1 an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapports pour les surfaces opaques du thème. Visez au moins 4,5:1 pour le texte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마의 불투명한 표면에 대한 비율입니다. 텍스트 대비는 최소 4.5:1을 목표로 하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości dla nieprzezroczystych powierzchni motywu. Dąż do kontrastu co najmniej 4,5:1 dla tekstu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ lệ cho các bề mặt đục của giao diện. Nên đạt ít nhất 4,5:1 cho chữ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temanın opak yüzeyleri için oranlar. Metin için en az 4,5:1 hedefleyin."
          }
        }
      }
    },
    "Enter a theme name and valid hex colors in both palettes.": {
      "extractionState": "manual",
      "localizations": {
