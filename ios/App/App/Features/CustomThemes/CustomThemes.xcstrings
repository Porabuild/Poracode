    "Use #rgb or #rrggbb colors. Leave optional colors blank to derive them automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use #rgb or #rrggbb colors. Leave optional colors blank to derive them automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa colores #rgb o #rrggbb. Deja los colores opcionales vacíos para calcularlos automáticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте цвета #rgb или #rrggbb. Оставьте необязательные цвета пустыми для автоматического расчёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте кольори #rgb або #rrggbb. Залиште необов’язкові кольори порожніми для автоматичного розрахунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 #rgb 或 #rrggbb 格式的颜色。可选颜色留空时将自动计算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#rgbまたは#rrggbb形式の色を使用してください。任意の色を空欄にすると自動的に算出されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use cores #rgb ou #rrggbb. Deixe as cores opcionais em branco para calculá-las automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Farben im Format #rgb oder #rrggbb. Lass optionale Farben leer, um sie automatisch abzuleiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des couleurs #rgb ou #rrggbb. Laissez les couleurs facultatives vides pour les calculer automatiquement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "#rgb 또는 #rrggbb 색상을 사용하세요. 선택적 색상을 비워 두면 자동으로 계산됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj kolorów #rgb lub #rrggbb. Pozostaw opcjonalne kolory puste, aby obliczyć je automatycznie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng màu #rgb hoặc #rrggbb. Để trống màu tùy chọn để tự động tính màu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "#rgb veya #rrggbb renklerini kullanın. Otomatik hesaplama için isteğe bağlı renkleri boş bırakın."
          }
        }
      }
    },
