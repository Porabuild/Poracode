    },
    "The custom theme limit has been reached. Delete a theme before adding another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The custom theme limit has been reached. Delete a theme before adding another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha alcanzado el límite de temas personalizados. Elimina un tema antes de añadir otro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит пользовательских тем. Удалите тему, прежде чем добавить новую."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досягнуто ліміту власних тем. Видаліть тему, перш ніж додати нову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到自定义主题数量上限。请先删除一个主题再添加新主题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムテーマの上限に達しました。新しいテーマを追加する前にテーマを削除してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de temas personalizados foi atingido. Exclua um tema antes de adicionar outro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Höchstzahl eigener Designs wurde erreicht. Lösche ein Design, bevor du ein weiteres hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de thèmes personnalisés est atteinte. Supprimez un thème avant d’en ajouter un autre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 테마 한도에 도달했습니다. 새 테마를 추가하기 전에 테마를 삭제하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit własnych motywów. Usuń motyw przed dodaniem kolejnego."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt giới hạn giao diện tùy chỉnh. Hãy xóa một giao diện trước khi thêm giao diện khác."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel tema sınırına ulaşıldı. Başka bir tema eklemeden önce bir temayı silin."
          }
        }
      }
    },
    "Could not import this theme. Use a version 1 theme JSON file under 32 KB with a name and valid light and dark palettes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not import this theme. Use a version 1 theme JSON file under 32 KB with a name and valid light and dark palettes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo importar este tema. Usa un archivo JSON de tema de versión 1 de menos de 32 KB con un nombre y paletas clara y oscura válidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось импортировать тему. Используйте JSON-файл темы версии 1 размером менее 32 КБ с названием и корректными светлой и тёмной палитрами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося імпортувати тему. Використовуйте JSON-файл теми версії 1 розміром менше 32 КБ з назвою та коректними світлою й темною палітрами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入此主题。请使用小于 32 KB 的版本 1 主题 JSON 文件，其中需包含名称及有效的浅色和深色配色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマをインポートできませんでした。名前と有効なライト・ダークパレットを含む、32 KB未満のバージョン1のテーマJSONファイルを使用してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível importar este tema. Use um arquivo JSON de tema da versão 1 com menos de 32 KB, um nome e paletas clara e escura válidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Design konnte nicht importiert werden. Verwende eine Design-JSON-Datei der Version 1 unter 32 KB mit einem Namen und gültigen hellen und dunklen Farbpaletten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’importer ce thème. Utilisez un fichier JSON de thème de version 1 de moins de 32 Ko avec un nom et des palettes claire et sombre valides."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마를 가져올 수 없습니다. 이름과 유효한 밝은 팔레트 및 어두운 팔레트가 포함된 32 KB 미만의 버전 1 테마 JSON 파일을 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaimportować motywu. Użyj pliku JSON motywu w wersji 1 o rozmiarze poniżej 32 KB z nazwą i prawidłowymi jasną i ciemną paletami."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể nhập giao diện này. Hãy dùng tệp JSON giao diện phiên bản 1 dưới 32 KB có tên và bảng màu sáng, tối hợp lệ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tema içe aktarılamadı. Ad ve geçerli açık ve koyu paletler içeren, 32 KB’tan küçük bir sürüm 1 tema JSON dosyası kullanın."
          }
        }
      }
    },
    "Delete this custom theme? If it is active, Poracode will use the default theme.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this custom theme? If it is active, Poracode will use the default theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este tema personalizado? Si está activo, Poracode usará el tema predeterminado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить эту пользовательскую тему? Если она активна, Poracode применит тему по умолчанию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цю власну тему? Якщо вона активна, Poracode застосує типову тему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此自定义主题？如果正在使用，Poracode 将恢复默认主题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカスタムテーマを削除しますか？使用中の場合、Poracodeは標準テーマに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este tema personalizado? Se estiver ativo, o Poracode usará o tema padrão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses eigene Design löschen? Wenn es aktiv ist, verwendet Poracode das Standarddesign."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce thème personnalisé ? S’il est actif, Poracode utilisera le thème par défaut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자 지정 테마를 삭제할까요? 사용 중이면 Poracode가 기본 테마로 돌아갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten własny motyw? Jeśli jest aktywny, Poracode użyje motywu domyślnego."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa giao diện tùy chỉnh này? Nếu đang được dùng, Poracode sẽ chuyển về giao diện mặc định."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özel tema silinsin mi? Etkinse Poracode varsayılan temayı kullanır."
          }
        }
      }
    },
