    "Saved themes could not be read. Existing data has been kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved themes could not be read. Existing data has been kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los temas guardados. Se han conservado los datos existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать сохранённые темы. Существующие данные сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати збережені теми. Наявні дані збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的主题。现有数据已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたテーマを読み込めませんでした。既存のデータは保持されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os temas salvos. Os dados existentes foram preservados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Designs konnten nicht gelesen werden. Vorhandene Daten wurden beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les thèmes enregistrés. Les données existantes ont été conservées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 테마를 읽을 수 없습니다. 기존 데이터는 보존되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zapisanych motywów. Dotychczasowe dane zostały zachowane."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc các giao diện đã lưu. Dữ liệu hiện có đã được giữ lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen temalar okunamadı. Mevcut veriler korundu."
          }
        }
      }
    },
    "Update Poracode to edit themes saved by a newer version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Poracode to edit themes saved by a newer version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Poracode para editar temas guardados por una versión más reciente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите Poracode, чтобы редактировать темы, сохранённые более новой версией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть Poracode, щоб редагувати теми, збережені новішою версією."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 Poracode，以编辑由较新版本保存的主题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンで保存されたテーマを編集するには、Poracodeをアップデートしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o Poracode para editar temas salvos por uma versão mais recente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere Poracode, um Designs aus einer neueren Version zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez Poracode à jour pour modifier les thèmes enregistrés par une version plus récente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전에서 저장한 테마를 편집하려면 Poracode를 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizuj Poracode, aby edytować motywy zapisane w nowszej wersji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật Poracode để chỉnh sửa giao diện được lưu bằng phiên bản mới hơn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni bir sürümde kaydedilen temaları düzenlemek için Poracode'u güncelleyin."
          }
        }
      }
    }
  },
