    "— means an automatic fill or an invalid color.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "— means an automatic fill or an invalid color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "— indica un relleno automático o un color no válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "— означает автоматическую заливку или некорректный цвет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "— означає автоматичну заливку або некоректний колір."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
