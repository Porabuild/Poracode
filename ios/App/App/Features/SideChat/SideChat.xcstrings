    "Could not read the parent conversation. Your question was not sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the parent conversation. Your question was not sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Unterhaltung konnte nicht gelesen werden. Deine Frage wurde nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la conversación original. Tu pregunta no se envió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la conversation d’origine. Votre question n’a pas été envoyée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の会話を読み取れませんでした。質問は送信されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 대화를 읽을 수 없습니다. 질문이 전송되지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać pierwotnej rozmowy. Pytanie nie zostało wysłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a conversa original. Sua pergunta não foi enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать исходный разговор. Ваш вопрос не отправлен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asıl konuşma okunamadı. Sorunuz gönderilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати вихідну розмову. Ваше запитання не надіслано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc cuộc trò chuyện gốc. Câu hỏi của bạn chưa được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取原始对话。你的问题尚未发送。"
          }
        }
      }
    },
    "Update the remote host to use side chat with private context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the remote host to use side chat with private context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere den entfernten Host, um Nebenchat mit privatem Kontext zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza el host remoto para usar el chat paralelo con contexto privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour l’hôte distant pour utiliser la discussion parallèle avec un contexte privé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開のコンテキストでサイドチャットを使うには、リモートホストを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 맥락으로 사이드 채팅을 사용하려면 원격 호스트를 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizuj zdalnego hosta, aby używać czatu bocznego z prywatnym kontekstem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o host remoto para usar a conversa paralela com contexto privado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите удалённый хост, чтобы использовать боковой чат с приватным контекстом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel bağlamla yan sohbet kullanmak için uzak sunucuyu güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть віддалений хост, щоб використовувати бічний чат із приватним контекстом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật máy chủ từ xa để dùng trò chuyện bên với ngữ cảnh riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新远程主机，以使用带私密上下文的旁支聊天。"
          }
        }
      }
    },
    "Retry the original question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry the original question"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ursprüngliche Frage erneut senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar la pregunta original"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer la question d’origine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の質問を再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 질문 다시 시도"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponów pierwotne pytanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente a pergunta original"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить исходный вопрос"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asıl soruyu yeniden dene"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторити вихідне запитання"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại câu hỏi gốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试原始问题"
          }
        }
      }
    },
    "The result is uncertain. Retry sends the same question once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain. Retry sends the same question once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist unklar. Ein erneuter Versuch sendet dieselbe Frage nur einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es incierto. Al reintentar, la misma pregunta se envía una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat est incertain. Réessayer n’envoie la même question qu’une seule fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を確認できません。再試行しても同じ質問は一度だけ送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 확인할 수 없습니다. 다시 시도해도 같은 질문은 한 번만 전송됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik jest niepewny. Ponowienie wysyła to samo pytanie tylko raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é incerto. Tentar novamente envia a mesma pergunta apenas uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат неизвестен. Повторная попытка отправит тот же вопрос только один раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç belirsiz. Yeniden deneme aynı soruyu yalnızca bir kez gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат невідомий. Повторна спроба надішле те саме запитання лише один раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác định được kết quả. Thử lại chỉ gửi cùng câu hỏi một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚不确定。重试只会发送同一个问题一次。"
          }
        }
      }
    },
