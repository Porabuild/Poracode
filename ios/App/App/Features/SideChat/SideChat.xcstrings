    "Close this side chat? The parent conversation stays open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this side chat? The parent conversation stays open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Nebenchat schließen? Die ursprüngliche Unterhaltung bleibt geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cerrar este chat paralelo? La conversación original seguirá abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cette discussion parallèle ? La conversation d’origine reste ouverte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイドチャットを閉じますか？元の会話は開いたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이드 채팅을 닫을까요? 원래 대화는 열린 상태로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknąć ten czat boczny? Pierwotna rozmowa pozostanie otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta conversa paralela? A conversa original permanece aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть этот боковой чат? Исходный разговор останется открытым."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yan sohbet kapatılsın mı? Asıl konuşma açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрити цей бічний чат? Вихідна розмова залишиться відкритою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng trò chuyện bên này? Cuộc trò chuyện gốc vẫn mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此旁支聊天？原始对话将保持打开。"
          }
        }
      }
    },
    "Switch back to the source host to continue this side chat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch back to the source host to continue this side chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zum ursprünglichen Host zurück, um diesen Nebenchat fortzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al host de origen para continuar este chat paralelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à l’hôte d’origine pour poursuivre cette discussion parallèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイドチャットを続けるには、元のホストに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이드 채팅을 계속하려면 원래 호스트로 돌아가세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć do hosta źródłowego, aby kontynuować ten czat boczny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte ao host de origem para continuar esta conversa paralela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь к исходному хосту, чтобы продолжить этот боковой чат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yan sohbete devam etmek için kaynak sunucuya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверніться до вихідного хоста, щоб продовжити цей бічний чат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển về máy chủ gốc để tiếp tục trò chuyện bên này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请切回原始主机以继续此旁支聊天。"
          }
        }
      }
    },
