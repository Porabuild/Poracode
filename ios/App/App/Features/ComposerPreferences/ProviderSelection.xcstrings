    "providerSelection.availabilityHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which agents appear in new-thread and Crew pickers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, welche Agenten bei der Auswahl für neue Unterhaltungen und Crews erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué agentes aparecen al crear conversaciones y configurar Crews."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les agents affichés pour les nouvelles conversations et les Crews."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいスレッドと Crew のモデル選択に表示するエージェントを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 대화 및 Crew의 모델 선택기에 표시할 에이전트를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz agentów widocznych przy tworzeniu wątków i konfigurowaniu Crew."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais agentes aparecem nos seletores de novas conversas e Crews."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите агентов, отображаемых при создании чатов и настройке Crews."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sohbet ve Crew model seçicilerinde hangi aracıların görüneceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть агентів для списків моделей нових чатів і Crews."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các tác nhân xuất hiện khi tạo cuộc trò chuyện và cấu hình Crew."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择在新对话和 Crew 模型选择器中显示的代理。"
          }
        }
      }
    },
    "providerSelection.noAgents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
