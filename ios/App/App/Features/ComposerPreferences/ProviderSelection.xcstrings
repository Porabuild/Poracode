    "providerOrder.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use host order for this machine"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host-Reihenfolge für diesen Rechner verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el orden del host para este equipo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser l’ordre de l’hôte pour cette machine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンにホストの順序を使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신에 호스트 순서 사용"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj kolejności hosta dla tej maszyny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar a ordem do host nesta máquina"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать порядок хоста для этой машины"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати порядок хоста для цієї машини"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thứ tự của máy chủ cho máy này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对此机器使用主机顺序"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinede ana makinenin sırasını kullan"
          }
        }
      }
    },
    "providerOrder.syncedHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the host's provider order. Turn off to arrange machines separately on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anbieterreihenfolge des Hosts verwenden. Deaktivieren, um Rechner auf diesem Gerät getrennt anzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el orden de proveedores del host. Desactívalo para ordenar cada equipo por separado en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l’ordre des fournisseurs de l’hôte. Désactivez cette option pour organiser les machines séparément sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストのプロバイダー順を使います。オフにすると、このデバイスでマシンごとに並べ替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트의 공급자 순서를 사용합니다. 끄면 이 기기에서 머신별로 따로 정렬할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj kolejności dostawców hosta. Wyłącz, aby ustawiać kolejność osobno dla każdej maszyny na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a ordem de provedores do host. Desative para organizar as máquinas separadamente neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется порядок провайдеров хоста. Отключите, чтобы задавать порядок для каждой машины отдельно на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується порядок провайдерів хоста. Вимкніть, щоб налаштовувати порядок кожної машини окремо на цьому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thứ tự nhà cung cấp của máy chủ. Tắt để sắp xếp riêng từng máy trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用主机的提供方顺序。关闭后，可在此设备上为各台机器单独排序。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana makinenin sağlayıcı sırasını kullanır. Bu aygıtta makineleri ayrı ayrı sıralamak için kapatın."
          }
        }
      }
    },
    "providerOrder.machineHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorder providers for this machine. Turning sharing on applies this order to the selected host and removes device-specific orders."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbieter für diesen Rechner neu anordnen. Beim Aktivieren der gemeinsamen Reihenfolge wird diese auf den ausgewählten Host angewendet; gerätespezifische Reihenfolgen werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena los proveedores de este equipo. Al activar el orden compartido, se aplica este orden al host seleccionado y se eliminan los órdenes específicos del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganisez les fournisseurs pour cette machine. L’activation du partage applique cet ordre à l’hôte sélectionné et supprime les ordres propres à cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンのプロバイダーを並べ替えます。共有をオンにすると、この順序が選択中のホストに適用され、デバイス固有の順序は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신의 공급자 순서를 변경합니다. 공유를 켜면 이 순서가 선택한 호스트에 적용되고 기기별 순서는 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień kolejność dostawców tej maszyny. Włączenie wspólnej kolejności zastosuje ją na wybranym hoście i usunie kolejności właściwe dla tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordene os provedores desta máquina. Ativar o compartilhamento aplica essa ordem ao host selecionado e remove as ordens específicas do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените порядок провайдеров этой машины. Включение общего порядка применит его к выбранному хосту и удалит порядки, заданные на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть порядок провайдерів цієї машини. Увімкнення спільного порядку застосує його до вибраного хоста й видалить порядки, задані на цьому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp lại nhà cung cấp cho máy này. Bật chia sẻ sẽ áp dụng thứ tự này cho máy chủ đã chọn và xóa các thứ tự riêng trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此机器重新排列提供方。开启共享会将此顺序应用到所选主机，并移除此设备上的专用顺序。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinenin sağlayıcılarını yeniden sıralayın. Paylaşımı açmak bu sırayı seçili ana makineye uygular ve aygıta özel sıraları kaldırır."
          }
        }
      }
    },
