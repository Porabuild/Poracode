          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir aracı yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступних агентів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tác nhân khả dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的代理"
          }
        }
      }
    },
    "providerSelection.manageAgentsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage agents in Settings to choose a model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Agenten in den Einstellungen, um ein Modell auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los agentes en Ajustes para elegir un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les agents dans Réglages pour choisir un modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを選択するには、設定でエージェントを管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 선택하려면 설정에서 에이전트를 관리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj agentami w ustawieniach, aby wybrać model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie os agentes nos Ajustes para escolher um modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте агентов в настройках, чтобы выбрать модель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir model seçmek için Ayarlar'dan aracıları yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте агентами в налаштуваннях, щоб вибрати модель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý tác nhân trong Cài đặt để chọn mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中管理代理以选择模型。"
          }
        }
      }
    },
    "providerOrder.sameOrder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same provider order on all machines"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Anbieterreihenfolge auf allen Rechnern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo orden de proveedores en todos los equipos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même ordre des fournisseurs sur toutes les machines"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのマシンで同じプロバイダー順を使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 머신에서 같은 공급자 순서 사용"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sama kolejność dostawców na wszystkich maszynach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesma ordem de provedores em todas as máquinas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одинаковый порядок провайдеров на всех машинах"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Однаковий порядок провайдерів на всіх машинах"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cùng thứ tự nhà cung cấp trên mọi máy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有机器上使用相同的提供方顺序"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm makinelerde aynı sağlayıcı sırası"
          }
        }
      }
    },
