    "keyboard.storageError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts could not be loaded. Reset to use the defaults; your saved configuration stays unchanged until then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los atajos. Restablécelos para usar los predeterminados; la configuración guardada no cambiará hasta entonces."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить сочетания клавиш. Сбросьте их, чтобы использовать стандартные. До этого сохранённая конфигурация останется без изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити скорочення. Скиньте їх, щоб використовувати типові. До цього збережена конфігурація залишатиметься без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载快捷键。重置后可使用默认设置；在此之前，已保存的配置保持不变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを読み込めませんでした。リセットするとデフォルトを使用できます。それまでは保存済みの設定は変更されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os atalhos. Redefina-os para usar os padrões; a configuração salva permanecerá inalterada até lá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurzbefehle konnten nicht geladen werden. Setze sie zurück, um die Standardkurzbefehle zu verwenden. Bis dahin bleibt die gespeicherte Konfiguration unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les raccourcis. Réinitialisez-les pour utiliser les valeurs par défaut ; la configuration enregistrée restera inchangée jusque-là."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 불러올 수 없습니다. 기본값을 사용하려면 재설정하세요. 그전까지 저장된 설정은 변경되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać skrótów. Zresetuj je, aby użyć domyślnych. Do tego czasu zapisana konfiguracja pozostanie bez zmian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải phím tắt. Hãy đặt lại để dùng mặc định; cấu hình đã lưu sẽ không thay đổi cho đến lúc đó."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar yüklenemedi. Varsayılanları kullanmak için sıfırlayın; o zamana kadar kayıtlı yapılandırmanız değişmeden kalır."
          }
        }
      }
    },
