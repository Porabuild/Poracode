    "keyboard.resetAllMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace this device’s custom shortcuts with the defaults?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar los atajos personalizados de este dispositivo por los predeterminados?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить пользовательские сочетания на этом устройстве стандартными?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінити власні скорочення на цьому пристрої типовими?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此设备的自定义快捷键替换为默认快捷键？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのカスタムショートカットをデフォルトに戻しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os atalhos personalizados deste dispositivo pelos padrões?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigenen Kurzbefehle dieses Geräts durch die Standardkurzbefehle ersetzen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer les raccourcis personnalisés de cet appareil par les raccourcis par défaut ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 사용자 지정 단축키를 기본값으로 바꾸시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąpić własne skróty na tym urządzeniu domyślnymi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay phím tắt tùy chỉnh trên thiết bị này bằng các phím mặc định?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
