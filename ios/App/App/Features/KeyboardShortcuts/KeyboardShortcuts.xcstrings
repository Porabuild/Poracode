    "keyboard.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut changed in another window. Close this editor and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atajo cambió en otra ventana. Cierra este editor e inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание изменилось в другом окне. Закройте редактор и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорочення змінилося в іншому вікні. Закрийте редактор і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键已在另一个窗口中更改。请关闭此编辑器后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットは別のウインドウで変更されました。エディタを閉じてやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atalho foi alterado em outra janela. Feche este editor e tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kurzbefehl wurde in einem anderen Fenster geändert. Schließe diesen Editor und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci a été modifié dans une autre fenêtre. Fermez cet éditeur et réessayez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 윈도우에서 이 단축키가 변경되었습니다. 편집기를 닫고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten skrót zmieniono w innym oknie. Zamknij edytor i spróbuj ponownie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím tắt này đã thay đổi trong cửa sổ khác. Đóng trình chỉnh sửa rồi thử lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol başka bir pencerede değiştirildi. Düzenleyiciyi kapatıp yeniden deneyin."
          }
        }
      }
    },
