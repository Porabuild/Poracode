    "pullRequests.parity.Select a guide writer that supports an enforced read-only workspace.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Leitfaden-Autor, der eine technisch erzwungene schreibgeschützte Arbeitsumgebung unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a guide writer that supports an enforced read-only workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un autor de guías que admita un espacio de trabajo de solo lectura aplicado técnicamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un rédacteur de guides prenant en charge un espace de travail dont la lecture seule est imposée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用が強制されるワークスペースに対応したガイド作成エージェントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용이 강제되는 작업 공간을 지원하는 가이드 작성 에이전트를 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz autora przewodnika obsługującego przestrzeń roboczą z wymuszonym trybem tylko do odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um autor de guias que ofereça um espaço de trabalho com modo somente leitura imposto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите автора руководства, поддерживающего рабочую область с принудительным режимом только для чтения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur çalışma alanını zorunlu kılan bir rehber yazarı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть автора посібника, який підтримує робочу область із примусовим режимом лише для читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tác nhân viết hướng dẫn hỗ trợ không gian làm việc bị giới hạn bắt buộc ở chế độ chỉ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择支持强制只读工作区的指南编写代理。"
          }
        }
      }
    },
    "pullRequests.parity.Writing guide. You can leave this review and return when it is ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leitfaden wird erstellt. Du kannst dieses Review verlassen und zurückkehren, wenn er fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing guide. You can leave this review and return when it is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creando la guía. Puedes salir de esta revisión y volver cuando esté lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédaction du guide en cours. Vous pouvez quitter cette revue et revenir lorsqu’il sera prêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドを作成しています。このレビューを離れ、準備ができてから戻ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드를 작성 중입니다. 이 검토를 떠났다가 준비되면 돌아올 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa pisanie przewodnika. Możesz opuścić ten przegląd i wrócić, gdy będzie gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrevendo o guia. Você pode sair desta revisão e voltar quando ele estiver pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся руководство. Можно выйти из этого ревью и вернуться, когда оно будет готово."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehber yazılıyor. Bu incelemeden ayrılıp hazır olduğunda geri dönebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посібник створюється. Можна вийти з цієї перевірки й повернутися, коли він буде готовий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang viết hướng dẫn. Bạn có thể rời phần đánh giá này và quay lại khi hướng dẫn sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在编写指南。你可以离开此审查，待指南就绪后再返回。"
          }
        }
      }
    },
    "pullRequests.parity.Could not write the guide. Try rewriting it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leitfaden konnte nicht erstellt werden. Versuche, ihn neu zu schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the guide. Try rewriting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la guía. Intenta reescribirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rédiger le guide. Essayez de le réécrire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドを作成できませんでした。書き直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드를 작성하지 못했습니다. 다시 작성해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się napisać przewodnika. Spróbuj napisać go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível escrever o guia. Tente reescrevê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать руководство. Попробуйте переписать его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehber yazılamadı. Yeniden yazmayı deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити посібник. Спробуйте переписати його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể viết hướng dẫn. Hãy thử viết lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法编写指南，请尝试重写。"
          }
        }
      }
    },
    "pullRequests.parity.This guide is out of date. Rewrite it to see excerpts for the current change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Leitfaden ist veraltet. Schreibe ihn neu, um Auszüge der aktuellen Änderung zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide is out of date. Rewrite it to see excerpts for the current change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta guía está desactualizada. Reescríbela para ver fragmentos del cambio actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce guide est obsolète. Réécrivez-le pour voir les extraits de la modification actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このガイドは古くなっています。現在の変更の抜粋を見るには書き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가이드는 오래되었습니다. 현재 변경의 발췌문을 보려면 다시 작성하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten przewodnik jest nieaktualny. Napisz go ponownie, aby zobaczyć fragmenty bieżącej zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guia está desatualizado. Reescreva-o para ver trechos da alteração atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это руководство устарело. Перепишите его, чтобы увидеть фрагменты текущего изменения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rehber güncel değil. Mevcut değişikliğin alıntılarını görmek için yeniden yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей посібник застарів. Перепишіть його, щоб побачити уривки поточної зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn này đã cũ. Hãy viết lại để xem đoạn trích của thay đổi hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此指南已过期。请重写以查看当前更改的摘录。"
          }
        }
      }
    },
