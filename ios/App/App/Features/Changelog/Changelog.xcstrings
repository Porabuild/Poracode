    "What's new in Poracode, newest first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's new in Poracode, newest first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuigkeiten in Poracode, neueste zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades de Poracode, de más recientes a más antiguas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveautés de Poracode, les plus récentes en premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracodeの新機能を新しい順に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode의 새로운 소식을 최신순으로 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowości w Poracode, od najnowszych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novidades do Poracode, das mais recentes às mais antigas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что нового в Poracode, начиная с последних выпусков."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що нового в Poracode, починаючи з найновіших випусків."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode yenilikleri, en yeniden başlayarak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có gì mới trong Poracode, từ mới nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poracode 的新功能，按从新到旧排序。"
          }
        }
      }
    },
    "Loading release notes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading release notes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionshinweise werden geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando notas de la versión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des notes de version"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリースノートを読み込み中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리스 노트 불러오는 중"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładowanie informacji o wydaniach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando notas de versão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка примечаний к выпускам"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження приміток до випусків"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm notları yükleniyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải ghi chú phát hành"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载发行说明"
          }
        }
      }
    },
    "Couldn't load the changelog.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the changelog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Änderungsprotokoll konnte nicht geladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el historial de cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger l’historique des modifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更履歴を読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 내역을 불러오지 못했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać historii zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o histórico de alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить историю изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити історію змін."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik günlüğü yüklenemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải nhật ký thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载更新日志。"
          }
        }
      }
    },
    "Check your connection, or view releases on GitHub.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection, or view releases on GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung oder sieh dir die Versionen auf GitHub an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión o consulta las versiones en GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion ou consultez les versions sur GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認するか、GitHubでリリースをご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인하거나 GitHub에서 릴리스를 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie lub zobacz wydania w GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão ou veja as versões no GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение или посмотрите выпуски на GitHub."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте підключення або перегляньте випуски на GitHub."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantınızı kontrol edin veya sürümleri GitHub’da görüntüleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra kết nối hoặc xem các bản phát hành trên GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接，或在 GitHub 上查看发行版本。"
          }
        }
      }
    },
    "Couldn't refresh. Showing saved release notes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't refresh. Showing saved release notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisierung fehlgeschlagen. Gespeicherte Versionshinweise werden angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar. Se muestran las notas guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisation impossible. Les notes de version enregistrées sont affichées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新できませんでした。保存済みのリリースノートを表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고치지 못했습니다. 저장된 릴리스 노트를 표시합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odświeżyć. Wyświetlane są zapisane informacje o wydaniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar. Exibindo notas de versão salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить. Показаны сохранённые примечания к выпускам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити. Показано збережені примітки до випусків."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilenemedi. Kaydedilmiş sürüm notları gösteriliyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể làm mới. Đang hiển thị ghi chú phát hành đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新。正在显示已保存的发行说明。"
          }
        }
      }
    },
