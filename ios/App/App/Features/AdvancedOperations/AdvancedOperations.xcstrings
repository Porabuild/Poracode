    "advancedOperations.refreshRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is unknown. Refresh from the host before acting again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist unbekannt. Vor der nächsten Aktion vom Host aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es desconocido. Actualiza desde el host antes de volver a actuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat est inconnu. Actualisez depuis l’hôte avant d’agir à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が不明です。再操作する前にホストから更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 알 수 없습니다. 다시 실행하기 전에 호스트에서 새로 고치세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik jest nieznany. Odśwież dane z hosta przed kolejnym działaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado é desconhecido. Atualize a partir do host antes de agir novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат неизвестен. Обновите данные с хоста перед повторным действием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç bilinmiyor. Yeniden işlem yapmadan önce ana bilgisayardan yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат невідомий. Оновіть дані з хоста перед повторною дією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả không rõ. Hãy làm mới từ máy chủ trước khi thao tác lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知。请先从主机刷新，然后再操作。"
          }
        }
      }
    },
