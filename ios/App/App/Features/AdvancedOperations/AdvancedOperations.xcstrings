    "advancedOperations.acknowledged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed. The host returned no result."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossen. Der Host hat kein Ergebnis zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completado. El host no devolvió ningún resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé. L’hôte n’a renvoyé aucun résultat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しました。ホストからの結果はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되었습니다. 호스트가 결과를 반환하지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończono. Host nie zwrócił wyniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído. O host não retornou nenhum resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Хост не вернул результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı. Ana bilgisayar sonuç döndürmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Хост не повернув результат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hoàn tất. Máy chủ không trả về kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成。主机未返回结果。"
          }
        }
      }
    },
