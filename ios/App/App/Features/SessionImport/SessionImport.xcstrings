    "session_import.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thread keeps its provider session, so your next message continues where you left off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Thread behält seine Anbietersitzung, sodass deine nächste Nachricht dort weitermacht, wo du aufgehört hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hilo conserva su sesión del proveedor, así que tu próximo mensaje continúa donde lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fil de discussion conserve sa session fournisseur : votre prochain message reprend là où vous vous étiez arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スレッドはプロバイダーのセッションを保持するため、次のメッセージは中断したところから続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스레드가 공급자 세션을 유지하므로 다음 메시지는 중단한 지점부터 이어집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wątek zachowuje sesję dostawcy, więc Twoja następna wiadomość będzie kontynuacją od miejsca, w którym skończyłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tópico mantém a sessão do provedor, então sua próxima mensagem continua de onde você parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тред сохраняет сессию провайдера, поэтому следующее сообщение продолжит разговор с того места, где вы остановились."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konu sağlayıcı oturumunu korur; böylece bir sonraki mesajınız kaldığınız yerden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тред зберігає сесію провайдера, тож ваше наступне повідомлення продовжить розмову з того місця, де ви зупинилися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng giữ nguyên phiên của nhà cung cấp, nên tin nhắn tiếp theo của bạn sẽ tiếp tục từ chỗ bạn dừng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线程会保留其提供方会话，因此你的下一条消息会从上次中断处继续。"
          }
        }
      }
    },
